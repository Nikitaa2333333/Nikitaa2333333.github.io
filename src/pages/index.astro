---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import AboutClinic from '../components/sections/AboutClinic.astro';
import PlanSteps from '../components/sections/PlanSteps.astro';
import WhoWeHelp from '../components/sections/WhoWeHelp.astro';
import CancerTreatable from '../components/sections/CancerTreatable.astro';
import HowWeTreat from '../components/sections/HowWeTreat.astro';
import FirstStep from '../components/sections/FirstStep.astro';
import Faq from '../components/sections/Faq.astro';
import FooterContacts from '../components/sections/FooterContacts.astro';
import DoctorCard from '../components/DoctorCard.astro';
import { doctors } from '../data/doctors';
import { clinic } from '../data/clinic';

// — Иконки (тонкие линейные, stroke=currentColor) —
const icon: Record<string, string> = {
  pulse: '<path d="M3 12h4l2 6 4-14 2 8h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  team: '<circle cx="8" cy="9" r="3" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="10" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3 19c0-3 2.5-5 5-5s5 2 5 5M14.5 18c.3-2 1.7-3.5 3.5-3.5S21 16 21.5 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  tag: '<path d="M4 12V5a1 1 0 011-1h7l8 8-8 8-8-8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="8.5" cy="8.5" r="1.3" fill="currentColor"/>',
  upload: '<path d="M12 15V4m0 0l-4 4m4-4l4 4M5 17v2a1 1 0 001 1h12a1 1 0 001-1v-2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 11V8a4 4 0 018 0v3" fill="none" stroke="currentColor" stroke-width="1.6"/>',
  eye: '<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.6" fill="none" stroke="currentColor" stroke-width="1.6"/>',
  reply: '<path d="M9 7L4 12l5 5M4 12h9a7 7 0 017 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  arrow: '<path d="M5 12h14m-6-6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
};

// «Истории» — истории пациентов (ТЗ, экран 10) на мозаике фото клиники.
// Фото — public/images/stories/*.webp (промпты: docs/photo-prompt-stories.md),
// пока файла нет — плашка остаётся на градиенте-заглушке (onerror убирает img).
// size (фото): tall (3 ряда) / mid (2 ряда) — «какая-то крупнее, какая-то меньше».
// Текстовые цитаты (quote) — ВСЕГДА компактные (span 2, под контент, автора к низу
// не прижимать); circle — круглая плашка-отзыв пациента. Всё выровнено по линиям
// сетки (auto-rows + dense).
const stories = [
  { type: 'photo', size: 'tall', img: '/images/clinic/infusion.webp', tag: 'Дневной стационар', t: 'Утро в инфузионной зоне', d: 'Первые инфузии — в 9:00, пациенты в креслах-реклайнерах.', g1: 'var(--c-wash-teal)', g2: 'var(--c-wash-powder)' },
  { type: 'photo', size: 'mid', img: '/images/stories/lab.webp', tag: 'Лаборатория', t: 'NGS-панель за работой', d: 'Секвенатор читает 50+ генов опухоли.', g1: 'var(--c-wash-blue)', g2: 'var(--c-wash-aqua)' },
  { type: 'quote', q: 'Диагноз поставили в районном диспансере, но сомнения остались. Здесь пересмотрели стёкла и сделали молекулярно-генетическое исследование — схему поменяли. Сейчас ремиссия, наблюдаюсь раз в три месяца.', a: 'Елена К., 54 года', role: 'рак молочной железы · лечащий врач — Анна Смирнова' },
  { type: 'photo', size: 'tall', img: '/images/clinic/exterior.webp', tag: 'Клиника в СПб', t: 'Современный центр в Петербурге', d: 'Комфортный стационар и удобная транспортная доступность.', g1: 'var(--c-wash-powder)', g2: 'var(--c-wash-teal)' },
  { type: 'circle', q: 'Лечение шло, а результата не было. Здесь уточнили диагноз и обосновали, что оставить, а что изменить. Опухоль отвечает на новую схему.', a: 'Марина В., 61 год', role: 'рак лёгкого · врач — Дмитрий Ковалёв' },
  { type: 'photo', size: 'mid', img: '/images/stories/port.webp', tag: 'Процедурная', t: 'Установка порт-системы', d: 'УЗИ-навигация, амбулаторно, за один визит.', g1: 'var(--c-wash-aqua)', g2: 'var(--c-wash-blue)' },
  { type: 'photo', size: 'tall', img: '/images/clinic/reception.webp', tag: 'Ресепшен', t: 'Встречаем без очередей', d: 'Администратор ведёт запись и сопровождает весь визит.', g1: 'var(--c-wash-powder)', g2: 'var(--c-wash-aqua)' },
  { type: 'quote', q: 'Помощь искал для отца — не знал, куда везти и что спрашивать. Подсказали, какие документы собрать, за неделю уточнили диагноз и начали терапию в дневном стационаре.', a: 'Сергей Н., сын пациента', role: 'рак кишечника · врач — Мария Орлова' },
  { type: 'photo', size: 'mid', img: '/images/clinic/consult.webp', tag: 'Кабинет консультаций', t: 'Час на разговор', d: 'Первичный приём — до 60 минут, без спешки.', g1: 'var(--c-wash-teal)', g2: 'var(--c-wash-blue)' },
  { type: 'photo', size: 'mid', img: '/images/clinic/lounge.webp', tag: 'Зона отдыха', t: 'Для близких', d: 'Кофе, Wi-Fi и тишина — рядом с инфузионной.', g1: 'var(--c-wash-blue)', g2: 'var(--c-wash-powder)' },
];

const teleSteps = [
  { i: 'upload', t: 'Загружаете анализы', d: 'PDF, снимки, выписки — прямо в личном кабинете.' },
  { i: 'lock',   t: 'Защищённое хранение', d: 'Данные шифруются, серверы — на территории РФ.' },
  { i: 'eye',    t: 'Врач изучает', d: 'Ваш лечащий врач видит документы и историю.' },
  { i: 'reply',  t: 'Обратная связь', d: 'Расшифровка и рекомендации на видеоконсультации.' },
];

// Слайды дневного стационара: фото на весь экран (public/images/clinic/*.webp,
// генерируются по docs/photo-prompt-clinic.md), пока — градиент-заглушки.
const slides = [
  { t: 'Клиника в Санкт-Петербурге', img: '/images/clinic/exterior.webp',   g1: 'var(--c-wash-teal)',  g2: 'var(--c-wash-blue)' },
  { t: 'Палата дневного стационара', img: '/images/clinic/ward.webp',       g1: 'var(--c-wash-teal)',  g2: 'var(--c-wash-blue)' },
  { t: 'Инфузионная зона',           img: '/images/clinic/infusion.webp',   g1: 'var(--c-wash-powder)', g2: 'var(--c-wash-teal)' },
  { t: 'Кабинет консультаций',       img: '/images/clinic/consult.webp',    g1: 'var(--c-wash-aqua)',  g2: 'var(--c-wash-blue)' },
  { t: 'Зона отдыха для близких',    img: '/images/clinic/lounge.webp',     g1: 'var(--c-wash-aqua)',  g2: 'var(--c-wash-powder)' },
  { t: 'Рецепшен и холл ожидания',   img: '/images/clinic/reception.webp',  g1: 'var(--c-wash-powder)', g2: 'var(--c-wash-teal)' },
];
---

<Base title="Клиника трансляционной медицины">
  <!-- ШАПКА -->
  <header class="site-head" id="site-head">
    <!-- верхняя утилити-полоса (сворачивается при скролле) -->
    <div class="topbar">
      <div class="wrap topbar-in">
        <button class="a11y-link" aria-label="Версия для слабовидящих">
          <svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          Версия для слабовидящих
        </button>
        <div class="topbar-info">
          <span class="ti"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="10" r="2.4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><b>ул. Петропавловская, 4</b></span>
          <a href={clinic.phoneHref} class="ti"><svg viewBox="0 0 24 24"><path d="M4 5c0 8 7 15 15 15l2.5-3.2-4.5-2-2 2c-2.5-1.2-5.1-3.8-6.3-6.3l2-2-2-4.5L4 5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><b>{clinic.phone}</b></a>
          <span class="ti ti-hours">Пн–Пт 09:00–20:00 · Сб 09:00–18:00 · Вс выходной</span>
        </div>
      </div>
    </div>
    <div class="wrap head-inner">
      <a href="/" class="brand">
        <img src="/images/logo-mark.svg" alt="Клиника трансляционной медицины" class="brand-mark" />
        <span class="brand-name">Клиника<br/><b>трансляционной медицины</b></span>
      </a>
      <nav class="nav">
        <div class="nav-item"><a href="/s-chego-nachat" class="nav-link">С чего начать</a></div>
        <div class="nav-item">
          <a href="#" class="nav-link">Диагностика <svg viewBox="0 0 24 24" class="chev"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <div class="drop">
            <a href="/molekulyarnaya-diagnostika" class="drop-it"><b>Молекулярно-генетические исследования</b><span>NGS · ПЦР · FISH — основа выбора лекарственной тактики</span></a>
            <a href="/biopsiya" class="drop-it"><b>Биопсия и гистология</b><span>Пересмотр стёкол — «не отменяем, уточняем»</span></a>
            <a href="/onkomarkery" class="drop-it"><b>Онкомаркеры</b><span>Вспомогательный анализ: динамика, не диагноз</span></a>
            <a href="#" class="drop-it"><b>Анализ крови</b></a>
            <a href="#" class="drop-it"><b>Ультразвуковая диагностика</b></a>
            <a href="#" class="drop-it"><b>Другие анализы</b></a>
          </div>
        </div>
        <div class="nav-item">
          <a href="#" class="nav-link">Лечение <svg viewBox="0 0 24 24" class="chev"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <div class="drop drop-wide">
            <a href="/lechenie" class="drop-it"><b>Выбор вида лечения</b><span>Задачи лекарственной терапии</span></a>
            <a href="/lechenie/himioterapiya" class="drop-it"><b>Химиотерапия</b><span>Эффективные схемы лечения</span></a>
            <a href="/lechenie/targetnaya-terapiya" class="drop-it"><b>Таргетная терапия</b><span>Точечное воздействие на мишени</span></a>
            <a href="/lechenie/immunoterapiya" class="drop-it"><b>Иммунотерапия</b><span>Активация собственного иммунитета</span></a>
            <a href="/lechenie/vosstanovlenie" class="drop-it"><b>Восстановление после лечения</b><span>Сопроводительная и симптоматическая терапия, восстановительное питание</span></a>
            <a href="/lechenie/klinicheskie-issledovaniya" class="drop-it"><b>Клинические исследования</b><span>Реестр активных протоколов, GCP</span></a>
          </div>
        </div>
        <div class="nav-item"><a href="/vrachi" class="nav-link">Врачи</a></div>
        <div class="nav-item"><a href="/stoimost" class="nav-link">Цены</a></div>
        <div class="nav-item"><a href="/blog" class="nav-link">Блог</a></div>
        <div class="nav-item">
          <a href="#" class="nav-link">О клинике <svg viewBox="0 0 24 24" class="chev"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <div class="drop">
            <a href="#stationar" class="drop-it"><b>Дневной стационар</b><span>Условия лечения</span></a>
            <a href="/litsenzii" class="drop-it"><b>Лицензии и сертификаты</b><span>Документы клиники</span></a>
            <a href="#stories" class="drop-it"><b>Истории пациентов</b><span>Вместе достигаем невозможного</span></a>
          </div>
        </div>
        <div class="nav-item"><a href="#contacts" class="nav-link">Контакты</a></div>
      </nav>
      <div class="head-actions">
        <button class="a11y" title="Версия для слабовидящих" aria-label="Версия для слабовидящих">Аа</button>
        <a href="#" class="btn btn-dark"><svg viewBox="0 0 24 24" class="ic-s"><path d="M4 5c0 8 7 15 15 15l2.5-3.2-4.5-2-2 2c-2.5-1.2-5.1-3.8-6.3-6.3l2-2-2-4.5L4 5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>Записаться на приём</a>
      </div>
    </div>
  </header>

  <!-- ЭКРАН 1. HERO — full-bleed фото-слайдер, текст в нижних углах -->
  <Hero />

  <!-- ЭКРАН 2. О КЛИНИКЕ — самостоятельное представление (без ЕвроСитиКлиник) -->
  <AboutClinic />

  <!-- ЭКРАН 3. КОМУ МЫ ПОМОГАЕМ — три плашки-сценария -->
  <WhoWeHelp />

  <!-- ЭКРАН 2. ПЛАН ДЕЙСТВИЙ — editorial-список 01–05 -->
  <PlanSteps />

  <!-- ЭКРАНЫ 4 + 6: единая тёмная полоса (тон «Историй пациентов»).
       Фон на общем контейнере — секции встык без субпиксельных швов. -->
  <div class="band-dark">
    <!-- ЭКРАН 6. КАК МЫ ЛЕЧИМ — две консультации, начало лечения + КИ -->
    <HowWeTreat />

    <!-- ЭКРАН 4. РАК ЛЕЧИТСЯ — типографический блок -->
    <CancerTreatable />
  </div>

  <!-- ДНЕВНОЙ СТАЦИОНАР — обычная секция: заголовок, текст, ниже карточки-фото -->
  <section class="wrap sec" id="stationar">
    <!-- факты иконками — в строку с заголовком: текст ниже делится на три РАВНЫЕ колонки -->
    <div class="sec-head sec-head-row st-head">
      <h2>Лечение в&nbsp;дневном стационаре: утром терапия&nbsp;— вечером дома</h2>
      <div class="st-facts">
        <span class="st-fact"><svg viewBox="0 0 24 24" class="ic-s"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 7v5l3.5 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>Длительность процедуры — от&nbsp;1,5&nbsp;часов</span>
        <span class="st-fact"><svg viewBox="0 0 24 24" class="ic-s" set:html={icon.team}></svg>Сопровождающий родственник может остаться с&nbsp;вами</span>
        <span class="st-fact"><svg viewBox="0 0 24 24" class="ic-s"><path d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="10" r="2.4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>В&nbsp;5&nbsp;минутах ходьбы от&nbsp;станции «{clinic.metro}»</span>
      </div>
    </div>

    <!-- три равные текстовые колонки: по одному абзацу в каждой -->
    <div class="st-cols">
      <div>
        <p>Вы&nbsp;приезжаете в&nbsp;назначенное время, вас осматривает лечащий врач-онколог, после этого вы&nbsp;получаете назначенную лекарственную терапию в&nbsp;дневном стационаре и&nbsp;в&nbsp;тот&nbsp;же день возвращаетесь домой, не&nbsp;оставаясь на&nbsp;ночь в&nbsp;больнице.</p>
      </div>
      <div>
        <p>Лечение проходит без&nbsp;длительного ожидания в&nbsp;очередях, без&nbsp;расставания с&nbsp;семьёй. Всегда рядом будут медицинская сестра и&nbsp;дежурный врач, которым можно задать вопрос.</p>
      </div>
      <div>
        <p>Наши сёстры умеют работать с&nbsp;любыми венами: процедура проходит спокойно и&nbsp;бережно. Палата на&nbsp;два места, Wi-Fi, индивидуальное кресло-реклайнер.</p>
      </div>
    </div>

    <!-- карточки: фото клиники с подписями (бывшие слайды) -->
    <div class="st-cards">
      {slides.map((s, idx) => (
        <figure class="st-card reveal" style={`--d:${idx * 0.06}s`}>
          <div class="st-photo" style={`background-image:linear-gradient(150deg,${s.g1},${s.g2})`}>
            <img src={s.img} alt={s.t} width="1600" height="1067" loading="lazy" decoding="async" onerror="this.remove()" />
          </div>
          <figcaption>{s.t}</figcaption>
        </figure>
      ))}
    </div>

    <a href="#" class="btn btn-dark">Записаться на приём</a>
  </section>

  <!-- ЭКРАН 9. ВРАЧИ -->
  <section class="wrap sec" id="doctors">
    <div class="sec-head sec-head-row">
      <div>
        <h2>Ведущие онкологи города в&nbsp;нашей клинике</h2>
        <p class="doctors-sub">Доктора медицинских наук, профессора, члены-корреспонденты РАН&nbsp;— специалисты с&nbsp;многолетним практическим опытом, которые ведут пациентов лично.</p>
      </div>
      <a href="/vrachi" class="btn btn-light">Все врачи <svg viewBox="0 0 24 24" class="ic-s" set:html={icon.arrow}></svg></a>
    </div>
    <div class="doc-grid">
      {doctors.map((d) => (<DoctorCard doctor={d} />))}
    </div>
  </section>

  <!-- ЭКРАН 10. ИСТОРИИ ПАЦИЕНТОВ — мозаика фото + карточки-истории -->
  <section class="stories-sec" id="stories">
    <div class="wrap">
      <div class="sec-head stories-head">
        <div>
          <h2>Истории наших <em class="i-serif">пациентов</em></h2>
        </div>
        <p class="stories-sub">За&nbsp;каждым диагнозом&nbsp;— человек и&nbsp;его путь. Эти истории публикуются с&nbsp;письменного согласия пациентов.</p>
      </div>
      <div class="stories-grid">
        {stories.map((s) => s.type === 'photo' ? (
          <article class={`story s-${s.size}`} style={`background:linear-gradient(160deg,${s.g1},${s.g2})`}>
            <img src={s.img} alt={s.t} class="story-img" loading="lazy" onerror="this.nextElementSibling.remove();this.remove()" />
            <div class="story-scrim"></div>
            <span class="story-tag">{s.tag}</span>
            <div class="story-body">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </article>
        ) : s.type === 'circle' ? (
          <article class="story story-circle">
            <p class="sc-label">Отзыв пациента</p>
            <p class="sc-text">{s.q}</p>
            <p class="sc-author">{s.a} · {s.role}</p>
          </article>
        ) : (
          <article class="story story-quote">
            <p class="sq-mark" aria-hidden="true">«</p>
            <p class="sq-text">{s.q}</p>
            <p class="sq-author">{s.a}, {s.role}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ЭКРАН 11. ТЕЛЕМЕДИЦИНА — начать не выходя из дома -->
  <section class="sec tele-sec" id="tele">
    <div class="blob" style="width:440px;height:440px;background:var(--c-wash-teal);top:-60px;left:8%;"></div>
    <div class="blob" style="width:400px;height:400px;background:var(--c-wash-powder);bottom:-90px;right:10%;"></div>
    <div class="blob" style="width:360px;height:360px;background:var(--c-wash-blue);top:40%;left:44%;"></div>
    <div class="wrap tele-inner">
    <div class="glass tele">
      <div class="tele-head">
        <h2>Личный кабинет пациента и&nbsp;телемедицина</h2>
        <p class="tele-sub">Если вы&nbsp;живёте в&nbsp;другом городе или вам сложно приехать, знакомство с&nbsp;врачом можно начать дистанционно. Выписки, анализы и&nbsp;снимки загружаются в&nbsp;личный кабинет&nbsp;— врач детально их&nbsp;изучит, <mark>даст предварительное заключение</mark>, рекомендует дополнительное обследование, если это необходимо, и&nbsp;пригласит на&nbsp;очный визит. Так мы&nbsp;сокращаем время до&nbsp;начала лечения.</p>
        <p class="tele-sub tele-note">Повторные консультации и&nbsp;интерпретацию анализов можно проходить дистанционно. По&nbsp;закону первичный диагноз дистанционно не&nbsp;устанавливается&nbsp;— для этого нужен очный приём.</p>
        <a href="#" class="btn btn-dark"><svg viewBox="0 0 24 24" class="ic-s" set:html={icon.upload}></svg>Загрузить документы</a>
        <p class="tele-consent">При загрузке потребуется согласие на&nbsp;обработку персональных данных (ФЗ-152).</p>
      </div>
      <div class="tele-steps">
        {teleSteps.map((s, idx) => (
          <div class="tstep">
            <div><p class="tstep-t">{idx + 1}. {s.t}</p><p class="tstep-d">{s.d}</p></div>
          </div>
        ))}
      </div>
    </div>
    </div>
  </section>

  <!-- ЭКРАН 12. ПЕРВЫЙ ШАГ — повтор плана + CTA -->
  <FirstStep />

  <!-- ЭКРАН 13. ЧАСТЫЕ ВОПРОСЫ -->
  <Faq />

  <!-- КОНТАКТЫ + ПОДВАЛ (ТЗ: футер/контакты) -->
  <FooterContacts />

  <!-- переключатель тем/шрифтов — общий, рендерится в Base.astro -->

  <style is:global>
    /* .wrap — глобальное правило (поля ≈15%) в global.css */
    .ic-s { width:16px; height:16px; }

    /* шапка */
    .site-head { position:sticky; top:0; z-index:50; overflow-anchor:none; background:var(--head-fill); border-bottom:1px solid var(--border-hairline); }
    .head-inner { display:flex; align-items:center; justify-content:space-between; height:74px; gap:24px; }
    .brand { display:flex; align-items:center; gap:12px; }
    .brand-mark { height:44px; width:auto; flex:none; }
    .brand-name { font-size:var(--fs-caption); line-height:1.25; color:var(--text-body); letter-spacing:.01em; }
    .brand-name b { color:var(--text-strong); font-weight:600; }
    .nav { display:flex; gap:6px; }
    .nav-item { position:relative; }
    .nav-link { display:inline-flex; align-items:center; gap:5px; font-size:var(--fs-body-sm); color:var(--text-body); padding:10px 12px; border-radius:var(--r-pill); transition:.2s; }
    .nav-link:hover { color:var(--text-strong); background:var(--veil); }
    .chev { width:14px; height:14px; opacity:.55; transition:transform .25s; }
    .nav-item:hover .chev, .nav-item:focus-within .chev { transform:rotate(180deg); }
    /* выпадающая панель-«ушко» */
    .drop { position:absolute; top:calc(100% + 10px); left:0; min-width:290px; padding:10px;
      background:var(--surface-elevated);
      border:1px solid var(--border-hairline); border-radius:var(--r-glass); box-shadow:var(--sh-glass);
      display:grid; gap:2px; opacity:0; visibility:hidden; transform:translateY(10px);
      transition:opacity .22s ease, transform .22s ease, visibility .22s; z-index:60; }
    .drop::before { content:""; position:absolute; top:-12px; left:0; right:0; height:14px; } /* мостик до пункта */
    .drop-wide { min-width:340px; }
    .nav-item:hover .drop, .nav-item:focus-within .drop { opacity:1; visibility:visible; transform:translateY(0); }
    .drop-it { display:grid; gap:2px; padding:11px 14px; border-radius:var(--r-input); transition:.18s; }
    .drop-it b { font-size:var(--fs-body-sm); font-weight:600; color:var(--text-strong); }
    .drop-it span { font-size:var(--fs-caption); color:var(--text-muted); line-height:1.35; }
    .drop-it:hover { background:var(--c-wash-teal); }
    .drop-it:hover b { color:var(--c-teal-deep); }
    .head-actions { display:flex; align-items:center; gap:14px; }
    .a11y { width:40px; height:40px; border-radius:var(--r-pill); border:1px solid var(--border-strong); background:var(--veil); color:var(--text-body); font-size:var(--fs-body-sm); cursor:pointer; }
    .a11y.is-on { background:var(--cta-fill); color:var(--cta-text); border-color:transparent; }

    /* hero */
    .hero-wrap { position:relative; overflow:hidden; background:var(--grad-uni); }
    .hero { position:relative; z-index:1; display:grid; grid-template-columns:2.2fr 1fr; gap:48px; align-items:center; padding-block:56px 60px; }
    .eyebrow { display:flex; gap:8px; margin-bottom:26px; }
    .chip { font-size:var(--fs-caption); color:var(--text-body); border:1px solid var(--border-hairline); border-radius:var(--r-pill); padding:6px 14px; }
    .hero-title { font-size:var(--fs-h-lg); line-height:1.14; letter-spacing:-.02em; font-weight:600; color:var(--text-strong); margin:0 0 22px; }
    .hero-sub { font-size:var(--fs-sub); line-height:1.55; color:var(--text-body); max-width:33em; margin:0 0 26px; }
    .hero-trust { display:flex; flex-wrap:wrap; gap:12px 26px; margin:0 0 30px; }
    .hero-cta { display:flex; gap:14px; flex-wrap:wrap; }

    /* hero-right: слайдер направлений на фото */
    .portrait { position:relative; aspect-ratio:4/4.4; border-radius:var(--r-card); background:linear-gradient(150deg,var(--c-wash-teal),var(--c-wash-blue) 55%,var(--c-wash-powder)); overflow:hidden; }
    .portrait-img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; transition:opacity .8s ease; }
    .portrait-img.is-active { opacity:1; }
    .portrait-scrim { position:absolute; inset:0; background:linear-gradient(to top, rgba(10,13,18,.72) 0%, rgba(10,13,18,.28) 26%, rgba(10,13,18,0) 48%); pointer-events:none; }
    .portrait-caption { position:absolute; left:0; right:0; bottom:0; padding:26px 30px; z-index:1; }
    .float-chips { position:absolute; right:16px; top:20px; display:flex; flex-direction:column; gap:10px; align-items:flex-end; z-index:2; }
    .fchip { font-family:var(--ff-body); font-size:var(--fs-caption); color:var(--text-strong); background:transparent; border:1px solid var(--border-strong); border-radius:var(--r-pill); padding:8px 16px; cursor:pointer; transition:border-color .2s ease, color .2s ease; }
    .fchip:hover { border-color:var(--accent); color:var(--accent-soft); }
    .fchip.is-active { background:var(--cta-fill); color:var(--cta-text); border-color:transparent; }

    /* секции */
    .sec { padding-block:var(--section-gap); }
    /* единая тёмная полоса экранов 4+6 — фон на контейнере, не на секциях */
    .band-dark { background:var(--stories-bg-a); }
    .sec-head { margin-bottom:var(--head-gap); }
    .sec-head-row { display:flex; justify-content:space-between; align-items:flex-end; gap:24px; }
    /* текстовый модуль занимает всю строку (иначе max-width:70% у h2 считается
       от ужатого по контенту div и заголовок ломается на 3 строки) */
    .sec-head-row > div { flex:1; min-width:0; }
    .kicker { font-size:var(--fs-caption); letter-spacing:.06em; text-transform:none; color:var(--accent); margin:0 0 12px; }
    .sec-head h2 { font-size:var(--fs-h-lg); letter-spacing:-.025em; font-weight:600; margin:0; }

    /* каталог: светлые плашки + размытые цветные круги (Bionova-референс) */
    /* ЕДИНЫЙ градиент (лёд → бирюза → голубой), УГОЛ у каждой свой (--ang inline). */
    /* Фото-плашка («шахматка», как в референсе): фото во всю плашку, снизу —
       светлая вуаль-градиент, чтобы тёмный текст читался. Нет файла → onerror
       убирает фото и остаётся единый градиент. */

    /* Белые карточки (surface-card + hairline) — единый градиент остался в каталоге. */
    /* Иллюстрации внизу карточек: clay-рендеры на белом фоне, multiply —
       фон картинки сливается с белой карточкой без швов. */
    /* Крупно, во всю ширину плашки (cover): кадр квадратный, кадрируем к центру. */
    /* «Прозрачные цены»: живой мини-прейскурант — строки как на /stoimost
       (точечный лидер, цена акцентом), лента бесконечно листается вверх.
       Список в разметке продублирован ×2 → бесшовный цикл на translateY(-50%). */
    .adv-pricelist { position:relative; margin-top:auto; height:180px; overflow:hidden;
      -webkit-mask-image:linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
      mask-image:linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent); }
    .apl-track { animation:apl-scroll 14s linear infinite; animation-play-state:paused; }
    .apl-track.run { animation-play-state:running; }
    .apl-row { display:flex; align-items:baseline; gap:8px; padding:7px 0; }
    .apl-name { font-size:var(--fs-caption); color:var(--text-body); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .apl-dots { flex:1; border-bottom:1px dotted var(--border-strong); transform:translateY(-3px); }
    .apl-price { font-size:var(--fs-caption); font-weight:600; color:var(--accent-soft); white-space:nowrap; }
    @keyframes apl-scroll { to { transform:translateY(-50%); } }
    @media (prefers-reduced-motion:reduce) { .apl-track { animation:none; } }

    /* ── ИСТОРИИ: мозаика вертикальных плашек на тёмно-синем ── */
    /* тёмное полотно: внутренние поля = «просторная» ручка ритма */
    .stories-sec { background:linear-gradient(160deg, var(--stories-bg-a), var(--stories-bg-b)); padding-block:var(--section-gap-roomy); }
    .stories-sec .kicker { color:var(--accent-on-dark); }
    .stories-sec h2 { color:var(--text-onDark); }
    .stories-head { display:flex; justify-content:space-between; align-items:flex-end; gap:24px; }
    .stories-sub { font-size:var(--fs-body-sm); line-height:1.55; color:var(--accent-on-dark); max-width:26em; margin:0; }
    /* Сетка: 4 колонки, ряд 150px, dense — tall (3 ряда) и mid (2 ряда)
       дают «какая-то крупнее, какая-то меньше»; все плашки ВЕРТИКАЛЬНЫЕ. */
    .stories-grid { display:grid; grid-template-columns:repeat(4,1fr); grid-auto-rows:150px; grid-auto-flow:dense; gap:16px; }
    .story { position:relative; overflow:hidden; border-radius:var(--r-card); display:flex; flex-direction:column; }
    .story.s-tall { grid-row:span 3; }
    .story.s-mid { grid-row:span 2; }
    .story-img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform .4s ease; }
    .story:hover .story-img { transform:scale(1.03); }
    /* Текст на тёмном градиенте снизу (обложка кейса) */
    .story-scrim { position:absolute; inset:0; background:linear-gradient(to top, color-mix(in srgb, var(--c-ink) 72%, transparent) 0%, color-mix(in srgb, var(--c-ink) 30%, transparent) 38%, transparent 62%); }
    .story-tag { position:absolute; top:14px; left:14px; z-index:1; font-size:var(--fs-caption); color:var(--text-onDark); background:var(--veil-dark); border-radius:var(--r-pill); padding:6px 13px; }
    .story-body { position:relative; margin-top:auto; padding:16px 18px 18px; color:var(--text-onDark); }
    .story-body h3 { font-size:var(--fs-sub); font-weight:600; margin:0 0 6px; color:var(--text-onDark); }
    .story-body p { font-size:var(--fs-caption); line-height:1.45; margin:0; }
    /* Текстовая плашка-цитата — КОМПАКТНАЯ (span 2), контент прижат к ВЕРХУ.
       Типографика: кавычка → цитата → автор одной строкой через запятую.
       Без полупрозрачностей — вторичный текст сплошным ледяным (--accent-on-dark). */
    /* Контент заполняет ВСЮ карточку: кавычка сверху, цитата крупно в центре
       (растянута на свободное место), автор на нижней линии. */
    .story-quote { grid-row:span 2; background:var(--tile-onDark); border:1px solid var(--hairline-onDark); padding:24px; }
    .sq-mark { font-family:var(--ff-display); font-size:var(--fs-num); line-height:.9; color:var(--accent-on-dark); margin:0; }
    .sq-text { flex:1; display:flex; align-items:center; font-family:var(--ff-display); font-size:var(--fs-h); line-height:1.4; color:var(--text-onDark); margin:10px 0 14px; }
    .sq-author { font-size:var(--fs-caption); line-height:1.45; color:var(--accent-on-dark); margin:0; }
    /* Круглая плашка-отзыв: ровный круг по ширине колонки, текст по центру. */
    .story-circle { grid-row:span 2; aspect-ratio:1; width:100%; max-width:302px; align-self:center; justify-self:center; border-radius:var(--r-pill); background:var(--accent-on-dark); color:var(--c-ink); align-items:center; justify-content:center; text-align:center; padding:34px; gap:8px; }
    .sc-label { font-size:var(--fs-caption); color:var(--c-teal-deep); margin:0; }
    .sc-text { font-family:var(--ff-display); font-size:var(--fs-body-sm); line-height:1.4; margin:0; }
    .sc-author { font-size:var(--fs-caption); font-weight:600; margin:0; color:var(--c-teal-deep); }


    /* Ширина карточки — как в исходной сетке на 4 колонки; врачей трое,
       поэтому колонка задана фиксированной долей, а не растягивается на треть */
    .doc-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:20px; }

    /* телемедицина — стекло на размытых цветных кругах */
    .tele-sec { position:relative; overflow:hidden; }
    .tele-inner { position:relative; z-index:1; }
    /* текстовый модуль шире, колонка плашек-шагов заметно уже */
    .tele { display:grid; grid-template-columns:1.6fr 1fr; gap:44px; padding:48px; }
    .tele-head h2 { font-size:var(--fs-h-lg); letter-spacing:-.025em; font-weight:600; margin:0 0 14px; }
    .tele-sub { font-size:var(--fs-body); line-height:1.55; color:var(--text-body); margin:0 0 18px; max-width:var(--measure-text); }
    .tele-note { margin-bottom:26px; }
    .tele-consent { font-size:var(--fs-caption); color:var(--text-muted); margin:12px 0 0; max-width:30em; }
    .doctors-sub { font-size:var(--fs-body); line-height:1.55; color:var(--text-body); max-width:var(--measure-lead); margin:14px 0 0; }
    .tele-steps { display:grid; gap:16px; align-content:center; }
    .tstep { display:flex; gap:16px; align-items:flex-start; background:var(--veil); border:1px solid var(--border-hairline); border-radius:var(--r-input); padding:16px 18px; }
    .tstep-t { font-size:var(--fs-body-sm); font-weight:600; margin:0 0 3px; }
    .tstep-d { font-size:var(--fs-caption); color:var(--text-body); margin:0; line-height:1.45; }

    /* подвал */
    .foot { padding-block:20px 72px; }
    .compliance-note { text-align:center; font-size:var(--fs-caption); color:var(--text-muted); border:1px solid var(--border-hairline); border-radius:var(--r-input); padding:14px; background:var(--surface-card); margin-bottom:40px; }
    .foot-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:28px; }
    .foot-h { font-size:var(--fs-body-sm); font-weight:600; color:var(--text-strong); margin:0 0 10px; }
    .foot-grid p { font-size:var(--fs-caption); line-height:1.7; color:var(--text-body); margin:0; }

    /* анимация появления */
    .reveal { opacity:0; transform:translateY(18px); transition:opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); transition-delay:var(--d,0s); }
    .reveal.in { opacity:1; transform:none; }
    @media (prefers-reduced-motion:reduce) { .reveal { opacity:1; transform:none; transition:none; } }

    /* дневной стационар: факты иконками — в строке заголовка (справа),
       ниже — три РАВНЫЕ текстовые колонки, по одному абзацу в каждой */
    .st-cols { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px 32px; margin-bottom:34px; }
    .st-cols p { font-size:var(--fs-body-lg); line-height:var(--lh-body-lg); letter-spacing:var(--tr-body-lg); color:var(--text-body); margin:0; }
    /* практические детали иконками (ТЗ, экран 7) — вертикальный список, читается сверху вниз;
       .st-head перекрывает flex:1 от .sec-head-row > div — факты не растягиваются */
    .st-head .st-facts { display:flex; flex-direction:column; gap:10px; flex:none; }
    .st-head h2 { max-width:var(--measure-head); }
    .st-fact { display:inline-flex; align-items:center; gap:10px; font-size:var(--fs-body-sm); color:var(--text-body); }
    .st-fact .ic-s { color:var(--accent); flex-shrink:0; }
    /* карточки-фото клиники: 3 в ряд, подпись под фото */
    .st-cards { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; margin-bottom:34px; }
    .st-card { margin:0; }
    .st-photo { aspect-ratio:4/3; border-radius:var(--r-card); overflow:hidden; background-size:cover; background-position:center; }
    .st-photo img { width:100%; height:100%; object-fit:cover; display:block; }
    .st-card figcaption { font-size:var(--fs-body-sm); color:var(--text-body); margin-top:10px; }

    /* быстрые ссылки */

    /* новости / статьи */

    /* о клинике / миссия — центрированный текстовый блок */
    .hl { color:var(--c-teal-deep); }
    .hl-2 { color:var(--c-violet-deep); }
    /* цвет иконки задаёт тема через --tile-*-icon (air: на тон темнее;
       flat/apple: белая на сплошном бренде) — руками не красить */
    /* колонки на всю ширину .wrap — от поля до поля, без сжатия */

    /* наш подход — заголовок слева, текст справа */
    .split { display:grid; grid-template-columns:1fr 1.35fr; gap:56px; align-items:start; }

    /* доверие: цифры без плашек — крупное число + подпись вплотную (10px) */
    .stats-row { display:flex; justify-content:space-between; gap:40px; flex-wrap:wrap; margin-bottom:36px; }
    .stat-card { display:flex; align-items:baseline; gap:10px; }
    .stat-n { font-family:var(--ff-body); font-size:var(--fs-num-lg); font-weight:600; letter-spacing:-.03em; line-height:1; color:var(--accent); }
    .stat-l { font-size:var(--fs-body-sm); line-height:1.3; color:var(--text-body); max-width:11em; }

    /* контакты + форма */
    .contact-grid { display:grid; grid-template-columns:1fr 1fr; gap:32px; align-items:start; }
    .contact-info { display:grid; gap:20px; }
    .ci-row b { display:block; font-size:var(--fs-body-sm); font-weight:600; color:var(--text-strong); margin-bottom:4px; }
    .ci-row p { font-size:var(--fs-body-sm); line-height:1.55; margin:0; }
    .ci-link { color:var(--accent); font-weight:500; }
    .map-stub { height:200px; border-radius:var(--r-card); background:linear-gradient(150deg,var(--c-wash-blue),var(--c-wash-teal)); display:flex; align-items:center; justify-content:center; }
    .map-stub span { font-size:var(--fs-caption); letter-spacing:.06em; color:rgba(10,13,18,.4); }
    .contact-form { padding:32px 34px; display:grid; gap:14px; }
    .contact-form h3 { font-size:var(--fs-h); margin:0 0 6px; }
    .fi { font-family:var(--ff-body); font-size:var(--fs-body-sm); color:var(--text-strong); background:var(--veil-strong); border:1px solid var(--border-hairline); border-radius:var(--r-input); padding:13px 16px; outline:none; transition:border-color .2s; resize:vertical; }
    .fi:focus { border-color:var(--accent); }
    .fi::placeholder { color:var(--text-muted); }
    .consent { display:flex; gap:10px; align-items:flex-start; font-size:var(--fs-caption); color:var(--text-muted); line-height:1.45; }
    .consent input { margin-top:2px; accent-color:var(--accent); }
    .contact-form .btn { justify-content:center; }

    /* финальный CTA-band */
    .cta-wrap { position:relative; overflow:hidden; padding-block:32px 56px; }
    .cta-band { display:grid; grid-template-columns:1fr auto; align-items:center; gap:28px; padding:44px 48px; }
    .cta-text h2 { font-size:var(--fs-h-lg); letter-spacing:-.025em; font-weight:600; margin:0 0 10px; }
    .cta-text p { font-size:var(--fs-body); line-height:1.55; color:var(--text-body); margin:0; max-width:34em; }
    .cta-actions { display:flex; gap:12px; flex-wrap:wrap; }
    .cta-note { grid-column:1 / -1; font-size:var(--fs-caption); color:var(--text-muted); margin:0; padding-top:8px; }

    /* адаптив */
    @media (max-width:960px) {
      .stories-grid { grid-template-columns:repeat(2,1fr); }
      .stories-head { flex-direction:column; align-items:flex-start; }
      .split { grid-template-columns:1fr; gap:24px; }
      .hero { grid-template-columns:1fr; }
      .hero-right { max-width:460px; }
      .tele, .contact-grid { grid-template-columns:1fr; }
      .stats-row { gap:24px; }
      .cta-band { grid-template-columns:1fr; }
      .st-cols { grid-template-columns:1fr; gap:14px; }
      .st-head { flex-direction:column; align-items:flex-start; gap:18px; }
      .st-cards { grid-template-columns:repeat(2,minmax(0,1fr)); }
      .nav { display:none; }
    }
    @media (max-width:560px) {
      .stories-grid { grid-template-columns:1fr; grid-auto-rows:130px; }
      .sec { padding-block:var(--section-gap); }
      .hero-title { font-size:var(--fs-h-lg); }
    }
  </style>

  <script>
    const html = document.documentElement;
    // переключатели темы/шрифта — в Base.astro (общие для всех страниц)


    // карточки врачей — без JS: «Подробнее о враче» ведёт на /vrachi/<slug>

    // автоплей только пока блок на экране — вне экрана кроссфейды не гоняем
    const autoplayIO = (el: Element | null, start: () => void, stop: () => void) => {
      if (!el) return;
      new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0.1 }).observe(el);
    };

    // появление блоков при скролле
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</Base>

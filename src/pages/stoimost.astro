---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import FooterContacts from '../components/sections/FooterContacts.astro';
import { clinic } from '../data/clinic';

const dl = '<path d="M12 4v11m0 0l-4-4m4 4l4-4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>';

// Прейскурант: все группы раскрыты сразу, цены сравниваются взглядом.
const priceGroups = [
  { g: 'Консультации', items: [
    { t: 'Первичная консультация онколога', n: 'до 60 минут, с планом обследования', p: '4 500' },
    { t: 'Повторная консультация онколога', n: 'до 40 минут', p: '3 500' },
    { t: 'Консультация онколога, к.м.н.', n: 'ведущий специалист', p: '6 000' },
    { t: 'Консультация онколога, д.м.н.', n: 'научный руководитель направления', p: '8 500' },
    { t: 'Консилиум (3 специалиста)', n: 'разбор случая командой', p: '15 000' },
  ]},
  { g: 'Телемедицина', items: [
    { t: 'Телемедицинская консультация (повторная)', n: 'видеосвязь, до 30 минут', p: '2 800' },
    { t: 'Расшифровка загруженных анализов', n: 'письменное заключение врача', p: '1 900' },
    { t: 'Второе мнение по документам', n: 'пересмотр диагноза и схемы', p: '7 500' },
  ]},
  { g: 'Химиотерапия (дневной стационар)', items: [
    { t: 'Пребывание в дневном стационаре', n: 'кресло-реклайнер, наблюдение, до 6 часов', p: '5 500' },
    { t: 'Введение химиопрепарата, 1 категория', n: 'без стоимости препарата', p: '4 900' },
    { t: 'Введение химиопрепарата, 2 категория', n: 'длительная инфузия', p: '7 900' },
    { t: 'Введение химиопрепарата, 3 категория', n: 'многочасовые схемы, премедикация', p: '11 900' },
  ]},
  { g: 'Таргетная и иммунотерапия', items: [
    { t: 'Введение таргетного препарата', n: 'без стоимости препарата', p: '6 900' },
    { t: 'Введение иммунопрепарата', n: 'ингибиторы контрольных точек', p: '8 900' },
    { t: 'Наблюдение после инфузии', n: 'мониторинг 2 часа', p: '2 500' },
  ]},
  { g: 'Сопроводительная терапия', items: [
    { t: 'Противорвотная терапия', n: 'схема по назначению', p: '3 200' },
    { t: 'Инфузионная поддержка', n: 'растворы, витамины, электролиты', p: '3 900' },
    { t: 'Костно-модифицирующая терапия', n: 'без стоимости препарата', p: '4 500' },
  ]},
  { g: 'Венозные порт-системы', items: [
    { t: 'Установка порт-системы', n: 'включая систему и УЗИ-навигацию', p: '38 000' },
    { t: 'Обслуживание порт-системы', n: 'промывание, перевязка', p: '2 900' },
    { t: 'Удаление порт-системы', n: 'амбулаторно', p: '18 000' },
  ]},
  { g: 'Лабораторная диагностика', items: [
    { t: 'Клинический анализ крови', n: 'с лейкоцитарной формулой', p: '950' },
    { t: 'Биохимический профиль онкопациента', n: '12 показателей', p: '2 400' },
    { t: 'Онкомаркеры (панель)', n: 'по назначению врача', p: '3 600' },
  ]},
  { g: 'Молекулярно-генетические исследования', items: [
    { t: 'ПЦР-тест мутаций (одна мишень)', n: 'EGFR, KRAS, BRAF…', p: '9 500' },
    { t: 'FISH-исследование', n: 'HER2, ALK', p: '14 500' },
    { t: 'NGS-панель (таргетный подбор)', n: '50+ генов, заключение молекулярного консилиума', p: '68 000' },
  ]},
];
---

<Base title="Стоимость услуг — Клиника трансляционной медицины">
  <!-- ШАПКА -->
  <Header current="stoimost" />

  <!-- HERO страницы -->
  <section class="page-hero">
    <div class="blob" style="width:480px;height:480px;background:var(--c-wash-teal);top:-160px;left:-60px;"></div>
    <div class="blob" style="width:420px;height:420px;background:var(--c-wash-blue);top:-80px;right:-40px;"></div>
    <div class="wrap" style="position:relative;z-index:1;">
      <p class="kicker">Прозрачные цены</p>
      <h1 class="page-title">Стоимость услуг</h1>
      <p class="page-sub">Весь прейскурант открыт — сравнивайте и планируйте лечение заранее. Итоговый план терапии рассчитываем до начала курса, без скрытых доплат.</p>
      <a href="#" class="btn btn-light"><svg viewBox="0 0 24 24" class="ic-s" set:html={dl}></svg> Скачать прайс-лист PDF · утверждён 01.07.2026</a>
    </div>
  </section>

  <!-- ТАБЛИЦА -->
  <section class="wrap sec">
    {priceGroups.map((grp) => (
      <div class="pg">
        <h2 class="pg-title">{grp.g}</h2>
        <div class="pg-table">
          {grp.items.map((it) => (
            <div class="pr">
              <div class="pr-name"><b>{it.t}</b><span>{it.n}</span></div>
              <div class="pr-price">{it.p} ₽</div>
            </div>
          ))}
        </div>
      </div>
    ))}
    <p class="compliance-note">Имеются противопоказания. Необходима консультация специалиста. Цены носят информационный характер и не являются публичной офертой.</p>
  </section>

  <!-- КОНТАКТЫ + ПОДВАЛ — общий компонент.
       Раньше здесь была своя урезанная копия подвала: без формы «Задать вопрос»,
       без реквизитов и с мёртвыми строками «Права пациента». -->
  <FooterContacts />

  <style is:global>
    .ic-s { width:16px; height:16px; }
    .kicker { font-size:var(--fs-caption); letter-spacing:.06em; text-transform:none; color:var(--accent); margin:0 0 12px; }
    .sec { padding-block:32px 48px; }
    .compliance-note { text-align:center; font-size:var(--fs-caption); color:var(--text-muted); border:1px solid var(--border-hairline); border-radius:var(--r-input); padding:14px; background:var(--surface-card); margin-top:40px; }

    /* Стили шапки — в Header.astro (дубль удалён) */

    /* hero */
    .page-hero { position:relative; overflow:hidden; background:var(--grad-uni); padding-block:44px 32px; }
    .page-sub { font-size:var(--fs-sub); line-height:1.55; color:var(--text-body); max-width:var(--measure-lead); margin:0 0 28px; }

    /* прейскурант */
    .pg { margin-bottom:44px; }
    .pg-title { font-size:var(--fs-h); letter-spacing:-.02em; margin:0 0 14px; }
    .pg-table { background:var(--surface-card); border:1px solid var(--border-hairline); border-radius:var(--r-card); overflow:hidden; }
    /* цена стоит сразу за колонкой названия (короткий путь глазами слева направо),
       а не у правого края таблицы; колонка фиксирована — цены выровнены в столбик */
    .pr { display:grid; grid-template-columns:minmax(280px, 46%) auto; justify-content:start; align-items:center; column-gap:32px; padding:11px 22px; border-top:1px solid var(--border-hairline); transition:background .15s; cursor:default; }
    .pr:first-child { border-top:0; }
    .pr-name { display:grid; gap:1px; }
    .pr-name b { font-size:var(--fs-body-sm); font-weight:600; color:var(--text-strong); }
    .pr-name span { font-size:var(--fs-caption); color:var(--text-muted); }
    .pr-price { font-size:var(--fs-body); font-weight:600; color:var(--text-strong); white-space:nowrap; font-variant-numeric:tabular-nums; }
    /* наведение: мягкая подсветка фирменным зелёным (~10%), без анимаций */
    .pr:hover { background:color-mix(in srgb, var(--accent) 10%, transparent); }

    /* подвал */

    @media (max-width:760px) {
      .nav { display:none; }
      .pr { column-gap:12px; }
    }
  </style>
</Base>

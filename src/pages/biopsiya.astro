---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import FooterContacts from '../components/sections/FooterContacts.astro';
import PageCta from '../components/sections/PageCta.astro';

/* ============================================================
   «Биопсия и гистология» — страница раздела «Диагностика» (ТЗ, раздел 3).
   Сценарий:
   1) hero + главная мысль «диагноз ставит не картинка, а морфолог»;
   2) виды биопсии — одинаковые белые карточки + честный блок про жидкостную;
   3) путь материала в лаборатории — editorial-список с номерами 01–05;
   4) что написано в заключении — справочная таблица;
   5) ПЕРЕСМОТР СТЁКОЛ (id="peresmotr") — ключевой блок, якорь с главной;
   6) подготовка и что после — чек-лист + «когда звонить врачу»;
   7) частые страхи и мифы — пары «утверждение → как на самом деле»;
   8) что дальше — связки с другими страницами;
   9) FAQ статичным списком;
   10) CTA + нормативная плашка ФЗ-38.
   Конкретика клиники — видимыми заглушками [X] / [уточняется у клиники].
   Всё на токенах, без хардкодов, без капса/italic.
   ============================================================ */

const icon: Record<string, string> = {
  check: '<path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
};

// — Экран 2. Виды биопсии (одинаковые белые карточки) —
const kinds = [
  {
    t: 'Тонкоигольная аспирационная биопсия',
    d: 'Очень тонкой иглой&nbsp;— тоньше, чем для укола в&nbsp;вену&nbsp;— из&nbsp;образования набирают клетки. Чаще так исследуют щитовидную железу, лимфоузлы, кисты; обычно под контролем УЗИ, без анестезии или с&nbsp;местной. Самый щадящий метод, но&nbsp;он&nbsp;даёт отдельные клетки, а&nbsp;не&nbsp;структуру ткани: часть диагнозов (например, лимфому) им&nbsp;подтвердить нельзя, и&nbsp;тогда нужен другой способ.',
  },
  {
    t: 'Кор-биопсия (трепан-биопсия)',
    d: 'Специальная игла забирает цилиндрик ткани длиной около 1–2&nbsp;см&nbsp;— «столбик», в&nbsp;котором сохранилось строение. Основной метод, когда нужно определить тип опухоли и&nbsp;сделать иммуногистохимию: материала хватает и&nbsp;на&nbsp;окраски, и&nbsp;на&nbsp;молекулярные тесты. Делается под местной анестезией, под контролем УЗИ, КТ или маммографа; обычно берут 3–5&nbsp;столбиков.',
  },
  {
    t: 'Инцизионная и&nbsp;эксцизионная биопсия',
    d: 'Хирург иссекает часть образования или удаляет его целиком&nbsp;— например, увеличенный лимфоузел или подозрительное образование на&nbsp;коже. К&nbsp;этому варианту прибегают, когда игольной биопсии заведомо не&nbsp;хватит: при подозрении на&nbsp;лимфому, саркому мягких тканей, при небольших поверхностных образованиях. Проводится в&nbsp;операционной, накладываются швы, нужен небольшой период заживления.',
  },
  {
    t: 'Эндоскопическая биопсия',
    d: 'Материал берут через эндоскоп&nbsp;— гибкий инструмент с&nbsp;камерой, введённый естественным путём: при гастроскопии, колоноскопии, бронхоскопии, цистоскопии. Отдельного прокола не&nbsp;нужно: врач видит слизистую, выбирает участок и&nbsp;берёт из&nbsp;него несколько фрагментов щипцами. Само взятие материала не&nbsp;чувствуется&nbsp;— дискомфорт связан с&nbsp;эндоскопией, поэтому её часто делают в&nbsp;медикаментозном сне.',
  },
  {
    t: 'Трепанобиопсия костного мозга',
    d: 'Специальной иглой из&nbsp;гребня подвздошной кости берут столбик костного мозга, часто вместе с&nbsp;аспиратом. Нужна при лимфомах, миеломе, лейкозах и&nbsp;в&nbsp;тех случаях, когда важно понять, затронут&nbsp;ли костный мозг. Делается под местной анестезией, занимает около 15–20&nbsp;минут; несколько дней возможна болезненность в&nbsp;месте вкола&nbsp;— это ожидаемо.',
  },
];

// — Экран 3. Путь материала в лаборатории (editorial-список 01–05) —
const path = [
  {
    n: '01',
    t: 'Фиксация',
    p: 'Сразу после взятия ткань помещают в&nbsp;формалин&nbsp;— иначе клетки начинают разрушаться в&nbsp;течение минут. Фиксация занимает от&nbsp;нескольких часов до&nbsp;суток в&nbsp;зависимости от&nbsp;размера фрагмента. Этап критичный: если ткань зафиксирована плохо, часть исследований&nbsp;— особенно иммуногистохимия и&nbsp;молекулярные тесты&nbsp;— может стать невозможной.',
  },
  {
    n: '02',
    t: 'Проводка и&nbsp;парафиновый блок',
    p: 'Из&nbsp;ткани вытесняют воду, пропитывают её парафином и&nbsp;заливают в&nbsp;небольшой брусок&nbsp;— это и&nbsp;есть парафиновый блок. Блок&nbsp;— самое ценное, что остаётся от&nbsp;биопсии: он&nbsp;хранится годами, и&nbsp;из&nbsp;него в&nbsp;любой момент можно нарезать новые стёкла для дополнительных окрасок, пересмотра или молекулярного анализа. Поэтому блок стоит забрать из&nbsp;лаборатории и&nbsp;хранить.',
  },
  {
    n: '03',
    t: 'Стёкла и&nbsp;окраска',
    p: 'С&nbsp;блока микротомом срезают слои толщиной несколько микрон, переносят их на&nbsp;стеклянные пластинки и&nbsp;окрашивают: базовая окраска гематоксилином и&nbsp;эозином показывает строение ткани и&nbsp;вид клеток. Эти стёкла врач-патоморфолог смотрит под микроскопом. В&nbsp;части случаев базовой окраски достаточно для ответа.',
  },
  {
    n: '04',
    t: 'Иммуногистохимия',
    p: 'Если по&nbsp;строению ткани тип опухоли определить не&nbsp;удаётся или нужно понять её биологию, делают ИГХ: на&nbsp;срез наносят антитела, которые окрашиваются только там, где есть конкретный белок. Так определяют происхождение опухоли, различают похожие под микроскопом варианты и&nbsp;выявляют характеристики, от&nbsp;которых зависит выбор лечения&nbsp;— ER, PR, HER2, Ki-67, PD-L1. Каждый маркер&nbsp;— отдельная реакция на&nbsp;отдельном стекле.',
  },
  {
    n: '05',
    t: 'Заключение',
    p: 'Морфолог собирает картину воедино и&nbsp;формулирует диагноз: тип опухоли, степень злокачественности, результаты окрасок. Это документ, из&nbsp;которого вырастает весь план лечения, поэтому формулировки в&nbsp;нём выверяются, а&nbsp;в&nbsp;спорных случаях материал смотрит второй специалист.',
  },
];

// — Экран 4. Что написано в заключении (справочная таблица) —
const report = [
  {
    row: 'Гистологический тип',
    note: 'Из&nbsp;каких клеток состоит опухоль: аденокарцинома, плоскоклеточный рак, диффузная В-крупноклеточная лимфома и&nbsp;так далее. Главный пункт заключения: от&nbsp;типа зависит, какие препараты вообще работают. Один и&nbsp;тот&nbsp;же орган может дать разные типы опухоли с&nbsp;разной тактикой лечения.',
  },
  {
    row: 'Grade (G1–G4)',
    note: 'Насколько клетки опухоли отличаются от&nbsp;нормальных клеток той&nbsp;же ткани. G1&nbsp;— строение почти сохранено, рост медленнее; G3&nbsp;— клетки сильно изменены и&nbsp;делятся активнее. Grade&nbsp;— это не&nbsp;стадия: он&nbsp;говорит о&nbsp;характере опухоли, а&nbsp;не&nbsp;о&nbsp;её распространённости.',
  },
  {
    row: 'pTNM',
    note: 'Стадия по&nbsp;данным операционного материала: T&nbsp;— размер и&nbsp;глубина прорастания, N&nbsp;— есть&nbsp;ли опухолевые клетки в&nbsp;удалённых лимфоузлах и&nbsp;в&nbsp;скольких, M&nbsp;— отдалённые очаги. Буква «p» означает, что это подтверждено морфологически, а&nbsp;не&nbsp;только по&nbsp;снимкам.',
  },
  {
    row: 'Край резекции (R0&nbsp;/&nbsp;R1)',
    note: 'Только для удалённых образований: осталась&nbsp;ли опухоль в&nbsp;границе иссечённой ткани. R0&nbsp;— в&nbsp;краях опухолевых клеток нет, опухоль удалена в&nbsp;пределах здоровой ткани. R1&nbsp;— клетки доходят до&nbsp;края, и&nbsp;тогда обсуждают дополнительное лечение.',
  },
  {
    row: 'Ki-67',
    note: 'Доля клеток в&nbsp;состоянии деления, в&nbsp;процентах. Показывает, насколько активно опухоль растёт. Высокий Ki-67 сам по&nbsp;себе не&nbsp;означает «всё плохо»: быстро делящиеся опухоли часто лучше отвечают на&nbsp;химиотерапию.',
  },
  {
    row: 'ER и&nbsp;PR',
    note: 'Рецепторы к&nbsp;эстрогену и&nbsp;прогестерону. Если они есть, опухоль чувствительна к&nbsp;гормональной терапии&nbsp;— это открывает целую группу препаратов.',
  },
  {
    row: 'HER2',
    note: 'Белок на&nbsp;поверхности клеток. При его избытке работают таргетные препараты против HER2; при отсутствии избытка эта группа лекарств не&nbsp;применяется.',
  },
  {
    row: 'PD-L1',
    note: 'Маркер, по&nbsp;которому оценивают вероятность ответа на&nbsp;иммунотерапию. Как и&nbsp;остальные маркеры, это не&nbsp;«плохой» или «хороший» результат, а&nbsp;указание, какая группа лекарств может подойти.',
  },
];

// — Экран 5. Пересмотр стёкол: когда особенно оправдан —
const whenReview = [
  'Редкая опухоль или опухоль без установленной первичной локализации&nbsp;— таких случаев в&nbsp;общей практике мало, и&nbsp;опыт распознавания накапливается только в&nbsp;специализированных центрах.',
  'Подозрение на&nbsp;лимфому или саркому&nbsp;— именно здесь расхождения встречаются чаще всего и&nbsp;почти всегда требуется полноценная ИГХ-панель.',
  'Заключение сформулировано неопределённо: «нельзя исключить», «дифференциальный диагноз между», «требуется дообследование».',
  'Морфология не&nbsp;сходится с&nbsp;клинической картиной или с&nbsp;данными КТ и&nbsp;МРТ: по&nbsp;снимкам процесс выглядит иначе, чем описан под микроскопом.',
  'Впереди тяжёлое или длительное лечение&nbsp;— химиотерапия, длительная гормонотерапия, объёмная операция. Если тактика зависит от&nbsp;одного слова в&nbsp;заключении, это слово стоит проверить.',
  'Диагноз ставился без ИГХ, а&nbsp;тип опухоли предполагает её обязательное выполнение.',
  'Прошло много времени между биопсией и&nbsp;началом лечения или планируется смена схемы терапии.',
];

// — Экран 5b. Что принести на пересмотр —
const bring = [
  {
    t: 'Парафиновые блоки',
    d: 'Главное. Из&nbsp;них можно нарезать новые стёкла и&nbsp;выполнить любые дополнительные исследования. Если стёкол не&nbsp;сохранилось, а&nbsp;блоки есть&nbsp;— этого достаточно.',
  },
  {
    t: 'Готовые стёкла',
    d: 'Все, что выдали на&nbsp;руки, включая стёкла с&nbsp;иммуногистохимией.',
  },
  {
    t: 'Первичное морфологическое заключение',
    d: 'Протокол исследования, который соответствует именно этому материалу.',
  },
  {
    t: 'Клинический контекст',
    d: 'Направление, выписки, протоколы операций, описания и&nbsp;диски КТ, МРТ, ПЭТ-КТ&nbsp;— чтобы морфолог видел ситуацию целиком, а&nbsp;не&nbsp;только стекло.',
  },
  {
    t: 'Паспорт и&nbsp;полис',
    d: 'Нужны для оформления исследования и&nbsp;выдачи заключения.',
  },
];

// — Экран 6. Подготовка к биопсии (чек-лист) —
const prep = [
  {
    t: 'Расскажите о&nbsp;лекарствах',
    d: 'Отдельно и&nbsp;обязательно&nbsp;— о&nbsp;препаратах, влияющих на&nbsp;свёртываемость: варфарин, ривароксабан, апиксабан, дабигатран, клопидогрел, ацетилсалициловая кислота. Скажите об&nbsp;этом при записи, а&nbsp;не&nbsp;в&nbsp;день процедуры.',
  },
  {
    t: 'Не&nbsp;отменяйте препараты сами',
    d: 'Такие лекарства иногда приостанавливают перед процедурой, но&nbsp;<mark>решение принимает только врач</mark>: самостоятельная отмена антикоагулянта опаснее самой биопсии.',
  },
  {
    t: 'Сдайте назначенные анализы',
    d: 'Обычно это общий анализ крови и&nbsp;показатели свёртывания, иногда группа крови. Точный перечень зависит от&nbsp;вида биопсии: [уточняется у&nbsp;клиники].',
  },
  {
    t: 'Уточните про наркоз и&nbsp;сопровождение',
    d: 'Если планируется медикаментозный сон, нужно прийти натощак и&nbsp;в&nbsp;сопровождении, за&nbsp;руль в&nbsp;этот день садиться нельзя. При местной анестезии голодать не&nbsp;нужно, и&nbsp;домой вы&nbsp;уходите сами.',
  },
];

// — Экран 6b. Что после процедуры —
const after = [
  {
    t: 'Во&nbsp;время процедуры',
    d: 'При местной анестезии ощущается укол анестетика и&nbsp;затем давление, но&nbsp;не&nbsp;боль. Игольная биопсия занимает 10–20&nbsp;минут вместе с&nbsp;подготовкой, само взятие материала&nbsp;— секунды. Аппарат для кор-биопсии издаёт щёлкающий звук: это нормально и&nbsp;не&nbsp;означает, что что-то пошло не&nbsp;так.',
  },
  {
    t: 'Первые день-два',
    d: 'В&nbsp;месте вкола обычно есть умеренная болезненность, небольшой синяк или уплотнение, иногда тянущее ощущение при движении. Это ожидаемая реакция тканей. Достаточно покоя и, при необходимости, простого обезболивающего&nbsp;— какого именно, скажет врач.',
  },
  {
    t: 'Ближайшие дни',
    d: 'Стоит воздержаться от&nbsp;бани, сауны, горячей ванны, бассейна и&nbsp;тяжёлых нагрузок: после биопсии под контролем УЗИ обычно 1–2&nbsp;дня, после эксцизионной&nbsp;— до&nbsp;снятия швов.',
  },
];

// — Экран 6c. Когда звонить врачу —
const alarm = [
  'Кровотечение из&nbsp;места вкола, которое не&nbsp;останавливается прижатием в&nbsp;течение 10–15&nbsp;минут.',
  'Быстро растущий синяк или отёк в&nbsp;месте вкола.',
  'Температура выше 38&nbsp;°C, озноб.',
  'Покраснение, отёк и&nbsp;нарастающая боль вокруг места вкола через несколько дней; гнойные выделения.',
  'После биопсии в&nbsp;грудной клетке&nbsp;— усиливающаяся одышка или резкая боль при дыхании.',
  'После биопсии брюшной полости&nbsp;— сильная боль в&nbsp;животе, слабость, головокружение.',
];

// — Экран 7. Мифы: утверждение → как на самом деле —
const myths = [
  {
    q: '«Биопсия провоцирует рост опухоли и&nbsp;разносит её по&nbsp;организму»',
    a: 'Самое частое опасение&nbsp;— и&nbsp;самое хорошо изученное. Перенос клеток по&nbsp;ходу иглы технически возможен, но&nbsp;встречается редко и, что важнее, не&nbsp;влияет на&nbsp;исход. Исследование клиники Мэйо более чем на&nbsp;2000&nbsp;пациентов с&nbsp;раком поджелудочной железы показало: у&nbsp;тех, кому биопсию делали, результаты лечения были не&nbsp;хуже, а&nbsp;лучше. Обзорные работы дают частоту такого переноса менее&nbsp;1%, а&nbsp;обзор 2024&nbsp;года по&nbsp;биопсии молочной железы подтвердил, что игольная биопсия не&nbsp;увеличивает риск возврата болезни. Обратная сторона тоже измерена: задержка биопсии на&nbsp;три месяца и&nbsp;более после находки на&nbsp;снимках связана со&nbsp;снижением выживаемости примерно на&nbsp;20% в&nbsp;относительном выражении. То&nbsp;есть <mark>риск создаёт не&nbsp;биопсия, а&nbsp;ожидание</mark>. Отдельные опухоли действительно не&nbsp;биопсируют иглой и&nbsp;удаляют целиком&nbsp;— это известно врачу заранее.',
  },
  {
    q: '«А&nbsp;нельзя обойтись КТ, МРТ или онкомаркерами?»',
    a: 'Нельзя, и&nbsp;причина не&nbsp;в&nbsp;осторожности врачей. Снимок показывает, что в&nbsp;органе есть образование, его размер и&nbsp;границы, но&nbsp;не&nbsp;показывает, из&nbsp;каких клеток оно состоит,&nbsp;— а&nbsp;именно от&nbsp;типа клеток зависит выбор препаратов. Онкомаркеры&nbsp;— белки в&nbsp;крови: они повышаются и&nbsp;при воспалении, и&nbsp;при доброкачественных процессах, а&nbsp;при подтверждённой опухоли могут оставаться нормальными. Назначить химиотерапию по&nbsp;снимку означает лечить неизвестно что.',
  },
  {
    q: '«Это очень больно»',
    a: 'Игольная биопсия делается под местной анестезией: чувствуется укол анестетика&nbsp;— как при лечении зуба&nbsp;— и&nbsp;затем давление, но&nbsp;не&nbsp;боль. Большинство пациентов описывают процедуру как неприятную, а&nbsp;не&nbsp;болезненную, и&nbsp;говорят, что ожидание было тяжелее самой биопсии. Если у&nbsp;вас низкий порог переносимости или сильная тревога, скажите заранее: возможны дополнительное обезболивание или медикаментозный сон. Терпеть боль молча не&nbsp;нужно&nbsp;— во&nbsp;время процедуры об&nbsp;этом можно сказать врачу.',
  },
  {
    q: '«А&nbsp;вдруг занесут инфекцию»',
    a: 'Биопсия&nbsp;— стерильная процедура: одноразовые иглы, обработка кожи антисептиком, стерильные перчатки и&nbsp;инструменты. Инфекционные осложнения при игольной биопсии редки; риск выше при вмешательствах в&nbsp;определённых зонах, и&nbsp;тогда врач заранее обсуждает профилактику антибиотиком. Со&nbsp;своей стороны: не&nbsp;мочить место вкола первые сутки, несколько дней не&nbsp;ходить в&nbsp;баню и&nbsp;бассейн и&nbsp;позвонить в&nbsp;клинику, если появились нарастающая боль, покраснение и&nbsp;температура.',
  },
];

// — Экран 8. Что дальше: связки с другими страницами —
const next = [

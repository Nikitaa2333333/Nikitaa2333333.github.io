---
/* ============================================================
   /pamyatka — «Памятка пациенту».

   Одна страница-хаб вместо россыпи мелких документов: правила записи,
   первый приём, подготовка к исследованиям, день в дневном стационаре,
   права пациента (ФЗ-323), платные услуги, документы, персональные
   данные и обращения. Часть разделов клиника обязана публиковать
   по приказу Минздрава 956н.

   Страница НЕ дублирует /s-chego-nachat: там путь до первой консультации
   (какие документы собрать и где их взять), здесь — как всё устроено,
   когда вы уже пришли. Пересечения решены ссылками.

   Данные клиники, которых у нас нет (сроки, суммы, порядок связи вне
   приёма), стоят видимыми заглушками «[уточняется у клиники]» —
   выдумывать их нельзя.
   ============================================================ */
import ArticlePage from '../components/ArticlePage.astro';
import article from '../data/articles/pamyatka.json';
---

<ArticlePage
  article={article}
  eyebrow="Пациентам"
  current="pamyatka"
  crumbs={[{ label: 'Главная', href: '/' }, { label: 'Памятка пациенту' }]}
  ctaTitle="Остался вопрос, которого здесь нет?"
  ctaText="Позвоните или напишите — администратор ответит на организационные вопросы, а всё, что касается лечения, разберёт врач на консультации по вашим документам."
/>

---
/* Клинические исследования — страница раздела «Лечение»
   (пункт меню, до этого висел заглушкой href="#"; на неё же ведут
   чип в «Как проходит лечение» и шаг 06 плана на главной).
   Контент — данными, рендер — общий ArticlePage. */
import ArticlePage from '../../components/ArticlePage.astro';
import article from '../../data/articles/lechenie/klinicheskie-issledovaniya.json';
---

<ArticlePage
  article={article}
  eyebrow="Лечение"
  current="ki"
  crumbs={[{ label: 'Главная', href: '/' }, { label: 'Лечение', href: '/lechenie' }, { label: 'Клинические исследования' }]}
  ctaTitle="Хотите узнать про участие в исследовании?"
  ctaText="Возможность участия всегда оценивает врач по вашим документам: диагнозу, стадии, уже пройденному лечению. Запишитесь на консультацию — обсудим, есть ли подходящий вариант."
/>

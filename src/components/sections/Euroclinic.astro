---
/* Экран 1.5 «Сеть ЕвроСитиКлиник» — сразу после hero: кто за нами стоит.
   Смысл: Клиника трансляционной медицины — продолжение действующей
   ЕвроСитиКлиник (клиника современной онкологии, СПб, работает с 2019 года).
   Вёрстка: заголовок + два простых текстовых столбца, без плашек;
   во втором — факты сети и ссылка на их сайт. */
const chev =
  '<path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>';
---

<section class="wrap sec" id="euroclinic">
  <div class="sec-head">
    <h2>Клиника трансляционной медицины&nbsp;— продолжение клиники, существующей с&nbsp;<mark>2019 года</mark></h2>
  </div>

  <div class="ec-grid">
    <div class="ec-text">
      <p>
        Мы&nbsp;— новое узкоспециализированное направление
        ЕвроСитиКлиник&nbsp;— клиники современной онкологии
        в&nbsp;Санкт-Петербурге. Наша специализация&nbsp;— лекарственное лечение
        онкологических заболеваний: химиотерапия, таргетная
        и&nbsp;иммунотерапия в&nbsp;дневном стационаре.
      </p>
    </div>
    <div class="ec-text">
      <p>
        Мы&nbsp;опираемся на&nbsp;команду, опыт и&nbsp;отработанные методы
        лечения действующей клиники: штат сотрудников состоит
        из&nbsp;высококвалифицированного медицинского персонала. Приём
        и&nbsp;лечение пациентов осуществляется врачами более чем&nbsp;12
        специальностей по&nbsp;адресу ул.&nbsp;Профессора Попова,&nbsp;27.
      </p>
      <!-- Логотип материнской сети (фирменный SVG с eurocityclinic.ru) + ссылка — одной строкой -->
      <div class="ec-brand">
        <img
          src="/images/eurocityclinic-logo.svg"
          alt="ЕвроСитиКлиник"
          class="ec-logo"
          width="193"
          height="28"
          loading="lazy"
          decoding="async"
        />
        <a class="link-chip" href="https://eurocityclinic.ru/" target="_blank" rel="noopener">
          Сайт ЕвроСитиКлиник
          <svg class="chev-r" viewBox="0 0 24 24" aria-hidden="true" set:html={chev} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ec-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-24) var(--s-48);
    align-items: start;
  }
  .ec-text p {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    letter-spacing: var(--tr-body-lg);
    color: var(--text-body);
    max-width: 62ch;
    margin: 0 0 var(--s-16);
  }
  .ec-text p:last-of-type { margin-bottom: 0; }
  /* Логотип сети + ссылка на их сайт — одной строкой, по центру высоты */
  .ec-brand {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-16) var(--s-24);
    margin-top: var(--s-24);
  }
  /* Логотип — размер по высоте, ширина сама (пропорция 193×28) */
  .ec-logo { display: block; height: 28px; width: auto; }

  @media (max-width: 960px) {
    .ec-grid { grid-template-columns: 1fr; }
  }
</style>

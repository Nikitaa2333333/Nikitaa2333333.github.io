---
/* ============================================================
   Экран 2. «Как мы помогаем» — editorial-список из 6 шагов.
   Слева крупный контурный номер 01–06 (паттерн /s-chego-nachat),
   справа заголовок + текст + ссылка-стрелка.
   Контент — правки заказчика (docs/тексты-главной.md, июль 2026):
   шаг 05 стал «Начинаем лечение», клинические исследования вынесены
   отдельным пунктом 06 как дополнительная возможность.
   Заголовки шагов — несовершенный вид («Изучаем», «Уточняем»): так план
   читается как то, что клиника делает всегда, и совпадает с повтором
   плана в «Первом шаге» (FirstStep.astro).
   ============================================================ */
type Step = { n: string; t: string; p: string; link?: string; href?: string };
const steps: Step[] = [
  {
    n: '01',
    t: 'Изучаем ваши документы',
    p: 'Выписки, результаты биопсии, гистологические стёкла и&nbsp;блоки, рентгеновские снимки, УЗИ, КТ, МРТ&nbsp;— всё, что уже есть на&nbsp;руках. Наши специалисты подробно анализируют каждый документ: это работа врача, а&nbsp;не&nbsp;ваша задача.',
    link: 'С&nbsp;чего начать',
    href: '/s-chego-nachat',
  },
  {
    n: '02',
    t: 'Уточняем диагноз, если это необходимо',
    p: 'Если есть сомнения, пересматриваем гистологию в&nbsp;лаборатории экспертного уровня для уточнения диагноза. Иногда уточнение меняет тактику лечения, в&nbsp;том числе в&nbsp;сторону меньшего объёма.',
    link: 'Пересмотр стёкол и&nbsp;блоков',
    href: '/biopsiya#peresmotr',
  },
  {
    n: '03',
    t: 'Рассказываем всё о&nbsp;вашей опухоли',
    p: 'Проведём молекулярно-генетическое исследование вашей опухоли, если оно не&nbsp;проводилось. Определим конкретные генетические дефекты в&nbsp;клетках опухоли. Зная молекулярно-генетическую структуру опухоли, подберём эффективную схему лечения.',
    link: 'Молекулярно-генетические исследования',
    href: '/molekulyarnaya-diagnostika',
  },
  {
    n: '04',
    t: 'Объясняем все варианты лечения',
    p: 'Химиотерапия, таргетная и&nbsp;иммунотерапия&nbsp;— наши врачи подробно расскажут, какое лечение показано именно в&nbsp;вашей ситуации, чем варианты отличаются друг от&nbsp;друга и&nbsp;почему мы&nbsp;предлагаем именно эту схему.',
    link: 'Лечение',
    href: '/lechenie',
  },
  {
    n: '05',
    t: 'Начинаем лечение',
    p: 'В&nbsp;случае вашего согласия на&nbsp;выбранную тактику лечения начнём терапию без промедления.',
  },
  {
    n: '06',
    t: 'Бесплатное участие в&nbsp;клинических исследованиях',
    p: 'Участие в&nbsp;клинических исследованиях позволяет получить современное лечение некоторых видов онкозаболеваний значительно раньше, чем в&nbsp;широкой клинической практике.',
    link: 'Клинические исследования',
    href: '#',
  },
];
---

<section class="sec plan-sec" id="plan">
  <div class="wrap">
    <div class="plan-head">
      <h2>Как мы&nbsp;помогаем</h2>
      <p class="plan-intro">
        Онкологический диагноз выбивает почву из-под ног. Разобраться
        в&nbsp;диагнозе и&nbsp;лечении самостоятельно практически всегда
        затруднительно. Врачи Клиники помогают грамотно и&nbsp;уверенно
        разобраться с&nbsp;каждым этапом.
      </p>
    </div>

    <ol class="plan-list">
      {steps.map((s, i) => (
        <li class="plan-step reveal" style={`--d:${(i * 0.08).toFixed(2)}s`}>
          <span class="plan-num" aria-hidden="true">{s.n}</span>
          <div class="plan-body">
            <h3 set:html={s.t} />
            <p set:html={s.p} />
          </div>
          {s.link && (
            <a class="link-chip plan-link" href={s.href}>
              <span set:html={s.link} /><svg class="chev-r" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          )}
        </li>
      ))}
    </ol>

    <p class="plan-outro reveal" style="--d:.42s">
      Наши врачи в&nbsp;короткие сроки уточнят диагноз, выберут лекарственную
      терапию и&nbsp;предложат вам оптимальное лечение. Мы&nbsp;бережём ваше
      время и&nbsp;стараемся улучшить результаты лечения.
      <a href="#doctors">Наши врачи</a> шаг за&nbsp;шагом проходят путь
      к&nbsp;выздоровлению вместе с&nbsp;вами.
    </p>
  </div>
</section>

<style>
  .plan-sec { padding-block: var(--section-gap); }

  /* — Шапка секции (паттерн sec-head/kicker главной) — */
  .plan-head { margin-bottom: 16px; }
  .kicker { font-size: var(--fs-caption); letter-spacing: .06em; text-transform: none; color: var(--accent); margin: 0 0 12px; }
  .plan-head h2 { font-size: var(--fs-h-lg); letter-spacing: -.025em; font-weight: 600; margin: 0; max-width: var(--measure-head); }
  .plan-intro { margin: 16px 0 0; max-width: var(--measure-lead); font-size: var(--fs-body-lg); line-height: var(--lh-body-lg); letter-spacing: var(--tr-body-lg); color: var(--text-body); }

  /* — Editorial-список шагов — */
  .plan-list { list-style: none; margin: 0; padding: 0; }
  /* Три колонки: крупный номер | заголовок+текст | ссылка справа */
  .plan-step {
    display: grid;
    grid-template-columns: clamp(96px, 12vw, 170px) minmax(0, 1fr) auto;
    gap: 8px 32px;
    align-items: center;
    padding-block: 14px;
  }

  /* Крупный контурный номер 01–05 (паттерн /s-chego-nachat) */
  .plan-num {
    font-family: var(--ff-display);
    font-weight: 600;
    font-size: var(--fs-num-lg);
    line-height: 1;
    letter-spacing: -.03em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  @supports (-webkit-text-stroke: 1px black) {
    .plan-num { color: transparent; -webkit-text-stroke: 1.5px var(--accent); }
  }

  .plan-body h3 {
    font-size: var(--fs-h);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 10px;
    color: var(--text-strong);
  }
  .plan-body p { margin: 0; max-width: 62ch; color: var(--text-body); }

  /* Ссылка-чип (глобальный .link-chip) — своя колонка справа, по центру ряда */
  .plan-link { justify-self: end; white-space: nowrap; }

  .plan-outro {
    margin: 32px 0 0;
    max-width: var(--measure-text);
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    letter-spacing: var(--tr-body-lg);
    color: var(--text-body);
  }

  /* — Reveal-каскад (паттерн главной: .reveal + --d) — */
  .reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); transition-delay: var(--d, 0s); }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }

  @media (max-width: 720px) {
    .plan-step { grid-template-columns: 1fr; gap: 4px; }
    .plan-num { font-size: var(--fs-num); }
    .plan-link { justify-self: start; margin-top: 12px; }
  }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('.plan-sec .reveal').forEach((el) => io.observe(el));
</script>

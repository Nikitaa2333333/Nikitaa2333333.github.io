---
import Base from '../layouts/Base.astro';
import FooterContacts from '../components/sections/FooterContacts.astro';
import { clinic } from '../data/clinic';

/* ============================================================
   «С чего начать» — посадочная для рекламы (ТЗ, раздел 2).
   Сценарий страницы:
   1) hero с главным CTA «Отправить документы на оценку»;
   2) те же 5 шагов, что на главной, но развёрнутые;
   3) чек-лист документов + инструкция «как всё забрать» (право
      пациента, форма заявления, сроки);
   4) ветка «Если вы ищете помощь для близкого»;
   5) «Что взять на первый приём»;
   6) форма отправки документов (главный CTA) — id="upload".
   Контент — по ТЗ; конкретика клиники — видимыми заглушками [X].
   ============================================================ */

const icon: Record<string, string> = {
  arrow: '<path d="M5 12h14m-6-6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  upload: '<path d="M12 15V4m0 0l-4 4m4-4l4 4M5 17v2a1 1 0 001 1h12a1 1 0 001-1v-2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  doc: '<path d="M7 3h7l4 4v14H7V3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v4h4M10 12h5M10 16h5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
};

// — Экран 2. Пять шагов: тот же план, что на главной, но развёрнутый —
const steps = [
  {
    n: '01',
    t: 'Изучаем ваши документы',
    p: 'Выписки, результаты биопсии, снимки, стёкла и&nbsp;блоки&nbsp;— всё, что накопилось за&nbsp;время обследования. Это ваша история болезни, и&nbsp;забрать её из&nbsp;клиники, где вы&nbsp;обследовались,&nbsp;— ваше законное право. Дальше документы подробно анализируют наши специалисты. Ниже на&nbsp;этой странице&nbsp;— полный чек-лист и&nbsp;инструкция, как всё получить.',
    link: 'К&nbsp;чек-листу документов',
    href: '#checklist',
  },
  {
    n: '02',
    t: 'Уточняем диагноз, если это необходимо',
    p: 'Пересмотр гистологии вторым патоморфологом&nbsp;— обычная мировая практика, а&nbsp;не&nbsp;недоверие к&nbsp;коллегам. Диагноз при этом не&nbsp;отменяется&nbsp;— уточняется, и&nbsp;иногда уточнение меняет тактику лечения, в&nbsp;том числе в&nbsp;сторону меньшего объёма. Для пересмотра нужны оригиналы стёкол и&nbsp;блоков.',
    link: 'Пересмотр стёкол',
    href: '#',
  },
  {
    n: '03',
    t: 'Рассказываем всё о&nbsp;вашей опухоли',
    p: 'Основа&nbsp;— молекулярно-генетические исследования (NGS, ПЦР, FISH): они показывают, какая именно «поломка» в&nbsp;клетках привела к&nbsp;росту опухоли. От&nbsp;этого зависит, какой препарат подойдёт именно вам: современная терапия подбирается под конкретную мишень, а&nbsp;не&nbsp;«по&nbsp;среднему». Онкомаркеры&nbsp;— вспомогательный анализ: они могут отражать динамику процесса, но&nbsp;диагноз не&nbsp;устанавливают.',
    link: 'Молекулярно-генетические исследования',
    href: '/onkomarkery',
  },
  {
    n: '04',
    t: 'Объясняем все варианты лечения',
    p: 'Химиотерапия, таргетная и&nbsp;иммунотерапия&nbsp;— наши врачи разбирают, что показано в&nbsp;вашей ситуации, чем варианты отличаются и&nbsp;почему мы&nbsp;предлагаем именно эту схему. Хороший план лечения всегда можно объяснить понятными словами&nbsp;— и&nbsp;мы&nbsp;это делаем на&nbsp;каждой консультации.',
    link: 'Варианты лечения',
    href: '#',
  },
  {
    n: '05',
    t: 'Даём доступ к&nbsp;новым препаратам',
    p: 'Часть современных лекарств становится доступна раньше, чем появляется в&nbsp;продаже,&nbsp;— через клинические исследования, которые мы&nbsp;проводим по&nbsp;международным стандартам GCP. Участие бесплатное. Подходите&nbsp;ли вы&nbsp;под критерии конкретного протокола&nbsp;— мы&nbsp;скажем на&nbsp;консультации.',
    link: 'Клинические исследования',
    href: '#',
  },
];

// — Экран 3. Чек-лист: что забрать из клиники, где обследовались —
const checklist = [
  { t: 'Выписные эпикризы и&nbsp;заключения', d: 'Из&nbsp;всех клиник, где вы&nbsp;наблюдались и&nbsp;лечились.' },
  { t: 'Гистологическое заключение', d: 'Результат биопсии или операции&nbsp;— основной документ диагноза.' },
  { t: 'Снимки КТ, МРТ, ПЭТ-КТ', d: 'Именно диски или файлы исследований, а&nbsp;не&nbsp;только их описания.' },
  { t: 'Стёкла и&nbsp;блоки', d: 'Оригиналы из&nbsp;лаборатории, где делали биопсию,&nbsp;— без них пересмотр гистологии невозможен.' },
  { t: 'Свежие анализы крови', d: 'Если сдавали в&nbsp;последний месяц&nbsp;— возьмите результаты с&nbsp;собой.' },
  { t: 'Список принимаемых препаратов', d: 'С&nbsp;дозировками, включая витамины и&nbsp;БАДы.' },
];

// — Как всё забрать: право пациента → заявление → сроки —
const howto = [
  {
    t: 'Напишите заявление',
    d: 'Получить копии медицинских документов, а&nbsp;также стёкла и&nbsp;блоки&nbsp;— ваше законное право (ст.&nbsp;22 ФЗ-323 «Об&nbsp;основах охраны здоровья граждан»). Заявление пишется в&nbsp;свободной форме на&nbsp;имя главного врача клиники, где вы&nbsp;обследовались. Мы&nbsp;дадим шаблон и&nbsp;поможем с&nbsp;формулировками.',
  },
  {
    t: 'Дождитесь выдачи',
    d: 'По&nbsp;закону на&nbsp;подготовку копий отводится до&nbsp;30&nbsp;календарных дней, но&nbsp;на&nbsp;практике стёкла и&nbsp;блоки чаще выдают за&nbsp;несколько дней. Уточните срок сразу при подаче заявления&nbsp;— и&nbsp;попросите отметку о&nbsp;его приёме.',
  },
  {
    t: 'Ничего не&nbsp;потеряется',
    d: 'Стёкла и&nbsp;блоки выдаются под подпись, а&nbsp;после пересмотра мы&nbsp;возвращаем их вам&nbsp;— они остаются вашими. Если документы отказываются выдавать&nbsp;— позвоните нам, подскажем, как действовать.',
  },
];

// — Экран 4. Ветка «Если вы ищете помощь для близкого» —
const relative = [
  {
    t: 'Как говорить с&nbsp;близким',
    d: 'Диагноз отнимает ощущение контроля, поэтому важно не&nbsp;решать за&nbsp;человека всё сразу. Предлагайте помощь в&nbsp;конкретном: собрать документы, записаться, поехать вместе. На&nbsp;приёме вы&nbsp;можете присутствовать&nbsp;— так спокойнее вам обоим, а&nbsp;врачу&nbsp;— полнее картина.',
  },
  {
    t: 'Документы можно передать за&nbsp;него',
    d: 'Загрузите копии выписок и&nbsp;снимков через форму ниже&nbsp;— врач изучит их и&nbsp;скажет, чем мы&nbsp;можем помочь и&nbsp;с&nbsp;чего начать. Для решений на&nbsp;очном приёме и&nbsp;получения документов от&nbsp;имени близкого понадобится его согласие или доверенность&nbsp;— подскажем, как её оформить.',
  },
  {
    t: 'Первый визит можно организовать целиком',
    d: 'Запишите близкого на&nbsp;удобное время и&nbsp;приезжайте вместе: сопровождающий может остаться и&nbsp;на&nbsp;приёме, и&nbsp;в&nbsp;дневном стационаре. Если ехать тяжело&nbsp;— начните с&nbsp;телемедицинской консультации по&nbsp;загруженным документам.',
  },
];

// — Экран 5. Что взять на первый приём (ответ из FAQ главной) —
const firstVisit = [
  'Паспорт',
  'Все выписки и&nbsp;заключения',
  'Результаты анализов',
  'Снимки и&nbsp;диски исследований',
  'Стёкла и&nbsp;блоки',
  'Список принимаемых препаратов',
];
---

<Base title="С чего начать — Клиника трансляционной медицины">
  <!-- ШАПКА (паттерн index; общие стили пока дублируются per-page) -->
  <header class="site-head" id="site-head">
    <div class="topbar">
      <div class="wrap topbar-in">
        <button class="a11y-link" aria-label="Версия для слабовидящих">
          <svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          Версия для слабовидящих
        </button>
        <div class="topbar-info">
          <span class="ti"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="10" r="2.4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><b>ул. Петропавловская, 4</b></span>
          <a href={clinic.phoneHref} class="ti"><svg viewBox="0 0 24 24"><path d="M4 5c0 8 7 15 15 15l2.5-3.2-4.5-2-2 2c-2.5-1.2-5.1-3.8-6.3-6.3l2-2-2-4.5L4 5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><b>{clinic.phone}</b></a>
          <span class="ti ti-hours">Пн–Пт 09:00–20:00 · Сб 09:00–18:00 · Вс выходной</span>
        </div>
      </div>
    </div>
    <div class="wrap head-inner">
      <a href="/" class="brand">
        <img src="/images/logo-mark.svg" alt="Клиника трансляционной медицины" class="brand-mark" />
        <span class="brand-name">Клиника<br/><b>трансляционной медицины</b></span>
      </a>
      <nav class="nav">
        <div class="nav-item"><a href="/s-chego-nachat" class="nav-link is-current" aria-current="page">С чего начать</a></div>
        <div class="nav-item">
          <a href="#" class="nav-link">Диагностика <svg viewBox="0 0 24 24" class="chev"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <div class="drop">
            <a href="/molekulyarnaya-diagnostika" class="drop-it"><b>Молекулярно-генетические исследования</b><span>NGS · ПЦР · FISH — основа выбора лекарственной тактики</span></a>
            <a href="/biopsiya" class="drop-it"><b>Биопсия и гистология</b><span>Пересмотр стёкол — «не отменяем, уточняем»</span></a>
            <a href="/onkomarkery" class="drop-it"><b>Онкомаркеры</b><span>Вспомогательный анализ: динамика, не диагноз</span></a>
            <a href="#" class="drop-it"><b>Анализ крови</b></a>
            <a href="#" class="drop-it"><b>Ультразвуковая диагностика</b></a>
            <a href="#" class="drop-it"><b>Другие анализы</b></a>
          </div>
        </div>
        <div class="nav-item">
          <a href="#" class="nav-link">Лечение <svg viewBox="0 0 24 24" class="chev"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <div class="drop drop-wide">
            <a href="/lechenie" class="drop-it"><b>Выбор вида лечения</b><span>Задачи лекарственной терапии</span></a>
            <a href="/lechenie/himioterapiya" class="drop-it"><b>Химиотерапия</b><span>Эффективные схемы лечения</span></a>
            <a href="/lechenie/targetnaya-terapiya" class="drop-it"><b>Таргетная терапия</b><span>Точечное воздействие на мишени</span></a>
            <a href="/lechenie/immunoterapiya" class="drop-it"><b>Иммунотерапия</b><span>Активация собственного иммунитета</span></a>
            <a href="/lechenie/vosstanovlenie" class="drop-it"><b>Восстановление после лечения</b><span>Сопроводительная и симптоматическая терапия, восстановительное питание</span></a>
            <a href="/lechenie/klinicheskie-issledovaniya" class="drop-it"><b>Клинические исследования</b><span>Реестр активных протоколов, GCP</span></a>
          </div>
        </div>
        <div class="nav-item"><a href="/vrachi" class="nav-link">Врачи</a></div>
        <div class="nav-item"><a href="/stoimost" class="nav-link">Цены</a></div>
        <div class="nav-item"><a href="/blog" class="nav-link">Блог</a></div>
        <div class="nav-item">
          <a href="#" class="nav-link">О клинике <svg viewBox="0 0 24 24" class="chev"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <div class="drop">
            <a href="/#stationar" class="drop-it"><b>Дневной стационар</b><span>Условия лечения</span></a>
            <a href="/litsenzii" class="drop-it"><b>Лицензии и сертификаты</b><span>Документы клиники</span></a>
            <a href="/#stories" class="drop-it"><b>Истории пациентов</b><span>Вместе достигаем невозможного</span></a>
          </div>
        </div>
        <div class="nav-item"><a href="#contacts" class="nav-link">Контакты</a></div>
      </nav>
      <div class="head-actions">
        <button class="a11y" title="Версия для слабовидящих" aria-label="Версия для слабовидящих">Аа</button>
        <a href="#contacts" class="btn btn-dark"><svg viewBox="0 0 24 24" class="ic-s"><path d="M4 5c0 8 7 15 15 15l2.5-3.2-4.5-2-2 2c-2.5-1.2-5.1-3.8-6.3-6.3l2-2-2-4.5L4 5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>Записаться на приём</a>
      </div>
    </div>
  </header>

  <!-- HERO страницы -->
  <section class="page-hero">
    <div class="blob" style="width:480px;height:480px;background:var(--c-wash-teal);top:-160px;left:-60px;"></div>
    <div class="blob" style="width:420px;height:420px;background:var(--c-wash-blue);top:-80px;right:-40px;"></div>
    <div class="wrap" style="position:relative;z-index:1;">
      <h1 class="page-title">С&nbsp;чего <em class="i-serif">начать</em></h1>
      <p class="page-sub">Вы&nbsp;или ваш близкий столкнулись с&nbsp;диагнозом, и&nbsp;непонятно, за&nbsp;что браться первым делом. Здесь&nbsp;— спокойный план: какие документы собрать, как их забрать из&nbsp;другой клиники и&nbsp;как устроена первая консультация. <mark>Начать можно прямо сейчас</mark>&nbsp;— отправьте документы, и&nbsp;наши врачи изучат их до&nbsp;визита.</p>
      <div class="hero-cta">
        <a href="#upload" class="btn btn-dark"><svg viewBox="0 0 24 24" class="ic-s" set:html={icon.upload}></svg>Отправить документы врачу</a>
        <a href="#checklist" class="btn btn-light">Чек-лист документов</a>
      </div>
    </div>
  </section>

  <!-- ПЯТЬ ШАГОВ — развёрнутый план (editorial-список, как на главной) -->
  <section class="sec plan-sec" id="plan">
    <div class="wrap">
      <div class="sec-head">
        <h2>Пять шагов&nbsp;— тот&nbsp;же план, что на&nbsp;главной, но&nbsp;подробнее</h2>
        <p class="sec-lead">Документы&nbsp;→ проверка диагноза&nbsp;→ исследование опухоли&nbsp;→ варианты лечения&nbsp;→ новые препараты. Каждый шаг возвращает ощущение контроля.</p>
      </div>
      <ol class="plan-list">
        {steps.map((s, i) => (
          <li class="plan-step reveal" style={`--d:${(i * 0.08).toFixed(2)}s`}>
            <span class="plan-num" aria-hidden="true">{s.n}</span>
            <div class="plan-body">
              <h3 set:html={s.t} />
              <p set:html={s.p} />
            </div>
            <a class="link-chip plan-link" href={s.href}>
              <span set:html={s.link} /><svg class="chev-r" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ЧЕК-ЛИСТ ДОКУМЕНТОВ + КАК ВСЁ ЗАБРАТЬ -->
  <section class="sec check-sec" id="checklist">
    <div class="wrap">
      <div class="sec-head">
        <h2>Чек-лист: какие документы собрать</h2>
        <p class="sec-lead">Всё, что накопилось за&nbsp;время обследования,&nbsp;— ваша собственность и&nbsp;ваше право. Чем полнее комплект, тем подробнее мы&nbsp;разберём вашу ситуацию уже на&nbsp;первой консультации.</p>
      </div>
      <div class="check-grid">
        <ul class="check-list glass">
          {checklist.map((c, i) => (
            <li class="check-item reveal" style={`--d:${(i * 0.06).toFixed(2)}s`}>
              <span class="check-ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icon.check}></svg></span>
              <div>
                <b set:html={c.t} />
                <p set:html={c.d} />
              </div>
            </li>
          ))}
        </ul>
        <aside class="howto">
          <h3>Как забрать документы, стёкла и&nbsp;блоки</h3>
          <ol class="howto-list">
            {howto.map((h, i) => (
              <li class="howto-step reveal" style={`--d:${(i * 0.08).toFixed(2)}s`}>
                <span class="howto-num" aria-hidden="true">{i + 1}</span>
                <div>
                  <b set:html={h.t} />
                  <p set:html={h.d} />
                </div>
              </li>
            ))}
          </ol>
          <a href="#" class="link-chip link-chip--accent howto-dl">
            <svg viewBox="0 0 24 24" class="howto-dl-ic" aria-hidden="true" set:html={icon.doc}></svg>
            Шаблон заявления на&nbsp;выдачу документов
            <svg viewBox="0 0 24 24" class="chev-r" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <p class="howto-note">Форму заявления и&nbsp;точный порядок выдачи в&nbsp;конкретной клинике [уточняется у&nbsp;клиники]&nbsp;— поможем разобраться по&nbsp;телефону.</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- ВЕТКА: ЕСЛИ ВЫ ИЩЕТЕ ПОМОЩЬ ДЛЯ БЛИЗКОГО -->
  <section class="sec rel-sec" id="blizkim">
    <div class="wrap">
      <div class="rel-tile" style="--ang:160deg">
        <div class="rel-head">
          <h2>Если вы&nbsp;ищете помощь для близкого</h2>
          <p class="rel-lead">Вы&nbsp;решаете за&nbsp;маму, папу или супруга&nbsp;— и&nbsp;это нормально: большинство первых обращений к&nbsp;нам делают именно родные. Вот что важно знать.</p>
        </div>
        <div class="rel-grid">
          {relative.map((r, i) => (
            <article class="rel-card reveal" style={`--d:${(i * 0.08).toFixed(2)}s`}>
              <h3 set:html={r.t} />
              <p set:html={r.d} />
            </article>
          ))}
        </div>
        <div class="rel-cta">
          <a href="#upload" class="btn btn-dark"><svg viewBox="0 0 24 24" class="ic-s" set:html={icon.upload}></svg>Отправить документы близкого</a>
          <p class="rel-note">Врач посмотрит документы и&nbsp;скажет, с&nbsp;чего начать,&nbsp;— ещё до&nbsp;того, как вы&nbsp;привезёте близкого на&nbsp;приём.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ЧТО ВЗЯТЬ НА ПЕРВЫЙ ПРИЁМ -->
  <section class="sec visit-sec" id="first-visit">
    <div class="wrap">
      <div class="sec-head">
        <h2>Что взять на&nbsp;первый приём</h2>
      </div>
      <ul class="visit-list">
        {firstVisit.map((v, i) => (
          <li class="visit-chip reveal" style={`--d:${(i * 0.05).toFixed(2)}s`}>
            <span class="check-ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icon.check}></svg></span>
            <span set:html={v} />
          </li>
        ))}
      </ul>
      <p class="visit-note">Если чего-то нет&nbsp;— приходите с&nbsp;тем, что есть: разберёмся вместе и&nbsp;подскажем, как получить недостающее.</p>
    </div>
  </section>

  <!-- ГЛАВНЫЙ CTA: ОТПРАВИТЬ ДОКУМЕНТЫ НА ОЦЕНКУ -->
  <section class="sec upload-sec" id="upload">
    <div class="blob" style="width:440px;height:440px;background:var(--c-wash-teal);top:-60px;left:8%;"></div>
    <div class="blob" style="width:400px;height:400px;background:var(--c-wash-blue);bottom:-90px;right:10%;"></div>
    <div class="wrap upload-inner">
      <div class="glass upload">
        <div class="upload-head">
          <h2>Отправьте документы нашим врачам</h2>
          <p class="upload-sub">Приложите выписки, заключения и&nbsp;снимки&nbsp;— врач-онколог внимательно изучит их до&nbsp;визита, <mark>подробно разберёт вашу ситуацию</mark> и&nbsp;скажет, с&nbsp;чего начать именно в&nbsp;вашем случае. Ответим в&nbsp;течение [X]&nbsp;рабочих дней.</p>
          <p class="upload-sub upload-note">Отправить документы можно и&nbsp;за&nbsp;близкого. По&nbsp;закону первичный диагноз дистанционно не&nbsp;устанавливается&nbsp;— для этого нужен очный приём.</p>
        </div>
        <form class="upload-form" onsubmit="return false">
          <input class="fi" type="text" placeholder="Ваше имя" />
          <input class="fi" type="tel" placeholder="Телефон" />
          <textarea class="fi" rows="3" placeholder="Коротко о ситуации (необязательно)"></textarea>
          <label class="fi fi-file">
            <input type="file" multiple />
            <svg viewBox="0 0 24 24" class="ic-s" set:html={icon.upload}></svg>
            <span>Прикрепить файлы&nbsp;— PDF, снимки, фото выписок</span>
          </label>
          <label class="consent">
            <input type="checkbox" />
            <span>Согласен(на) на&nbsp;обработку персональных данных. Данные хранятся на&nbsp;серверах в&nbsp;РФ (ФЗ-152).</span>
          </label>
          <button class="btn btn-dark" type="submit">Отправить документы врачу</button>
        </form>
      </div>
    </div>
  </section>

  <!-- КОНТАКТЫ + ПОДВАЛ -->
  <FooterContacts />

  <style is:global>
    /* — кнопки/шапка: паттерн index (общие стили пока дублируются per-page) — */
    .ic-s { width:16px; height:16px; }

    .site-head { position:sticky; top:0; z-index:50; overflow-anchor:none; background:var(--head-fill); border-bottom:1px solid var(--border-hairline); }
    .head-inner { display:flex; align-items:center; justify-content:space-between; height:74px; gap:24px; }
    .brand { display:flex; align-items:center; gap:12px; }
    .brand-mark { height:44px; width:auto; flex:none; }
    .brand-name { font-size:var(--fs-caption); line-height:1.25; color:var(--text-body); letter-spacing:.01em; }
    .brand-name b { color:var(--text-strong); font-weight:600; }
    .nav { display:flex; gap:6px; }
    .nav-item { position:relative; }
    .nav-link { display:inline-flex; align-items:center; gap:5px; font-size:var(--fs-body-sm); color:var(--text-body); padding:10px 12px; border-radius:var(--r-pill); transition:.2s; }
    .nav-link:hover { color:var(--text-strong); background:var(--veil); }
    .nav-link.is-current { color:var(--accent-soft); font-weight:600; }
    .chev { width:14px; height:14px; opacity:.55; transition:transform .25s; }
    .nav-item:hover .chev, .nav-item:focus-within .chev { transform:rotate(180deg); }
    .drop { position:absolute; top:calc(100% + 10px); left:0; min-width:290px; padding:10px;
      background:var(--surface-elevated);
      border:1px solid var(--border-hairline); border-radius:var(--r-glass); box-shadow:var(--sh-glass);
      display:grid; gap:2px; opacity:0; visibility:hidden; transform:translateY(10px);
      transition:opacity .22s ease, transform .22s ease, visibility .22s; z-index:60; }
    .drop::before { content:""; position:absolute; top:-12px; left:0; right:0; height:14px; }
    .drop-wide { min-width:340px; }
    .nav-item:hover .drop, .nav-item:focus-within .drop { opacity:1; visibility:visible; transform:translateY(0); }
    .drop-it { display:grid; gap:2px; padding:11px 14px; border-radius:var(--r-input); transition:.18s; }
    .drop-it b { font-size:var(--fs-body-sm); font-weight:600; color:var(--text-strong); }
    .drop-it span { font-size:var(--fs-caption); color:var(--text-muted); line-height:1.35; }
    .drop-it:hover { background:var(--c-wash-teal); }
    .drop-it:hover b { color:var(--c-teal-deep); }
    .head-actions { display:flex; align-items:center; gap:14px; }
    .a11y { width:40px; height:40px; border-radius:var(--r-pill); border:1px solid var(--border-strong); background:var(--veil); color:var(--text-body); font-size:var(--fs-body-sm); cursor:pointer; }
    .a11y.is-on { background:var(--cta-fill); color:var(--cta-text); border-color:transparent; }

    /* — hero страницы (паттерн page-hero из /stati) — */
    .page-hero { position:relative; overflow:hidden; background:var(--grad-uni); padding-block:52px 46px; }
    .page-sub { font-size:var(--fs-sub); line-height:1.55; color:var(--text-body); max-width:var(--measure-lead); margin:0 0 30px; }
    .hero-cta { display:flex; gap:14px; flex-wrap:wrap; }

    /* — секции — */
    .sec { padding-block:var(--section-gap); }
    .sec-head { margin-bottom:var(--head-gap); }
    .sec-head h2 { font-size:var(--fs-h-lg); letter-spacing:-.025em; font-weight:600; margin:0; }
    .sec-lead { margin:16px 0 0; max-width:var(--measure-lead); font-size:var(--fs-body-lg); line-height:var(--lh-body-lg); letter-spacing:var(--tr-body-lg); color:var(--text-body); }

    /* — план 01–05 (editorial-паттерн PlanSteps главной) — */
    .plan-list { list-style:none; margin:0; padding:0; }
    .plan-step { display:grid; grid-template-columns:clamp(96px,12vw,170px) minmax(0,1fr) auto; gap:8px 32px; align-items:center; padding-block:14px; }
    .plan-step:last-child { border-bottom:0; }
    .plan-num { font-family:var(--ff-display); font-weight:600; font-size:var(--fs-num-lg); line-height:1; letter-spacing:-.03em; color:var(--accent); font-variant-numeric:tabular-nums; }
    @supports (-webkit-text-stroke: 1px black) {
      .plan-num { color:transparent; -webkit-text-stroke:1.5px var(--accent); }
    }
    .plan-body h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; line-height:1.15; margin:0 0 10px; color:var(--text-strong); }
    .plan-body p { margin:0; max-width:62ch; color:var(--text-body); }
    .plan-link { justify-self:end; white-space:nowrap; }

    /* — чек-лист + «как забрать» — */
    .check-grid { display:grid; grid-template-columns:1.15fr 1fr; gap:24px; align-items:start; }
    .check-list { list-style:none; margin:0; padding:12px 28px; display:grid; }
    .check-item { display:flex; gap:16px; align-items:flex-start; padding-block:11px; }
    .check-item:last-child { border-bottom:0; }
    .check-ic { flex:none; display:inline-flex; color:var(--accent-soft); } /* иконка без плашки-контейнера */
    .check-ic svg { width:20px; height:20px; }
    .check-item b { display:block; font-size:var(--fs-body); font-weight:600; color:var(--text-strong); margin-bottom:3px; }
    .check-item p { font-size:var(--fs-body-sm); line-height:1.5; color:var(--text-body); margin:0; }

    .howto { background:var(--surface-card); border:1px solid var(--border-hairline); border-radius:var(--r-card); padding:28px; }
    .howto h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; margin:0 0 20px; }
    .howto-list { list-style:none; margin:0 0 22px; padding:0; display:grid; gap:18px; }
    .howto-step { display:flex; gap:14px; align-items:flex-start; }
    .howto-num { flex:none; width:30px; height:30px; border-radius:var(--r-pill); border:1px solid var(--border-strong); color:var(--accent-soft); font-weight:600; font-size:var(--fs-body-sm); display:inline-flex; align-items:center; justify-content:center; }
    .howto-step b { display:block; font-size:var(--fs-body-sm); font-weight:600; color:var(--text-strong); margin-bottom:4px; }
    .howto-step p { font-size:var(--fs-caption); line-height:1.5; color:var(--text-body); margin:0; }
    .howto-dl-ic { width:16px; height:16px; flex:none; } /* иконка документа слева */
    .howto-note { font-size:var(--fs-caption); line-height:1.5; color:var(--text-muted); margin:14px 0 0; } /* служебная пометка-заглушка */

    /* — ветка «помощь для близкого»: единый градиент, угол per-плашка — */
    .rel-tile { border-radius:var(--r-card); padding:44px 48px; background:linear-gradient(var(--ang,150deg), var(--g-uni-a), var(--g-uni-b) 55%, var(--g-uni-c)); }
    .rel-head { margin-bottom:32px; }
    .rel-head h2 { font-size:var(--fs-h-lg); letter-spacing:-.025em; font-weight:600; margin:0; max-width:var(--measure-head); }
    .rel-lead { margin:14px 0 0; max-width:var(--measure-lead); font-size:var(--fs-body-lg); line-height:var(--lh-body-lg); color:var(--text-body); }
    .rel-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin-bottom:28px; }
    .rel-card { background:var(--surface-card); border-radius:var(--r-glass); padding:24px; }
    .rel-card h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; line-height:1.2; margin:0 0 12px; }
    .rel-card p { font-size:var(--fs-body-sm); line-height:1.55; color:var(--text-body); margin:0; }
    .rel-cta { display:flex; align-items:center; gap:20px; flex-wrap:wrap; }
    .rel-note { font-size:var(--fs-body-sm); line-height:1.5; color:var(--text-body); margin:0; max-width:34em; }

    /* — что взять на первый приём — */
    .visit-list { list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:12px; }
    .visit-chip { display:inline-flex; align-items:center; gap:10px; font-size:var(--fs-body-sm); font-weight:500; color:var(--text-strong); border:1px solid var(--border-strong); border-radius:var(--r-pill); padding:11px 20px; }
    .visit-note { margin:24px 0 0; max-width:var(--measure-text); font-size:var(--fs-body-lg); line-height:var(--lh-body-lg); color:var(--text-body); }

    /* — форма отправки документов (стекло на блобах, паттерн tele) — */
    .upload-sec { position:relative; overflow:hidden; }
    .upload-inner { position:relative; z-index:1; }
    .upload { display:grid; grid-template-columns:1fr 1fr; gap:44px; padding:48px; }
    .upload-head h2 { font-size:var(--fs-h-lg); letter-spacing:-.025em; font-weight:600; margin:0 0 14px; }
    .upload-sub { font-size:var(--fs-body); line-height:1.55; color:var(--text-body); margin:0 0 18px; max-width:30em; }
    .upload-note { margin-bottom:0; }
    .upload-form { display:grid; gap:14px; align-content:center; }
    .fi { font-family:var(--ff-body); font-size:var(--fs-body-sm); color:var(--text-strong); background:var(--veil-strong); border:1px solid var(--border-hairline); border-radius:var(--r-input); padding:13px 16px; outline:none; transition:border-color .2s; resize:vertical; }
    .fi:focus, .fi:focus-within { border-color:var(--accent); }
    .fi::placeholder { color:var(--text-muted); } /* плейсхолдер — разрешённое исключение */
    .fi-file { display:flex; align-items:center; gap:10px; cursor:pointer; color:var(--accent-soft); font-weight:500; }
    .fi-file input { display:none; }
    .fi-file .ic-s { flex:none; }
    .consent { display:flex; gap:10px; align-items:flex-start; font-size:var(--fs-caption); color:var(--text-muted); line-height:1.45; }
    .consent input { margin-top:2px; accent-color:var(--accent); }
    .upload-form .btn { justify-content:center; }

    /* — reveal (паттерн главной) — */
    .reveal { opacity:0; transform:translateY(18px); transition:opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); transition-delay:var(--d,0s); }
    .reveal.in { opacity:1; transform:none; }
    @media (prefers-reduced-motion:reduce) { .reveal { opacity:1; transform:none; transition:none; } }

    /* — адаптив — */
    @media (max-width:960px) {
      .nav { display:none; }
      .check-grid { grid-template-columns:1fr; }
      .rel-grid { grid-template-columns:1fr; }
      .rel-tile { padding:32px 24px; }
      .upload { grid-template-columns:1fr; }
    }
    @media (max-width:720px) {
      .plan-step { grid-template-columns:1fr; gap:4px; }
      .plan-num { font-size:var(--fs-num); }
      .plan-link { justify-self:start; margin-top:12px; }
    }
  </style>

  <script>
    // появление блоков при скролле (паттерн главной)
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // показать имена выбранных файлов в поле «Прикрепить файлы»
    const fileInput = document.querySelector<HTMLInputElement>('.fi-file input');
    fileInput?.addEventListener('change', () => {
      const label = fileInput.closest('.fi-file')?.querySelector('span');
      if (!label) return;
      const n = fileInput.files?.length ?? 0;
      label.textContent = n
        ? [...fileInput.files!].map((f) => f.name).join(', ')
        : 'Прикрепить файлы — PDF, снимки, фото выписок';
    });
  </script>
</Base>

---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import FooterContacts from '../components/sections/FooterContacts.astro';
import PageCta from '../components/sections/PageCta.astro';
import { clinic } from '../data/clinic';

/* ============================================================
   «Онкомаркеры» — страница хаба «Диагностика» (ТЗ, раздел 3).
   Крупнейшая опорная тема по спросу (255 точных/мес). Сценарий:
   1) hero + главная мысль «повышенный маркер — не диагноз»;
   2) что это такое простыми словами;
   3) для чего онкомаркеры нужны — и для чего НЕ нужны (карточки);
   4) таблица распространённых маркеров (справочный блок);
   5) развёрнутый блок «повышенный маркер — не диагноз»;
   6) как правильно сдать — подготовка (чек-лист);
   7) «динамика важнее одного числа»;
   8) что дальше — связка с биопсией и МГИ (внутренние ссылки);
   9) FAQ-аккордеон;
   10) CTA + нормативная плашка ФЗ-38.
   Контент справочный, без выдумывания данных клиники; конкретика —
   видимыми заглушками [X]. Всё на токенах, без хардкодов, без капса/italic.
   ============================================================ */

const icon: Record<string, string> = {
  check: '<path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
};

// — Экран 3. Для чего онкомаркеры действительно нужны —
const useFor = [
  {
    t: 'Контроль эффективности лечения',
    d: 'Если маркер был повышен до&nbsp;лечения, его снижение в&nbsp;динамике&nbsp;— один из&nbsp;признаков, что терапия работает. Это главное, для чего онкомаркеры полезны.',
  },
  {
    t: 'Наблюдение после лечения',
    d: 'Регулярные измерения помогают вовремя заметить возможный возврат болезни&nbsp;— иногда раньше, чем появятся симптомы или изменения на&nbsp;снимках.',
  },
  {
    t: 'Помощь в&nbsp;уточнении картины',
    d: 'В&nbsp;сочетании с&nbsp;осмотром, снимками и&nbsp;биопсией отдельные маркеры помогают врачу сузить круг и&nbsp;спланировать обследование. Сами по&nbsp;себе они диагноз не&nbsp;ставят.',
  },
];

// — Экран 3b. Чего онкомаркеры НЕ делают (частое заблуждение) —
const useNot = [
  'Не&nbsp;заменяют скрининг у&nbsp;здоровых людей&nbsp;— повышенный маркер бывает и&nbsp;без опухоли, а&nbsp;нормальный&nbsp;— не&nbsp;гарантирует её отсутствия.',
  'Не&nbsp;ставят диагноз в&nbsp;одиночку&nbsp;— окончательный диагноз даёт только гистология (биопсия).',
  'Не&nbsp;определяют, где именно находится опухоль&nbsp;— большинство маркеров не&nbsp;привязаны строго к&nbsp;одному органу.',
];

// — Экран 4. Справочная таблица распространённых маркеров —
// abbr — латинская аббревиатура (как в бланке), org — на что чаще смотрят,
// note — короткий честный комментарий. Это ориентир, а не руководство к
// самодиагностике: трактует результат только врач.
const markers = [
  { abbr: 'ПСА (PSA)',       org: 'Предстательная железа',                 note: 'Растёт и&nbsp;при аденоме, простатите, после нагрузки&nbsp;— не&nbsp;только при раке.' },
  { abbr: 'РЭА (CEA)',       org: 'Кишечник, лёгкие, молочная железа',     note: 'Часто повышен у&nbsp;курильщиков и&nbsp;при воспалениях ЖКТ.' },
  { abbr: 'АФП (AFP)',       org: 'Печень, яички',                         note: 'Повышается при гепатитах и&nbsp;циррозе; важен в&nbsp;динамике.' },
  { abbr: 'СА&nbsp;125 (CA&nbsp;125)', org: 'Яичники',                     note: 'Реагирует на&nbsp;эндометриоз, кисты, менструацию, воспаление.' },
  { abbr: 'СА&nbsp;15-3 (CA&nbsp;15-3)', org: 'Молочная железа',           note: 'Используется для наблюдения, а&nbsp;не&nbsp;для первичного поиска.' },
  { abbr: 'СА&nbsp;19-9 (CA&nbsp;19-9)', org: 'Поджелудочная железа, ЖКТ', note: 'У&nbsp;части людей не&nbsp;вырабатывается вовсе&nbsp;— норма ничего не&nbsp;исключает.' },
  { abbr: 'ХГЧ (hCG)',       org: 'Яички, плацента',                       note: 'Повышен при беременности&nbsp;— это физиология, а&nbsp;не&nbsp;патология.' },
  { abbr: 'SCC',             org: 'Плоскоклеточный рак (шейка матки, кожа)', note: 'Может расти при кожных болезнях и&nbsp;почечной недостаточности.' },
  { abbr: 'HE4',             org: 'Яичники',                               note: 'Часто оценивают вместе с&nbsp;СА&nbsp;125 (индекс ROMA).' },
  { abbr: 'CA&nbsp;72-4',    org: 'Желудок, яичники',                      note: 'Вспомогательный маркер, редко используется в&nbsp;одиночку.' },
];

// — Экран 5. Почему повышенный маркер — ещё не диагноз —
const whyHigh = [
  { t: 'Воспаление и&nbsp;инфекции', d: 'Обычная простуда, воспаление печени или кишечника, цистит могут временно поднять цифры.' },
  { t: 'Доброкачественные состояния', d: 'Аденома простаты, кисты яичников, эндометриоз, миома, полипы&nbsp;— всё это влияет на&nbsp;маркеры.' },
  { t: 'Образ жизни и&nbsp;физиология', d: 'Курение, беременность, менструация, недавняя нагрузка или процедура сдвигают результат.' },
  { t: 'Особенности лаборатории', d: 'Разные тест-системы дают разные нормы&nbsp;— поэтому динамику отслеживают в&nbsp;одной лаборатории.' },
];

// — Экран 6. Как правильно сдать — подготовка —
const prep = [
  { t: 'Сдавайте утром натощак', d: 'Оптимально&nbsp;— через 8–12&nbsp;часов после еды, до&nbsp;этого можно пить воду.' },
  { t: 'За&nbsp;сутки&nbsp;— без нагрузок и&nbsp;алкоголя', d: 'Интенсивные тренировки, баня и&nbsp;спиртное искажают ряд показателей.' },
  { t: 'Учтите процедуры и&nbsp;цикл', d: 'ПСА сдают до&nbsp;осмотра простаты и&nbsp;спустя время после него; СА&nbsp;125&nbsp;— с&nbsp;учётом дня цикла.' },
  { t: 'Предупредите о&nbsp;лекарствах', d: 'Некоторые препараты и&nbsp;БАДы влияют на&nbsp;результат&nbsp;— скажите об&nbsp;этом врачу заранее.' },
  { t: 'Повторяйте в&nbsp;той&nbsp;же лаборатории', d: 'Чтобы динамику можно было сравнивать корректно, используйте одну тест-систему.' },
];

// — Экран 8. Что дальше: связка с другими исследованиями —
const next = [
  {
    t: 'Биопсия и&nbsp;гистология',
    d: 'Единственный способ поставить окончательный диагноз&nbsp;— исследовать саму ткань опухоли под микроскопом. Отсюда&nbsp;же&nbsp;— пересмотр стёкол.',
    href: '#',
  },
  {
    t: 'Молекулярно-генетические исследования',
    d: 'Когда диагноз установлен, тесты NGS, ПЦР и&nbsp;FISH показывают, какая «поломка» движет опухолью и&nbsp;какой препарат подойдёт именно вам.',
    href: '/molekulyarnaya-diagnostika',
  },
];

// — Экран 9. FAQ (нативные details/summary, без JS) —
const faq = [
  {
    q: 'Можно ли&nbsp;по&nbsp;онкомаркерам провериться «на&nbsp;всякий случай»?',
    a: 'Как скрининг для здоровых людей онкомаркеры не&nbsp;подходят: они дают много ложных тревог и&nbsp;пропусков. Профилактические программы строятся на&nbsp;других методах&nbsp;— осмотрах и&nbsp;визуализации. Онкомаркеры имеют смысл, когда их назначает врач под конкретную задачу.',
  },
  {
    q: 'У&nbsp;меня повышен маркер&nbsp;— это рак?',
    a: 'Не&nbsp;обязательно. Повышение бывает при воспалении, доброкачественных состояниях, из-за курения или физиологии. Один результат ничего не&nbsp;доказывает&nbsp;— нужен разбор с&nbsp;врачом, иногда повтор анализа и&nbsp;дообследование.',
  },
  {
    q: 'Маркеры в&nbsp;норме&nbsp;— значит, всё точно хорошо?',
    a: 'Нормальные значения успокаивают, но&nbsp;не&nbsp;гарантируют отсутствия болезни: часть опухолей маркеры не&nbsp;вырабатывает. Поэтому на&nbsp;них не&nbsp;опираются как на&nbsp;единственный критерий.',
  },
  {
    q: 'Почему в&nbsp;двух лабораториях разные цифры?',
    a: 'Лаборатории используют разные тест-системы и&nbsp;единицы, поэтому и&nbsp;референсные значения отличаются. Чтобы динамику можно было сравнивать, сдавайте маркер в&nbsp;одной и&nbsp;той&nbsp;же лаборатории.',
  },
  {
    q: 'Как часто нужно пересдавать?',
    a: 'Периодичность определяет врач исходя из&nbsp;вашей ситуации: во&nbsp;время лечения и&nbsp;наблюдения после него&nbsp;— по&nbsp;расписанию, вне этих задач регулярные измерения обычно не&nbsp;нужны.',
  },
  {
    q: 'Нужно ли&nbsp;как-то готовиться к&nbsp;сдаче?',
    a: 'Да: сдавать утром натощак, за&nbsp;сутки избегать нагрузок и&nbsp;алкоголя, учитывать процедуры и&nbsp;день цикла, предупредить врача о&nbsp;принимаемых лекарствах. Подробности&nbsp;— в&nbsp;блоке «Как правильно сдать» выше.',
  },
];
---

<Base title="Онкомаркеры: что показывают, как сдать — Клиника трансляционной медицины">
  <!-- ШАПКА (паттерн index; общие стили пока дублируются per-page) -->
  <Header current="onkomarkery" />

  <!-- HERO страницы -->
  <section class="page-hero">
    <div class="blob" style="width:480px;height:480px;background:var(--c-wash-teal);top:-160px;left:-60px;"></div>
    <div class="blob" style="width:420px;height:420px;background:var(--c-wash-blue);top:-80px;right:-40px;"></div>
    <div class="wrap" style="position:relative;z-index:1;">
      <div class="page-eyebrow">Диагностика</div>
      <h1 class="page-title">Онко<em class="i-serif">маркеры</em></h1>
      <p class="page-sub">Онкомаркеры&nbsp;— это вещества в&nbsp;крови, уровень которых может меняться при опухоли. Они могут отражать динамику процесса, но&nbsp;диагноз не&nbsp;устанавливают и&nbsp;не&nbsp;конкретизируют его: анализ вспомогательный. Основа современной диагностики&nbsp;— <a href="/molekulyarnaya-diagnostika">молекулярно-генетические исследования</a>, именно они определяют выбор препарата.</p>
      <div class="hero-cta">
        <a href="#contacts" class="btn btn-dark">Записаться на&nbsp;консультацию</a>
        <a href="#table" class="btn btn-light">Таблица маркеров</a>
      </div>
    </div>
  </section>

  <!-- ЧТО ЭТО ТАКОЕ -->
  <section class="sec" id="what">
    <div class="wrap">
      <div class="sec-head">
        <h2>Что такое онкомаркеры простыми словами</h2>
      </div>
      <!-- Ровно ДВЕ равные колонки: широкого лида над ними нет (правило меры строки) -->
      <div class="lead-grid">
        <div class="lead-col">
          <p class="lead-para">Клетки опухоли (а&nbsp;иногда и&nbsp;здоровые ткани в&nbsp;ответ на&nbsp;неё) выделяют в&nbsp;кровь особые белки и&nbsp;другие вещества. Их&nbsp;концентрацию можно измерить обычным анализом крови&nbsp;— это и&nbsp;есть онкомаркеры.</p>
          <p class="lead-para">Важно сразу расставить акценты. Онкомаркер&nbsp;— это не&nbsp;выключатель «рак есть / рака нет». Одно и&nbsp;то&nbsp;же вещество может вырабатываться и&nbsp;при опухоли, и&nbsp;при совершенно доброкачественных состояниях&nbsp;— воспалении, кисте, даже после простуды или физической нагрузки.</p>
        </div>
        <div class="lead-col">
          <p class="lead-para">Поэтому по-настоящему онкомаркеры раскрываются не&nbsp;в&nbsp;роли «теста на&nbsp;рак», а&nbsp;как вспомогательный инструмент наблюдения: когда диагноз уже известен, по&nbsp;ним удобно следить за&nbsp;динамикой.</p>
          <p class="lead-para">Что именно происходит в&nbsp;опухоли и&nbsp;какой препарат подойдёт, показывают <a href="/molekulyarnaya-diagnostika">молекулярно-генетические исследования</a>&nbsp;— это основа, с&nbsp;которой мы&nbsp;работаем. Трактовать результаты должен врач&nbsp;— вместе с&nbsp;осмотром, снимками и&nbsp;биопсией.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ДЛЯ ЧЕГО НУЖНЫ / НЕ НУЖНЫ -->
  <section class="sec" id="use">
    <div class="wrap">
      <div class="sec-head">
        <h2>Для чего онкомаркеры действительно нужны</h2>
        <p class="sec-lead">Ниже&nbsp;— задачи, где онкомаркеры приносят реальную пользу. И&nbsp;отдельно&nbsp;— частые ожидания, которые они не&nbsp;оправдывают.</p>
      </div>
      <div class="use-grid">
        {useFor.map((u, i) => (
          <article class="use-card reveal" style={`--d:${(i * 0.08).toFixed(2)}s`}>
            <h3 set:html={u.t} />
            <p set:html={u.d} />
          </article>
        ))}
      </div>

      <div class="not-block">
        <h3 class="not-title">Чего онкомаркеры не&nbsp;делают</h3>
        <ul class="not-list">
          {useNot.map((n) => (
            <li set:html={n} />
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ТАБЛИЦА МАРКЕРОВ -->
  <section class="sec" id="table">
    <div class="wrap">
      <div class="sec-head">
        <h2>Распространённые онкомаркеры</h2>
        <p class="sec-lead">Справочный ориентир, а&nbsp;не&nbsp;руководство к&nbsp;самодиагностике. У&nbsp;каждого маркера&nbsp;— свои особенности, и&nbsp;значение конкретной цифры оценивает только врач.</p>
      </div>
      <div class="table-wrap">
        <table class="mk-table">
          <thead>
            <tr>
              <th>Маркер</th>
              <th>На&nbsp;что чаще смотрят</th>
              <th>Что важно знать</th>
            </tr>
          </thead>
          <tbody>
            {markers.map((m) => (
              <tr class="reveal">
                <td class="mk-abbr" set:html={m.abbr} />
                <td set:html={m.org} />
                <td class="mk-note" set:html={m.note} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">Список неполный: маркеров существует больше, и&nbsp;набор для конкретной ситуации подбирает лечащий врач. Нормы зависят от&nbsp;лаборатории&nbsp;— ориентируйтесь на&nbsp;референсные значения из&nbsp;вашего бланка.</p>
    </div>
  </section>

  <!-- ПОВЫШЕННЫЙ МАРКЕР — НЕ ДИАГНОЗ -->
  <section class="sec" id="not-diagnosis">
    <div class="wrap">
      <div class="sec-head">
        <h2>Повышенный маркер&nbsp;— ещё не&nbsp;диагноз</h2>
        <p class="sec-lead">Это, пожалуй, главное, что стоит запомнить. Увидев цифру выше нормы, легко испугаться&nbsp;— но&nbsp;причин для повышения множество, и&nbsp;далеко не&nbsp;все они опасны.</p>
      </div>
      <div class="why-grid">
        {whyHigh.map((w, i) => (
          <article class="why-card reveal" style={`--d:${(i * 0.06).toFixed(2)}s`}>
            <h3 set:html={w.t} />
            <p set:html={w.d} />
          </article>
        ))}
      </div>
      <div class="callout">
        <h3>Что делать, если маркер повышен</h3>
        <p>Не&nbsp;паниковать и&nbsp;не&nbsp;назначать себе лечение по&nbsp;одному анализу. Разумный порядок&nbsp;— показать результат врачу, при необходимости пересдать в&nbsp;той&nbsp;же лаборатории и&nbsp;оценить показатель <mark>в&nbsp;динамике</mark>, а&nbsp;не&nbsp;по&nbsp;единственной точке.</p>
      </div>
    </div>
  </section>

  <!-- КАК ПРАВИЛЬНО СДАТЬ -->
  <section class="sec" id="prep">
    <div class="wrap">
      <div class="sec-head">
        <h2>Как правильно сдать анализ</h2>
        <p class="sec-lead">Подготовка влияет на&nbsp;результат сильнее, чем кажется. Несколько простых правил помогут получить цифры, которым можно доверять.</p>
      </div>
      <ul class="prep-list">
        {prep.map((p, i) => (
          <li class="prep-item reveal" style={`--d:${(i * 0.06).toFixed(2)}s`}>
            <span class="prep-ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icon.check}></svg></span>
            <div class="prep-body">
              <h3 set:html={p.t} />
              <p set:html={p.d} />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ДИНАМИКА ВАЖНЕЕ ОДНОГО ЧИСЛА -->
  <section class="sec" id="dynamics">
    <div class="wrap">
      <div class="dyn-block">
        <h2>Динамика важнее одного числа</h2>
        <p class="dyn-lead">Одно измерение почти ничего не&nbsp;говорит&nbsp;— важна тенденция. Врача интересует не&nbsp;столько сама цифра, сколько то, как она меняется от&nbsp;анализа к&nbsp;анализу.</p>
        <div class="dyn-grid">
          <div class="dyn-card">
            <h3>Снижается</h3>
            <p>Во&nbsp;время лечения падение уровня&nbsp;— один из&nbsp;признаков, что терапия работает.</p>
          </div>
          <div class="dyn-card">
            <h3>Держится ровно</h3>
            <p>Стабильные значения после лечения&nbsp;— повод продолжать плановое наблюдение спокойно.</p>
          </div>
          <div class="dyn-card">
            <h3>Растёт</h3>
            <p>Устойчивый рост&nbsp;— сигнал внимательнее обследоваться, но&nbsp;тоже сам по&nbsp;себе не&nbsp;диагноз.</p>
          </div>
        </div>
        <p class="dyn-note">Именно поэтому маркеры сдают в&nbsp;одной лаборатории и&nbsp;по&nbsp;расписанию, которое назначает врач,&nbsp;— чтобы сравнение было честным.</p>
      </div>
    </div>
  </section>

  <!-- ЧТО ДАЛЬШЕ -->
  <section class="sec" id="next">
    <div class="wrap">
      <div class="sec-head">
        <h2>Что дальше</h2>
        <p class="sec-lead">Онкомаркеры&nbsp;— только один инструмент. Если врачу нужно установить или уточнить диагноз, за&nbsp;ними следуют более точные исследования.</p>
      </div>
      <div class="next-grid">
        {next.map((n, i) => (
          <a class="next-card reveal" href={n.href} style={`--d:${(i * 0.08).toFixed(2)}s`}>
            <h3 set:html={n.t} />
            <p set:html={n.d} />
            <span class="next-link">Подробнее<svg class="chev-r" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ — паттерн главной (Faq.astro): статичный список, две колонки,
       по левому краю. Аккордеонов на сайте нет нигде. -->
  <section class="wrap sec faq-sec" id="faq">
    <div class="sec-head">
      <h2>Частые вопросы</h2>
    </div>
    <div class="faq">
      {faq.map((item) => (
        <div class="faq-item">
          <h3 class="faq-q" set:html={item.q} />
          <div class="faq-a">
            <p set:html={item.a} />
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA + НОРМАТИВНАЯ ПЛАШКА -->
  <PageCta
    title="Не&nbsp;знаете, как читать свои анализы?"
    text="Принесите результаты онкомаркеров и&nbsp;других обследований&nbsp;— врач-онколог разберёт их вместе с&nbsp;вами, объяснит, что значат цифры именно в&nbsp;вашей ситуации, и&nbsp;подскажет, нужно&nbsp;ли что-то ещё."
  />


  <!-- КОНТАКТЫ + ПОДВАЛ -->
  <FooterContacts />

  <style is:global>
    /* — кнопки/шапка: паттерн index (общие стили пока дублируются per-page) — */
    .ic-s { width:16px; height:16px; }

    /* Стили шапки — в Header.astro (дубль удалён) */

    /* — hero страницы (паттерн page-hero) — */
    .page-hero { position:relative; overflow:hidden; background:var(--grad-uni); padding-block:52px 46px; }
    .page-eyebrow { font-size:var(--fs-caption); font-weight:600; letter-spacing:.02em; color:var(--accent); margin:0 0 14px; }
    .page-sub { font-size:var(--fs-sub); line-height:1.55; color:var(--text-body); max-width:var(--measure-lead); margin:0 0 30px; }
    .hero-cta { display:flex; gap:14px; flex-wrap:wrap; }

    /* — секции: мера строки токенами (заголовок в 2 строки, а не одна длинная) — */
    .sec { padding-block:var(--section-gap); }
    .sec-head { margin-bottom:var(--head-gap); }
    .sec-head h2 { font-size:var(--fs-h-lg); letter-spacing:-.025em; font-weight:600; margin:0; max-width:var(--measure-head); }
    .sec-lead { margin:16px 0 0; max-width:var(--measure-lead); font-size:var(--fs-body-lg); line-height:var(--lh-body-lg); letter-spacing:var(--tr-body-lg); color:var(--text-body); }

    /* — «что это такое»: ДВЕ РАВНЫЕ колонки, широкого лида над ними нет — */
    .lead-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:36px; }
    .lead-col { display:grid; gap:16px; align-content:start; }
    .lead-para { margin:0; font-size:var(--fs-body-lg); line-height:1.65; color:var(--text-body); }

    /* — для чего нужны: карточки; иконка БЕЗ плашки-контейнера — */
    .use-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin-bottom:24px; }
    .use-card { background:var(--surface-card); border:1px solid var(--border-hairline); border-radius:var(--r-card); padding:28px; }
    .use-card h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; line-height:1.2; margin:0 0 10px; color:var(--text-strong); }
    .use-card p { margin:0; font-size:var(--fs-body-sm); line-height:1.55; color:var(--text-body); }

    /* — чего НЕ делают: плашка СУЖЕНА и отцентрована как блок (текст внутри — слева);
         во всю ширину контента такую полосу не растягиваем. Иконка без плашки. — */
    .not-block { margin-top:var(--s-32); } /* без плашки — обычный текст на холсте */
    .not-title { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; margin:0 0 20px; }
    /* Ни буллитов, ни разделительных линий: пункты держит вертикальный ритм */
    .not-list { list-style:none; margin:0; padding:0; display:grid; gap:12px; }
    .not-list li { max-width:var(--measure-text); font-size:var(--fs-body); line-height:1.55; color:var(--text-body); }

    /* — таблица маркеров — */
    .table-wrap { overflow-x:auto; border:1px solid var(--border-hairline); border-radius:var(--r-card); background:var(--surface-card); }
    .mk-table { width:100%; border-collapse:collapse; min-width:640px; }
    .mk-table thead th { text-align:left; font-family:var(--ff-body); font-size:var(--fs-caption); font-weight:600; letter-spacing:.01em; color:var(--text-muted); padding:18px 24px; border-bottom:1px solid var(--border-strong); background:var(--surface-mist); }
    .mk-table tbody td { padding:18px 24px; font-size:var(--fs-body-sm); line-height:1.5; color:var(--text-body); border-bottom:1px solid var(--border-hairline); vertical-align:top; }
    .mk-table tbody tr:last-child td { border-bottom:0; }
    .mk-table tbody tr:hover td { background:var(--c-wash-teal); }
    .mk-abbr { font-weight:600; color:var(--text-strong); white-space:nowrap; }
    .mk-note { color:var(--text-body); }
    .table-note { margin:18px 0 0; max-width:var(--measure-text); font-size:var(--fs-caption); line-height:1.55; color:var(--text-muted); }

    /* — почему повышен: карточки-сетка (мера текста внутри карточки — узкая) — */
    .why-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; margin-bottom:28px; }
    .why-card { background:var(--surface-card); border:1px solid var(--border-hairline); border-radius:var(--r-card); padding:26px 28px; }
    .why-card h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; line-height:1.2; margin:0 0 10px; color:var(--text-strong); }
    .why-card p { margin:0; font-size:var(--fs-body-sm); line-height:1.55; color:var(--text-body); }
    /* Плашка с одним абзацем — сужена и отцентрована как блок, текст слева */
    .callout { margin-top:var(--s-32); }
    .callout h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; margin:0 0 10px; color:var(--text-strong); }
    .callout p { margin:0; max-width:var(--measure-text); font-size:var(--fs-body); line-height:1.6; color:var(--text-body); }

    /* — подготовка: ЧЕК-ЛИСТ в белой плашке (паттерн чек-листа /s-chego-nachat):
         галочка + заголовок пункта + пояснение. Без номеров, буллитов и линий. — */
    .prep-list { list-style:none; margin:0; padding:0; display:grid; gap:14px; } /* без плашки — прямо на холсте */
    .prep-item { display:flex; gap:16px; align-items:flex-start; }
    .prep-ic { flex:none; display:inline-flex; color:var(--accent-soft); }
    .prep-ic svg { width:20px; height:20px; }
    .prep-body h3 { font-size:var(--fs-body-lg); font-weight:600; letter-spacing:-.02em; line-height:1.2; color:var(--text-strong); margin:0 0 4px; }
    .prep-body p { margin:0; max-width:var(--measure-text); font-size:var(--fs-body-sm); line-height:1.55; color:var(--text-body); }

    /* — динамика: плашка с внутренней сеткой (ширина --tile-mid) — */
    .dyn-block h2 { font-size:var(--fs-h-lg); letter-spacing:-.025em; font-weight:600; margin:0; max-width:var(--measure-head); }
    .dyn-lead { margin:16px 0 var(--s-32); max-width:var(--measure-lead); font-size:var(--fs-body-lg); line-height:var(--lh-body-lg); color:var(--text-body); }
    /* Три пункта — белые плашки в ряд (одинаковые, hairline, без цвета) */
    .dyn-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; }
    .dyn-card { background:var(--surface-card); border:1px solid var(--border-hairline); border-radius:var(--r-card); padding:24px 26px; }
    .dyn-card h3 { font-size:var(--fs-body-lg); font-weight:600; letter-spacing:-.02em; color:var(--text-strong); margin:0 0 10px; }
    .dyn-card p { margin:0; font-size:var(--fs-body-sm); line-height:1.55; color:var(--text-body); }
    .dyn-note { margin:var(--s-24) 0 0; max-width:var(--measure-text); font-size:var(--fs-body-sm); line-height:1.55; color:var(--text-body); }

    /* — что дальше: ссылки-карточки — */
    .next-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; }
    .next-card { display:block; background:var(--surface-card); border:1px solid var(--border-hairline); border-radius:var(--r-card); padding:30px 32px; }
    .next-card:hover .next-link { color:var(--accent); }
    .next-card h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; line-height:1.2; margin:0 0 12px; color:var(--text-strong); }
    .next-card p { margin:0 0 18px; font-size:var(--fs-body-sm); line-height:1.55; color:var(--text-body); }
    .next-link { display:inline-flex; align-items:center; gap:4px; font-size:var(--fs-body-sm); font-weight:600; color:var(--accent-soft); }
    .next-link .chev-r { width:16px; height:16px; }

    /* — FAQ: 1:1 паттерн Faq.astro — статичный список, две колонки, левый край,
         разделитель сверху у всех кроме первого ряда. Аккордеона нет. — */
    .faq { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:clamp(32px,5vw,72px); }
    .faq-item { padding:14px 0; }
    .faq-q { font-size:var(--fs-h); font-weight:600; line-height:1.3; letter-spacing:-.01em; color:var(--text-strong); margin:0 0 10px; }
    .faq-a p { font-size:var(--fs-body-sm); line-height:1.6; color:var(--text-body); margin:0; }

    /* — CTA + нормативная плашка — */
    /* Нормативная плашка — единственное разрешённое центрирование текста; сужена */
    /* — reveal (паттерн главной) — */
    .reveal { opacity:0; transform:translateY(18px); transition:opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); transition-delay:var(--d,0s); }
    .reveal.in { opacity:1; transform:none; }
    @media (prefers-reduced-motion:reduce) { .reveal { opacity:1; transform:none; transition:none; } }

    /* — адаптив — */
    @media (max-width:960px) {
      .nav { display:none; }
      .lead-grid { grid-template-columns:1fr; gap:16px; }
      .sec-head h2, .dyn-block h2 { max-width:none; }
      .faq { grid-template-columns:1fr; }
      .use-grid { grid-template-columns:1fr; }
      .why-grid { grid-template-columns:1fr; }
      .dyn-grid { grid-template-columns:1fr; }
      .next-grid { grid-template-columns:1fr; }
    }

  </style>

  <script>
    // появление блоков при скролле (паттерн главной)
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</Base>

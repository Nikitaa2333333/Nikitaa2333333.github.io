---
/* Экран 3 «Кому мы помогаем» — три кликабельные карточки в ряд.
   Белые карточки (surface-card + hairline), вёрстка во всех трёх идентичная:
   заголовок сверху, текст с одной линии, стрелка в правом верхнем углу.

   РЕШЕНИЕ ПОЛЬЗОВАТЕЛЯ, июль 2026: заголовки второй и третьей карточек —
   обращение к читателю («Ищите помощь для близкого», «Лечитесь, но есть
   сомнения»), а НЕ речь от первого лица, как в документе («Я ищу…»,
   «Я уже лечусь…»). При сверке с документом эти два заголовка не трогать. */
const arrow =
  '<path d="M5 12h14m-6-6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>';

const cards = [
  {
    href: '/biopsiya#peresmotr', // «Диагностика → Биопсия и гистология», блок «Пересмотр стёкол»
    t: 'Вы&nbsp;узнали диагноз&nbsp;— рак',
    d: 'Диагноз подтверждён, но&nbsp;вам хочется убедиться, что он&nbsp;верный. Врачи Клиники проверят полученные результаты исследований, детально расскажут вам о&nbsp;диагнозе и, если нужно, рекомендуют дополнительные исследования для уточнения.',
  },
  {
    href: '/s-chego-nachat#blizkim', // «С чего начать», ветка «Если вы ищете помощь для близкого»
    t: 'Ищите помощь для близкого',
    d: 'Вы&nbsp;решаете за&nbsp;маму, папу или супруга и&nbsp;не&nbsp;знаете, куда идти и&nbsp;что спрашивать. Мы&nbsp;подскажем, с&nbsp;чего начать, какие исследования пройти, какое лечение возможно, куда обратиться за&nbsp;помощью.',
  },
  {
    href: '/biopsiya#peresmotr', // «Диагностика → Биопсия и гистология», блок «Пересмотр стёкол»
    t: 'Лечитесь, но&nbsp;есть сомнения',
    d: 'Диагноз установлен, лечение назначено, но&nbsp;назначения вызывают вопросы. Лечение проводится, но&nbsp;кажется, что оно неэффективно. Наши врачи проанализируют выбранную тактику с&nbsp;учётом данных обследования и&nbsp;динамики заболевания и&nbsp;обоснуют необходимые изменения в&nbsp;лечении, если потребуется.',
  },
];
---

<section class="wrap sec who-sec">
  <div class="who-head">
    <h2>Обратитесь к&nbsp;нам, если:</h2>
  </div>

  <div class="who-grid">
    {cards.map((c) => (
      <a href={c.href} class="who-card">
        <span class="who-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" set:html={arrow} />
        </span>
        <span class="who-body">
          <h3 set:html={c.t} />
          <p set:html={c.d} />
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .sec.who-sec { padding-block: var(--section-gap); }

  .who-head { margin-bottom: var(--head-gap); }
  .kicker {
    font-size: var(--fs-caption);
    letter-spacing: 0.06em;
    text-transform: none;
    color: var(--accent);
    margin: 0 0 var(--s-12);
  }
  .who-head h2 {
    font-size: var(--fs-h-lg);
    letter-spacing: -0.025em;
    font-weight: 600;
    margin: 0;
  }
  .who-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  /* Белая карточка (surface-card + hairline — как плашки «Как мы лечим»).
     Вёрстка ЖЁСТКАЯ и одинаковая во всех трёх: заголовок с самого верха
     (резерв под 2 строки), наборный текст стартует с одной линии; стрелка —
     в правом верхнем углу, из потока вынута. */
  .who-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: var(--s-24);
    border-radius: var(--r-card);
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    color: var(--text-strong);
  }

  /* Стрелка-аффорданс — голая иконка (плашек под иконками нет), hover только красит */
  .who-arrow {
    position: absolute;
    top: var(--s-24);
    right: var(--s-24);
    display: block;
    color: var(--accent-soft);
  }
  .who-arrow svg { width: 20px; height: 20px; transform: rotate(-45deg); }
  .who-card:hover .who-arrow { color: var(--accent); }

  /* Отступ заголовок → текст ФИКСИРОВАННЫЙ (--s-16), в каждой карточке свой
     поток: заголовок сверху, после него текст — не зависит от соседних. */
  .who-body h3 {
    font-size: var(--fs-h);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 var(--s-16);
    padding-right: var(--s-40); /* только заголовок обходит стрелку в углу */
    color: inherit;
  }
  /* наборный текст — на всю ширину карточки, меру задаёт сама карточка */
  .who-body p {
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    margin: 0;
    color: inherit;
  }

  /* Карточки текстовые — двухколоночный шаг пропускаем, сразу в одну колонку */
  @media (max-width: 960px) {
    .who-grid { grid-template-columns: 1fr; }
    .who-card { min-height: 0; }
  }
</style>

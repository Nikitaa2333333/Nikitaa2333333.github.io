---
import Base from '../layouts/Base.astro';

const arrow = '<path d="M5 12h14m-6-6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>';

const articles = [
  { tag: 'Диагностика', t: 'Молекулярно-генетическое тестирование: когда и зачем', ex: 'NGS, ПЦР и FISH помогают подобрать таргетную терапию под конкретную опухоль. Разбираем, кому показаны тесты и как читать результат.', date: '24 июня 2026', g1: 'var(--c-wash-teal)', g2: 'var(--c-wash-blue)', href: '/molekulyarnaya-diagnostika' },
  { tag: 'Лечение', t: 'Иммунотерапия в дневном стационаре: что важно знать', ex: 'Как работают ингибиторы контрольных точек, чего ждать от курса и как проходит наблюдение.', date: '18 июня 2026', g1: 'var(--c-wash-powder)', g2: 'var(--c-wash-teal)' },
  { tag: 'Пациентам', t: 'Как подготовиться к первому визиту', ex: 'Список документов, анализы, вопросы врачу и что взять с собой на первую инфузию.', date: '11 июня 2026', g1: 'var(--c-wash-aqua)', g2: 'var(--c-wash-powder)' },
  { tag: 'Сопроводительная терапия', t: 'Питание и образ жизни во время лечения', ex: 'Практические памятки, которые помогают легче переносить курс и сохранять силы.', date: '2 июня 2026', g1: 'var(--c-wash-blue)', g2: 'var(--c-wash-teal)' },
];

const trials = [
  { drug: 'KTM-114 (анти-PD-1)', proto: 'Протокол KTM-114-III', noso: 'НМРЛ, стадия IIIB–IV', phase: 'Фаза III', status: 'Идёт набор',
    incl: 'Возраст 18+, гистологически подтверждённый немелкоклеточный рак лёгкого, ECOG 0–1, без предшествующей иммунотерапии.',
    excl: 'Активные аутоиммунные заболевания, другая злокачественная опухоль за последние 3 года.' },
  { drug: 'KTM-207 (таргетный ингибитор)', proto: 'Протокол KTM-207-II', noso: 'Колоректальный рак, mCRC', phase: 'Фаза II', status: 'Идёт набор',
    incl: 'Возраст 18+, подтверждённая мутация-мишень по результатам NGS, ≥1 линия предшествующей терапии.',
    excl: 'Тяжёлая печёночная недостаточность, беременность.' },
  { drug: 'KTM-330 (конъюгат)', proto: 'Протокол KTM-330-I', noso: 'Рак молочной железы, HER2-low', phase: 'Фаза I', status: 'Скоро набор',
    incl: 'Возраст 18+, HER2-low по ИГХ/FISH, прогрессирование на стандартной терапии.',
    excl: 'Клинически значимая сердечная недостаточность.' },
];
---

<Base title="Статьи и клинические исследования — КТМ">
  <!-- ШАПКА -->
  <header class="site-head" id="site-head">
    <div class="topbar">
      <div class="wrap topbar-in">
        <button class="a11y-link" aria-label="Версия для слабовидящих">
          <svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          Версия для слабовидящих
        </button>
        <div class="topbar-info">
          <span class="ti"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="10" r="2.4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><b>ул. Петропавловская, 4</b></span>
          <a href="tel:+78120000000" class="ti"><svg viewBox="0 0 24 24"><path d="M4 5c0 8 7 15 15 15l2.5-3.2-4.5-2-2 2c-2.5-1.2-5.1-3.8-6.3-6.3l2-2-2-4.5L4 5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><b>+7 (812) 000-00-00</b></a>
          <span class="ti ti-hours">Пн–Пт 09:00–20:00 · Сб 09:00–18:00 · Вс выходной</span>
        </div>
      </div>
    </div>
    <div class="wrap head-inner">
      <a href="/" class="brand">
        <img src="/images/logo-mark.svg" alt="Клиника трансляционной медицины" class="brand-mark" />
        <span class="brand-name">Клиника<br/><b>трансляционной медицины</b></span>
      </a>
      <nav class="nav">
        <a href="/#stationar">О клинике</a><a href="/vrachi">Врачи</a><a href="/#services">Услуги</a>
        <a href="/stoimost">Стоимость</a><a href="/#tele">Телемедицина</a><a href="/stati" class="is-current">Статьи</a>
      </nav>
      <div class="head-actions">
        <button class="a11y" aria-label="Версия для слабовидящих">Аа</button>
        <a href="/#" class="btn btn-dark"><svg viewBox="0 0 24 24" class="ic-s"><path d="M4 5c0 8 7 15 15 15l2.5-3.2-4.5-2-2 2c-2.5-1.2-5.1-3.8-6.3-6.3l2-2-2-4.5L4 5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>Записаться на приём</a>
      </div>
    </div>
  </header>

  <!-- HERO страницы -->
  <section class="page-hero">
    <div class="blob" style="width:480px;height:480px;background:var(--c-wash-teal);top:-160px;left:-60px;"></div>
    <div class="blob" style="width:420px;height:420px;background:var(--c-wash-powder);top:-80px;right:-40px;"></div>
    <div class="wrap" style="position:relative;z-index:1;">
      <p class="kicker">Экспертный центр</p>
      <h1 class="page-title">Статьи и <em class="i-serif">исследования</em></h1>
      <p class="page-sub">Материалы врачей клиники и открытый реестр клинических исследований, которые мы проводим по стандартам GCP.</p>

      <div class="tabs">
        <button class="tab is-active" data-tab="articles">Экспертные статьи</button>
        <button class="tab" data-tab="trials">Клинические исследования</button>
      </div>
    </div>
  </section>

  <!-- ВКЛАДКА: СТАТЬИ -->
  <section class="wrap sec panel" id="panel-articles">
    <div class="art-grid">
      {articles.map((a) => (
        <a href={a.href ?? '#'} class="glass art">
          <div class="art-thumb" style={`background:linear-gradient(150deg,${a.g1},${a.g2})`}><span class="art-tag">{a.tag}</span></div>
          <div class="art-body">
            <h3>{a.t}</h3>
            <p class="art-ex">{a.ex}</p>
            <p class="art-date">{a.date}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ВКЛАДКА: КЛИНИЧЕСКИЕ ИССЛЕДОВАНИЯ -->
  <section class="wrap sec panel is-hidden" id="panel-trials">
    <div class="glass trials-intro">
      <h2>Как мы проводим клинические исследования</h2>
      <p>Все исследования одобрены независимым этическим комитетом и проводятся по международным стандартам надлежащей клинической практики (GCP). Участие добровольное и бесплатное, с полным информированием о возможных рисках и правах пациента.</p>
    </div>

    <div class="trial-grid">
      {trials.map((t) => (
        <article class="glass trial">
          <div class="trial-top">
            <span class={`trial-status ${t.status === 'Идёт набор' ? 'open' : 'soon'}`}>{t.status}</span>
            <span class="trial-phase">{t.phase}</span>
          </div>
          <h3 class="trial-drug">{t.drug}</h3>
          <p class="trial-proto">{t.proto}</p>
          <dl class="trial-meta">
            <div><dt>Нозология</dt><dd>{t.noso}</dd></div>
            <div><dt>Критерии включения</dt><dd>{t.incl}</dd></div>
            <div><dt>Критерии исключения</dt><dd>{t.excl}</dd></div>
          </dl>
          <a href="#" class="trial-link">Связаться с координатором <svg viewBox="0 0 24 24" class="ic-s" set:html={arrow}></svg></a>
        </article>
      ))}
    </div>
    <p class="compliance-note">Имеются противопоказания. Необходима консультация специалиста.</p>
  </section>

  <!-- ПОДВАЛ -->
  <footer class="wrap foot">
    <div class="foot-grid">
      <div><p class="foot-h">Сведения о клинике</p><p>Лицензия № Л041-01148-78/05617603 от 20.07.2026<br/>Режим работы: пн–пт 9:00–20:00, сб 9:00–18:00<br/><a href="/litsenzii">Реквизиты и сведения по приказу 956н</a></p></div>
      <div><p class="foot-h">Пациентам</p><p>Права пациента<br/>Подготовка к визиту<br/>Согласие на обработку ПДн</p></div>
      <div><p class="foot-h">Данные под защитой</p><p>Серверы на территории РФ<br/>Соответствие ФЗ-152<br/>Версия для слабовидящих</p></div>
    </div>
  </footer>

  <style is:global>
    /* .wrap — глобальное правило (поля ≈15%) в global.css */
    .ic-s { width:16px; height:16px; }
    .kicker { font-size:var(--fs-caption); letter-spacing:.06em; text-transform:none; color:var(--accent); margin:0 0 12px; }
    .sec { padding-block:36px 48px; }
    .compliance-note { text-align:center; font-size:var(--fs-caption); color:var(--text-muted); border:1px solid var(--border-hairline); border-radius:var(--r-input); padding:14px; background:var(--surface-card); margin-top:32px; }

    /* шапка */
    .site-head { position:sticky; top:0; z-index:50; background:var(--head-fill); border-bottom:1px solid var(--border-hairline); }
    .head-inner { display:flex; align-items:center; justify-content:space-between; height:74px; gap:24px; }
    .brand { display:flex; align-items:center; gap:12px; }
    .brand-mark { height:44px; width:auto; flex:none; }
    .brand-name { font-size:var(--fs-caption); line-height:1.25; color:var(--text-body); }
    .brand-name b { color:var(--text-strong); font-weight:600; }
    .nav { display:flex; gap:26px; }
    .nav a { font-size:var(--fs-body-sm); color:var(--text-body); }
    .nav a.is-current { color:var(--accent); }
    .head-actions { display:flex; align-items:center; gap:14px; }
    .a11y { width:40px; height:40px; border-radius:var(--r-pill); border:1px solid var(--border-strong); background:var(--veil); color:var(--text-body); font-size:var(--fs-body-sm); cursor:pointer; }

    /* hero страницы + вкладки */
    .page-hero { position:relative; overflow:hidden; background:var(--grad-uni); padding-block:44px 22px; }
    .page-title { font-size:var(--fs-hero); line-height:1.02; letter-spacing:-.035em; font-weight:600; color:var(--text-strong); margin:0 0 18px; }
    .page-sub { font-size:var(--fs-sub); line-height:1.55; color:var(--text-body); max-width:var(--measure-lead); margin:0 0 34px; }
    .tabs { display:inline-flex; gap:6px; padding:6px; background:var(--veil); border-radius:var(--r-pill); }
    .tab { font-family:var(--ff-body); font-size:var(--fs-body-sm); font-weight:500; color:var(--text-body); background:transparent; border:0; border-radius:var(--r-pill); padding:11px 22px; cursor:pointer; transition:.2s; }
    .tab.is-active { background:var(--cta-fill); color:var(--cta-text); }

    .panel.is-hidden { display:none; }

    /* статьи */
    .art-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; }
    .art { padding:0; overflow:hidden; display:block; transition:.2s; }
    .art:hover h3 { color:var(--accent-soft); }
    .art-thumb { position:relative; aspect-ratio:16/9; }
    .art-tag { position:absolute; left:14px; top:14px; font-size:var(--fs-caption); color:var(--text-strong); background:var(--veil-strong); border-radius:var(--r-pill); padding:5px 12px; }
    .art-body { padding:22px 24px 26px; }
    .art-body h3 { font-size:var(--fs-sub); font-weight:600; line-height:1.3; margin:0 0 10px; }
    .art-ex { font-size:var(--fs-body-sm); line-height:1.55; color:var(--text-body); margin:0 0 14px; }
    .art-date { font-size:var(--fs-caption); color:var(--text-muted); margin:0; }

    /* клинические исследования */
    .trials-intro { padding:32px 36px; margin-bottom:28px; }
    .trials-intro h2 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; margin:0 0 12px; }
    .trials-intro p { font-size:var(--fs-body); line-height:1.6; color:var(--text-body); margin:0; max-width:var(--measure-text); }
    .trial-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
    .trial { padding:26px; display:flex; flex-direction:column; }
    .trial-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
    .trial-status { font-size:var(--fs-caption); font-weight:500; border-radius:var(--r-pill); padding:5px 12px; }
    .trial-status.open { background:var(--c-wash-teal); color:var(--c-teal-deep); }
    .trial-status.soon { background:var(--c-wash-violet); color:var(--c-violet-deep); }
    .trial-phase { font-size:var(--fs-caption); color:var(--text-muted); }
    .trial-drug { font-size:var(--fs-sub); font-weight:600; line-height:1.25; margin:0 0 4px; }
    .trial-proto { font-size:var(--fs-caption); color:var(--text-muted); margin:0 0 18px; }
    .trial-meta { margin:0 0 20px; display:grid; gap:14px; }
    .trial-meta dt { font-size:var(--fs-caption); letter-spacing:.1em; text-transform:none; color:var(--accent); margin-bottom:4px; }
    .trial-meta dd { font-size:var(--fs-body-sm); line-height:1.5; color:var(--text-body); margin:0; }
    .trial-link { margin-top:auto; font-size:var(--fs-body-sm); color:var(--accent); display:inline-flex; align-items:center; gap:6px; }

    /* подвал */
    .foot { padding-block:48px 72px; }
    .foot-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:28px; border-top:1px solid var(--border-hairline); padding-top:36px; }
    .foot-h { font-size:var(--fs-body-sm); font-weight:600; color:var(--text-strong); margin:0 0 10px; }
    .foot-grid p { font-size:var(--fs-caption); line-height:1.7; color:var(--text-body); margin:0; }

    @media (max-width:900px) {
      .art-grid, .trial-grid { grid-template-columns:1fr; }
      .nav { display:none; }
      .foot-grid { grid-template-columns:1fr; }
    }
  </style>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
    const panels: Record<string, HTMLElement | null> = {
      articles: document.getElementById('panel-articles'),
      trials: document.getElementById('panel-trials'),
    };
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        Object.entries(panels).forEach(([key, el]) => {
          el?.classList.toggle('is-hidden', key !== tab.dataset.tab);
        });
      });
    });
  </script>
</Base>

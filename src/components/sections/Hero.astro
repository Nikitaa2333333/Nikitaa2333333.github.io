---
/* Hero — первый экран главной (Экран 1 ТЗ): фото клиники на весь вьюпорт,
   слайдер с плавным crossfade (автоплей только когда блок на экране),
   текст по низу в два угла на тёмном scrim: слева H1 + подзаголовок + кнопки,
   справа — описание и адрес клиники. Контент — правки заказчика
   (docs/тексты-главной.md).
   Самодостаточный компонент: разметка + scoped-стили + скрипт. */

import { clinic } from '../../data/clinic';

const slides = [
  { src: '/images/clinic/exterior.webp',  alt: 'Клиника трансляционной медицины в Санкт-Петербурге', w: 1920, h: 1080 },
  { src: '/images/clinic/ward.webp',      alt: 'Палата дневного стационара клиники',                w: 1920, h: 1080 },
  { src: '/images/clinic/infusion.webp',  alt: 'Инфузионная зона и кресла-реклайнеры',             w: 1920, h: 1080 },
  { src: '/images/clinic/consult.webp',   alt: 'Кабинет консультаций врача-онколога',               w: 1920, h: 1080 },
  { src: '/images/clinic/reception.webp', alt: 'Холл и ресепшен клиники в СПб',                    w: 1920, h: 1080 },
];
---

<section class="hero-full" aria-label="Клиника лекарственного лечения онкологических заболеваний">
  <!-- фоновый слайдер: full-bleed фото клиники, crossfade -->
  <div class="hf-bg" aria-hidden="true">
    {slides.map((s, idx) => (
      <img
        src={s.src}
        alt={s.alt}
        width={s.w}
        height={s.h}
        loading={idx === 0 ? 'eager' : 'lazy'}
        fetchpriority={idx === 0 ? 'high' : 'low'}
        decoding="async"
        class={`hf-img ${idx === 0 ? 'is-active' : ''}`}
      />
    ))}
    <!-- тёмный градиент-scrim по низу — читаемость текста на фото -->
    <div class="hf-scrim"></div>
  </div>

  <div class="wrap hf-grid">
    <!-- Именованные grid-области (не порядок в разметке) определяют раскладку:
         на десктопе адрес и телефон — общая верхняя строка на одной линии;
         на мобиле (≤760px) телефон возвращается на своё прежнее место —
         между подзаголовком и абзацем, без маркера, порядок как раньше.
         Сама раскладка — в <style> ниже (.hf-grid grid-template-areas). -->
    <p class="hf-tag"><mark>{clinic.city}, {clinic.addrShort}</mark></p>
    <a href={clinic.phoneHref} class="hf-phone">
      <svg viewBox="0 0 24 24" class="hf-phone-ic" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
      <mark>{clinic.phone}</mark>
    </a>

    <!-- слева H1 + подзаголовок, справа описание. Низ описания выровнен
         по нижней линии подзаголовка (align end), кнопки — отдельным рядом ниже. -->
    <div class="hf-left">
      <h1 class="hf-title">Клиника трансляционной медицины: лечение онкологических заболеваний в&nbsp;дневном стационаре</h1>
      <p class="hf-sub">Химиотерапия, таргетная и&nbsp;иммунотерапия.</p>
    </div>

    <div class="hf-right">
      <p class="hf-text">Вы&nbsp;или ваш близкий узнали о&nbsp;серьёзном диагнозе&nbsp;— злокачественная опухоль. Важно, не&nbsp;теряя самообладания, понять, что&nbsp;происходит, и&nbsp;составить план действий. Мы&nbsp;вместе с&nbsp;вами обсудим ситуацию, внимательно изучим результаты обследований, объясним всё без&nbsp;спешки и&nbsp;на&nbsp;понятном языке. Предложим оптимальный план лечения.</p>
    </div>

    <div class="hf-cta">
      <a href="#contacts" class="btn btn-dark">Записаться на&nbsp;приём</a>
      <a href="#tele" class="btn btn-light">Телемедицинская консультация</a>
    </div>
  </div>
</section>

<style>
  /* — Полотно: фото на весь вьюпорт, контент прижат к низу — */
  .hero-full {
    position: relative;
    /* svh, а не dvh: dvh «прыгает», когда браузер прячет адресную строку.
       Вычитаем шапку — она липкая и стоит НАД hero в потоке, поэтому чистые
       100svh давали 75 + 845 = 920px при экране iPhone 844px, и обе кнопки
       оказывались за сгибом. */
    min-height: calc(100vh - var(--head-h));
    min-height: calc(100svh - var(--head-h));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--grad-uni); /* подложка, пока фото не загрузилось */
  }

  /* — Слайдер: кадры друг под другом, плавный crossfade через opacity — */
  .hf-bg { position: absolute; inset: 0; }
  .hf-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1s ease;
  }
  .hf-img.is-active { opacity: 1; }

  /* — Scrim: тёмный градиент по низу фото (rgba допущен только здесь) — */
  .hf-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 13, 18, 0.82) 0%,
      rgba(10, 13, 18, 0.52) 28%,
      rgba(10, 13, 18, 0.18) 52%,
      rgba(10, 13, 18, 0) 72%
    );
    pointer-events: none;
  }

  /* — Контент: два нижних угла — */
  /* Именованные области вместо порядка в разметке: на десктопе адрес
     и телефон делят верхнюю строку, на мобиле телефон возвращается
     в середину колонки (переопределено в медиа-запросах ниже). */
  .hf-grid {
    position: relative;
    z-index: 1;
    display: grid;
    /* левая колонка шире: клиентский H1 длинный (~76 знаков),
       узкая колонка рвала его на строки-сироты */
    grid-template-columns: 1.6fr 1fr;
    grid-template-areas:
      "tag   phone"
      "left  right"
      "cta   .";
    align-items: end;
    gap: 24px 64px;
    padding-block: 40px 52px;
  }
  .hf-tag { grid-area: tag; align-self: baseline; }
  .hf-phone { grid-area: phone; justify-self: end; align-self: baseline; }
  .hf-left { grid-area: left; }
  .hf-right { grid-area: right; }
  .hf-cta { grid-area: cta; }

  /* Левый угол: киккер + H1 + подзаголовок */
  .hf-kicker {
    font-size: var(--fs-caption);
    letter-spacing: 0.06em;
    color: var(--accent-on-dark);
    margin: 0 0 16px;
  }
  .hf-title {
    font-family: var(--ff-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    /* Ступень ниже display (согласовано): длинный клиентский H1 на display-кегле
       не влезал в колонку — одно слово на строке. Меру задаёт сама колонка. */
    font-size: var(--fs-h-lg);
    color: #fff;
    margin: 0 0 18px;
  }
  .hf-sub {
    font-size: var(--fs-sub);
    line-height: 1.5;
    color: #fff;
    max-width: 30em;
    margin: 0;
  }

  /* Правый угол: только описание. Прижато к низу — лежит на плотной части
     scrim, поэтому белый читается сплошным, без «прозрачности». */
  .hf-right { max-width: 34em; justify-self: end; }
  .hf-text {
    font-size: var(--fs-body-lg);
    line-height: 1.55;
    color: #fff;
    margin: 0;
  }
  /* Телефон — пара адресу: тот же приём выделения (<mark>), чтобы номер
     не терялся на фото так же, как раньше терялся текст без подложки. */
  .hf-phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-h);
    font-weight: 600;
    color: #fff;
  }
  .hf-phone-ic { width: 20px; height: 20px; flex: none; color: var(--accent-on-dark); transition: color 0.2s; }
  .hf-phone:hover .hf-phone-ic { color: var(--accent-on-dark); }
  .hf-phone mark { transition: background-color 0.2s; }
  .hf-phone:hover mark { background: var(--accent-on-dark); }
  /* Адрес рядом с телефоном — приём ТЗ «мы настоящие»: реальное место видно
     на первом же экране. Выделен нашим маркером (<mark> в разметке): чёткий
     прямоугольник --hl-fill, текст внутри перекрашивает глобальное правило
     mark (--hl-ink), поэтому на фото это тёмные буквы на светлой подложке.
     Своей заливки и скругления здесь нет — их даёт маркер. */
  .hf-tag {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    margin: 0;
  }

  /* — Кнопки: стили в global.css; область "cta" сама на всю ширину строки —
       так низ описания справа ложится точно на линию подзаголовка.
       Вторая кнопка на фото — та же белая заливная (.btn-light) — */
  .hf-cta { display: flex; gap: 14px; flex-wrap: wrap; } /* отступ сверху даёт row-gap сетки */

  /* — Адаптив: ≤960px колонки складываются в одну (слева-снизу) — */
  @media (max-width: 960px) {
    .hf-grid {
      grid-template-columns: 1fr;
      grid-template-areas: "tag" "phone" "left" "right" "cta";
      gap: 22px;
      padding-block: 32px 36px;
    }
    .hf-phone { justify-self: start; }
    .hf-right { justify-self: start; }
    .hf-scrim {
      background: linear-gradient(
        to top,
        rgba(10, 13, 18, 0.86) 0%,
        rgba(10, 13, 18, 0.6) 42%,
        rgba(10, 13, 18, 0.2) 68%,
        rgba(10, 13, 18, 0) 85%
      );
    }
  }
  /* ============================================================
     МОБИЛЬНЫЙ HERO — фото СВЕРХУ, текст ПОД ним.
     На телефоне текст поверх фото не работает: заголовок в 5 строк и абзац
     в 9 строк ложатся на всю высоту кадра, а не на плотную часть scrim —
     буквы попадают то на светлое окно, то на白 халат, и читаются рвано.
     Никакой scrim этого не лечит: затемнить весь кадр = убить фото.
     Поэтому на мобиле кадр становится обычной картинкой сверху (пропорция
     4:3), а текст живёт под ним на холсте обычными тёмными чернилами.
     Слайдер и crossfade сохраняются — меняется только раскладка.
     ============================================================ */
  @media (max-width: 760px) {
    .hero-full {
      min-height: 0;
      display: block;
      background: var(--bg-canvas);
    }
    /* кадр перестаёт быть фоном и становится блоком в потоке */
    .hf-bg { position: relative; inset: auto; aspect-ratio: 4 / 3; }
    /* Затемняющий scrim не нужен — текста на фото больше нет. Вместо него
       низ кадра растворяется в цвет холста, чтобы граница «фото → текст»
       не резала экран пополам. */
    .hf-scrim {
      background: linear-gradient(
        to top,
        var(--bg-canvas) 0%,
        color-mix(in srgb, var(--bg-canvas) 72%, transparent) 14%,
        color-mix(in srgb, var(--bg-canvas) 32%, transparent) 30%,
        transparent 48%
      );
    }

    /* На мобиле телефон — как раньше: между подзаголовком и абзацем,
       обычным текстом без маркера (маркер — только для пары с адресом
       на фото десктопа, здесь текст и так на светлом холсте, контраст есть). */
    .hf-grid {
      padding-block: 24px 32px;
      gap: 18px;
      grid-template-areas: "tag" "left" "phone" "right" "cta";
    }
    .hf-phone { justify-self: start; }
    /* Чернила вместо белого: текст теперь на светлом холсте. */
    .hf-title { color: var(--text-strong); margin-bottom: 14px; }
    .hf-sub { color: var(--text-strong); }
    .hf-text { color: var(--text-body); font-size: var(--fs-body); }
    .hf-phone { color: var(--accent-soft); font-size: var(--fs-sub); }
    .hf-phone-ic { width: 18px; height: 18px; color: var(--accent-soft); }
    .hf-phone:hover { color: var(--accent); }
    .hf-phone:hover .hf-phone-ic { color: var(--accent); }
    .hf-phone mark { background: none; color: inherit; padding: 0; }
    /* Адрес — первая строка над заголовком, как раньше */
    .hf-tag { margin-bottom: 14px; }

    .hf-cta { flex-direction: column; align-items: stretch; }
    .hf-cta .btn { width: 100%; justify-content: center; }
    /* Раньше здесь стояла ледяная заливка --btn3-fill (.btn-ice) — она
       и есть холст (#dcedf3 на #ebf5ff), кнопка сливалась с фоном.
       .btn-light (чистый белый + тень из global.css) — тот же приём,
       что уже используется на холсте в других секциях («Все врачи»). */
  }
</style>

<script>
  // crossfade-слайдер hero: автоплей ходит только когда блок на экране (autoplayIO)
  const root = document.querySelector('.hero-full');
  const imgs = root ? [...root.querySelectorAll<HTMLElement>('.hf-img')] : [];
  let idx = 0;
  let timer: number | undefined;

  const go = (i: number) => {
    idx = (i + imgs.length) % imgs.length;
    imgs.forEach((im, k) => im.classList.toggle('is-active', k === idx));
  };
  const stop = () => { if (timer) clearInterval(timer); timer = undefined; };
  const auto = () => { stop(); timer = window.setInterval(() => go(idx + 1), 5000); };

  if (root && imgs.length > 1) {
    new IntersectionObserver(
      ([e]) => (e.isIntersecting ? auto() : stop()),
      { threshold: 0.1 },
    ).observe(root);
  }
</script>

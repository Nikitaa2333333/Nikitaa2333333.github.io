---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import FooterContacts from '../../components/sections/FooterContacts.astro';
import PageCta from '../../components/sections/PageCta.astro';
import { clinic } from '../../data/clinic';

/* ============================================================
   «Химиотерапия» — страница раздела «Лечение» (ТЗ, пункт меню 4).
   Сценарий страницы:
   1) hero + крошки + лид «звучит страшнее, чем выглядит»;
   2) как это работает (две равные колонки) + примечание про дневной стационар;
   3) группы препаратов — справочная таблица (паттерн .mk-table /onkomarkery);
   4) день лечения — editorial-список 01–06 (паттерн PlanSteps) + «почему циклы»;
   5) пути введения (катетер, порт, ПИКК, таблетки);
   6) побочные эффекты — ряд одинаковых белых карточек + фертильность;
   7) когда звонить — градиентная плашка с белыми карточками (паттерн .rel-tile);
   8) подготовка к курсу — чек-лист (паттерн .prep-list);
   9) между курсами;
   10) мифы;
   11) перелинковка чипами;
   12) FAQ статичным списком;
   13) CTA + дисклеймер + нормативная плашка ФЗ-38.
   Конкретика клиники — видимыми заглушками [X] / [уточняется у клиники].
   Всё на токенах: без хардкодов кеглей, радиусов и hex.
   ============================================================ */

const icon: Record<string, string> = {
  check: '<path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  phone: '<path d="M4 5c0 8 7 15 15 15l2.5-3.2-4.5-2-2 2c-2.5-1.2-5.1-3.8-6.3-6.3l2-2-2-4.5L4 5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
};

// — Экран 2. Группы препаратов: справочная таблица —
// Названия групп и препаратов — как в клинических рекомендациях; трактует
// схему только лечащий врач, таблица нужна для понимания «чего ждать».
const groups = [
  {
    g: 'Препараты платины',
    d: 'Цисплатин, карбоплатин, оксалиплатин',
    n: 'Образуют сшивки в&nbsp;ДНК: клетка не&nbsp;может скопировать геном и&nbsp;поделиться. Требуют внимания к&nbsp;почкам и&nbsp;слуху (цисплатин) и&nbsp;к&nbsp;чувствительности рук и&nbsp;ног (оксалиплатин).',
  },
  {
    g: 'Таксаны',
    d: 'Паклитаксел, доцетаксел',
    n: 'Блокируют «каркас» из&nbsp;микротрубочек, по&nbsp;которому клетка расходит хромосомы. Типичные побочные эффекты&nbsp;— выпадение волос и&nbsp;нейропатия.',
  },
  {
    g: 'Антиметаболиты',
    d: 'Фторурацил, капецитабин, гемцитабин, метотрексат, пеметрексед',
    n: 'Подделки под&nbsp;«строительные блоки» ДНК и&nbsp;РНК: клетка встраивает их вместо настоящих и&nbsp;ломается. Чаще дают воспаление слизистых и&nbsp;изменения кожи ладоней и&nbsp;стоп.',
  },
  {
    g: 'Антрациклины',
    d: 'Доксорубицин, эпирубицин',
    n: 'Встраиваются между цепями ДНК и&nbsp;мешают её копированию. У&nbsp;группы есть предельная суммарная доза за&nbsp;жизнь&nbsp;— поэтому до&nbsp;лечения и&nbsp;в&nbsp;процессе проверяют работу сердца.',
  },
  {
    g: 'Алкилирующие препараты',
    d: 'Циклофосфамид, ифосфамид, бендамустин, темозоломид',
    n: 'Старейшая группа: химически присоединяют свои фрагменты к&nbsp;ДНК и&nbsp;необратимо её повреждают. Работают независимо от&nbsp;того, делится клетка в&nbsp;данный момент или нет.',
  },
  {
    g: 'Ингибиторы топоизомераз',
    d: 'Иринотекан, топотекан, этопозид',
    n: 'Блокируют ферменты, которые расплетают и&nbsp;снова сшивают ДНК при копировании: разрывы не&nbsp;заживают. Типичны диарея (иринотекан) и&nbsp;падение показателей крови.',
  },
];

// — Экран 3. День лечения: editorial-список с крупными номерами —
const day = [
  {
    n: '01',
    t: 'Осмотр и&nbsp;анализы',
    p: 'Перед курсом врач смотрит анализы крови, спрашивает о&nbsp;самочувствии со&nbsp;времени прошлого цикла и&nbsp;оценивает, можно&nbsp;ли проводить лечение сегодня. Если показатели не&nbsp;восстановились, курс переносят&nbsp;— это рабочая ситуация, а&nbsp;не&nbsp;срыв плана.',
  },
  {
    n: '02',
    t: 'Премедикация',
    p: 'До&nbsp;самих химиопрепаратов ставят подготовительные: противотошнотные, при необходимости противоаллергические и&nbsp;гормональные, иногда дополнительную жидкость. Премедикация занимает [X]&nbsp;минут и&nbsp;делает основную часть заметно легче&nbsp;— пропускать её нельзя даже при отличном самочувствии.',
  },
  {
    n: '03',
    t: 'Инфузия',
    p: 'Препараты вводят капельно, в&nbsp;строгом порядке и&nbsp;с&nbsp;заданной скоростью. Длительность зависит от&nbsp;схемы: от&nbsp;получаса до&nbsp;нескольких часов. Всё это время вы&nbsp;в&nbsp;кресле или на&nbsp;кушетке&nbsp;— можно читать, работать, спать, пить воду.',
  },
  {
    n: '04',
    t: 'Наблюдение',
    p: 'Медицинская сестра рядом на&nbsp;всём протяжении инфузии. Реакции, если они бывают, чаще случаются в&nbsp;первые минуты введения, поэтому начало идёт под особым контролем. О&nbsp;любом новом ощущении&nbsp;— жар, зуд, стеснение в&nbsp;груди, боль в&nbsp;месте введения&nbsp;— говорите сразу, не&nbsp;дожидаясь конца капельницы.',
  },
  {
    n: '05',
    t: 'Домой в&nbsp;тот&nbsp;же день',
    p: 'После завершения и&nbsp;короткого наблюдения вы&nbsp;уезжаете домой. Общая продолжительность дня&nbsp;— [X]&nbsp;часов, зависит от&nbsp;схемы. Круглосуточная госпитализация для большинства схем не&nbsp;нужна.',
  },
  {
    n: '06',
    t: 'Что дальше',
    p: 'Вам отдают выписку, назначения на&nbsp;дни после курса (в&nbsp;первую очередь противотошнотные) и&nbsp;дату следующего цикла. Контакт для связи, если что-то пойдёт не&nbsp;так,&nbsp;— [уточняется у&nbsp;клиники].',
  },
];

// — Экран 4. Пути введения препаратов —
const access = [
  {
    t: 'Внутривенно через периферический катетер',
    p: 'Обычный катетер в&nbsp;вену на&nbsp;руке. Подходит, если вены в&nbsp;хорошем состоянии и&nbsp;инфузия короткая. Минус в&nbsp;том, что при многократных введениях вены изнашиваются, а&nbsp;часть препаратов при попадании под кожу повреждает ткани.',
  },
  {
    t: 'Порт-система',
    p: 'Небольшой резервуар, который имплантируют под кожу в&nbsp;области грудной клетки и&nbsp;соединяют с&nbsp;крупной веной; препарат вводят через кожу специальной иглой. Оптимальный вариант при длительном лечении&nbsp;— от&nbsp;трёх месяцев и&nbsp;дольше: не&nbsp;нужно каждый раз искать вену, риск повреждения тканей минимален, порт не&nbsp;видно под одеждой, с&nbsp;ним можно мыться и&nbsp;жить обычной жизнью. Ставят его в&nbsp;отдельной короткой процедуре, уход сводится к&nbsp;промыванию по&nbsp;графику. Установка порта в&nbsp;клинике&nbsp;— [уточняется у&nbsp;клиники].',
  },
  {
    t: 'ПИКК-катетер',
    p: 'Тонкий катетер, который вводят через вену на&nbsp;руке и&nbsp;проводят до&nbsp;крупной вены. Вариант для лечения средней длительности&nbsp;— примерно от&nbsp;недели до&nbsp;полугода. Не&nbsp;требует операции, устанавливается быстрее порта, но&nbsp;снаружи остаётся выход катетера, который нужно защищать при мытье.',
  },
  {
    t: 'Таблетированная химиотерапия',
    p: 'Часть препаратов существует в&nbsp;таблетках и&nbsp;капсулах&nbsp;— их принимают дома по&nbsp;расписанию. Это удобно, но&nbsp;требует дисциплины: пропуски и&nbsp;самостоятельные изменения дозы напрямую влияют на&nbsp;результат, а&nbsp;побочные эффекты у&nbsp;таблеток не&nbsp;мягче&nbsp;— просто за&nbsp;ними наблюдает не&nbsp;медсестра, а&nbsp;вы&nbsp;сами. Ведите простой дневник приёма и&nbsp;не&nbsp;корректируйте дозу без врача.',
  },
];

// — Экран 5. Побочные эффекты: одинаковые белые карточки —
// В каждой карточке: что бывает (h3) и что с этим делают (текст).
const side = [
  {
    t: 'Тошнота&nbsp;— сегодня управляема',
    p: 'Профилактику подбирают по&nbsp;эметогенности схемы&nbsp;— её способности вызывать тошноту: при высокой дают комбинацию препаратов разных классов, при низкой достаточно одного. Ключевое слово&nbsp;— профилактика: антиэметики назначают до&nbsp;химиотерапии и&nbsp;продолжают в&nbsp;дни после. Если схема не&nbsp;помогла&nbsp;— это повод сказать врачу и&nbsp;поменять её, а&nbsp;не&nbsp;терпеть до&nbsp;следующего курса.',
  },
  {
    t: 'Утомляемость',
    p: 'Самый частый и&nbsp;самый недооценённый эффект: она не&nbsp;проходит от&nbsp;сна и&nbsp;накапливается к&nbsp;концу лечения. Помогают посильная регулярная активность (именно активность, а&nbsp;не&nbsp;полный покой), нормальный сон, лечение анемии и&nbsp;честное перераспределение дел. Резкое нарастание слабости, особенно с&nbsp;одышкой или сердцебиением,&nbsp;— повод сдать кровь, а&nbsp;не&nbsp;полежать.',
  },
  {
    t: 'Падение показателей крови',
    p: 'Через 7–14&nbsp;дней после введения падают лейкоциты, в&nbsp;первую очередь нейтрофилы&nbsp;— клетки, которые защищают от&nbsp;инфекций. В&nbsp;этот период инфекция развивается стремительно и&nbsp;почти без симптомов, кроме температуры. При высоком риске врач заранее назначает препараты, стимулирующие рост нейтрофилов. Что делать при температуре&nbsp;— в&nbsp;блоке ниже.',
  },
  {
    t: 'Выпадение волос',
    p: 'Дают не&nbsp;все препараты: таксаны и&nbsp;антрациклины&nbsp;— да, многие другие схемы&nbsp;— нет. Спросите врача заранее, чтобы не&nbsp;готовиться к&nbsp;тому, чего не&nbsp;будет. Волосы начинают выпадать через 2–3&nbsp;недели от&nbsp;начала лечения и&nbsp;отрастают после его окончания. Многим легче подстричься коротко заранее; парик или платок стоит подобрать до, а&nbsp;не&nbsp;после.',
  },
  {
    t: 'Нейропатия',
    p: 'Онемение, покалывание и&nbsp;жжение в&nbsp;кончиках пальцев; характерна для платины (особенно оксалиплатина) и&nbsp;таксанов, накапливается с&nbsp;числом курсов. Лекарства, которое это вылечит, нет&nbsp;— зато работает своевременное снижение дозы или изменение схемы. Поэтому о&nbsp;первых покалываниях говорят сразу, а&nbsp;не&nbsp;когда перестанут застёгиваться пуговицы.',
  },
  {
    t: 'Мукозит&nbsp;— воспаление слизистых',
    p: 'Болезненность и&nbsp;язвочки во&nbsp;рту, иногда по&nbsp;всему пищеварительному тракту; чаще на&nbsp;антиметаболитах. Профилактика проста и&nbsp;реально работает: мягкая щётка, полоскания без спирта несколько раз в&nbsp;день, отказ от&nbsp;острого, кислого, горячего и&nbsp;твёрдого, лечение зубов до&nbsp;начала химиотерапии. Стало больно есть и&nbsp;пить&nbsp;— это повод к&nbsp;лечению: обезвоживание опаснее самого мукозита.',
  },
];

// — Экран 5b. Когда звонить: срочно и не срочно (белые карточки в градиентной плашке) —
const callNow = [
  'Температура 38&nbsp;°C и&nbsp;выше или озноб',
  'Рвота или диарея, из-за которых больше суток не&nbsp;удаётся пить',
  'Кровотечение, кровь в&nbsp;стуле или моче, множественные синяки',
  'Сыпь, отёк лица или губ, затруднённое дыхание',
  'Боль в&nbsp;груди, выраженная одышка',
  'Боль, покраснение или отёк в&nbsp;области порта или катетера',
  'Резкое нарастание слабости, спутанность сознания',
];

const callSoon = [
  'Покалывание или онемение в&nbsp;пальцах рук и&nbsp;ног',
  'Язвочки во&nbsp;рту, стало больно есть',
  'Тошнота, с&nbsp;которой не&nbsp;справляются назначенные препараты',
  'Необычная сыпь или изменения ногтей',
  'Постоянная бессонница, тяжёлое подавленное состояние',
];

// — Экран 6. Подготовка к курсу: чек-лист —
const prep = [
  {
    t: 'Сдайте анализы заранее',
    d: 'Клинический анализ крови&nbsp;— не&nbsp;более чем за&nbsp;5&nbsp;дней до&nbsp;курса, биохимический&nbsp;— не&nbsp;более чем за&nbsp;7&nbsp;дней; периодически&nbsp;— ЭКГ, а&nbsp;при отдельных препаратах&nbsp;— работа сердца. Без свежих анализов курс не&nbsp;проводят. Точный перечень и&nbsp;где сдавать&nbsp;— [уточняется у&nbsp;клиники].',
  },
  {
    t: 'Соберите документы и&nbsp;сумку',
    d: 'Паспорт, полис, выписки и&nbsp;результаты анализов, список принимаемых лекарств. Из&nbsp;бытового: вода, легкий перекус, тёплые носки и&nbsp;кофта, наушники, книга или планшет, зарядка. Одежда&nbsp;— свободная, с&nbsp;доступом к&nbsp;руке или к&nbsp;области порта.',
  },
  {
    t: 'Поешьте утром и&nbsp;пейте воду',
    d: 'На&nbsp;голодный желудок тошнота обычно хуже, поэтому позавтракать стоит&nbsp;— легко, но&nbsp;стоит. Достаточное количество воды в&nbsp;день курса и&nbsp;в&nbsp;1–2&nbsp;дня после снижает нагрузку на&nbsp;почки, особенно на&nbsp;схемах с&nbsp;платиной. Алкоголь в&nbsp;дни курса&nbsp;— нет.',
  },
  {
    t: 'На&nbsp;первый курс приезжайте с&nbsp;близким',
    d: 'Формально при большинстве схем сопровождающий не&nbsp;обязателен, но&nbsp;неизвестно, как вы&nbsp;будете себя чувствовать после. Вести машину в&nbsp;этот день не&nbsp;стоит: часть препаратов премедикации даёт сонливость. Правила сопровождения в&nbsp;клинике&nbsp;— [уточняется у&nbsp;клиники].',
  },
  {
    t: 'Покажите врачу все лекарства и&nbsp;добавки',
    d: 'Полный список: назначенные препараты, безрецептурные средства, витамины, добавки, травяные сборы. Это не&nbsp;формальность&nbsp;— часть добавок и&nbsp;трав меняет концентрацию химиопрепаратов в&nbsp;крови, то&nbsp;есть делает лечение слабее или токсичнее. Ничего нового не&nbsp;начинайте принимать в&nbsp;ходе лечения, не&nbsp;спросив врача.',
  },
];

// — Экран 7. Между курсами —
const between = [
  {
    t: 'Измеряйте температуру',
    p: 'Дважды в&nbsp;день в&nbsp;период спада показателей крови&nbsp;— примерно с&nbsp;7-го по&nbsp;14-й день после введения&nbsp;— и&nbsp;всегда при ознобе или ощущении жара. Держите градусник под рукой и&nbsp;записывайте результат.',
  },
  {
    t: 'Берегитесь инфекций',
    p: 'Часто мойте руки, обрабатывайте ранки и&nbsp;порезы, ухаживайте за&nbsp;полостью рта мягкой щёткой. В&nbsp;дни низких показателей крови избегайте больших скоплений людей и&nbsp;контактов с&nbsp;болеющими, мойте фрукты и&nbsp;овощи, не&nbsp;ешьте сырое мясо, рыбу и&nbsp;яйца. Прививки&nbsp;— только по&nbsp;согласованию с&nbsp;онкологом.',
  },
  {
    t: 'Двигайтесь по&nbsp;силам',
    p: 'Прогулки и&nbsp;лёгкие упражнения уменьшают утомляемость, поддерживают аппетит и&nbsp;сон. Не&nbsp;через силу до&nbsp;изнеможения и&nbsp;не&nbsp;строгий покой: ориентир&nbsp;— приятная усталость, а&nbsp;не&nbsp;разбитость. Работать во&nbsp;время лечения многим удаётся&nbsp;— вопрос в&nbsp;нагрузке и&nbsp;графике.',
  },
];

// — Экран 8. Мифы: утверждение → как на самом деле —
const myths = [
  {
    t: '«Химия убивает организм»',
    p: 'Химиотерапия действительно повреждает не&nbsp;только опухоль, и&nbsp;это цена метода. Но&nbsp;подавляющая часть эффектов обратима: костный мозг и&nbsp;слизистые восстанавливаются между курсами, волосы отрастают. Для отдельных видов токсичности&nbsp;— сердечной, почечной, нейропатии&nbsp;— есть предельные суммарные дозы и&nbsp;регулярный контроль, именно чтобы до&nbsp;необратимого не&nbsp;дошло. Отказ от&nbsp;лечения не&nbsp;защищает организм от&nbsp;рака.',
  },
  {
    t: '«Есть таргетная и&nbsp;иммунотерапия&nbsp;— химия устарела»',
    p: 'Новые препараты изменили лечение целого ряда опухолей, но&nbsp;не&nbsp;отменили химиотерапию. Таргетный препарат работает только при наличии своей мишени, иммунотерапия&nbsp;— только у&nbsp;части пациентов, а&nbsp;для многих заболеваний ни&nbsp;того, ни&nbsp;другого пока нет. К&nbsp;тому&nbsp;же современные схемы часто комбинируют химиотерапию с&nbsp;иммуно- или таргетными препаратами: вместе они работают лучше, чем каждый по&nbsp;отдельности.',
  },
  {
    t: '«Побочные эффекты надо терпеть молча»',
    p: 'Самое вредное убеждение из&nbsp;списка. Молча перенесённая тошнота&nbsp;— это плохо съеденная еда, потерянный вес и&nbsp;хуже переносимый следующий курс. Проигнорированное покалывание в&nbsp;пальцах может стать стойким нарушением, которое уже не&nbsp;отменить. Скрытая температура&nbsp;— потерянные часы при неотложном состоянии. Врач оценивает побочные эффекты перед каждым циклом именно для того, чтобы менять дозы и&nbsp;назначения.',
  },
  {
    t: '«Народные средства&nbsp;— вместо химиотерапии или вместе с&nbsp;ней»',
    p: 'Вместо&nbsp;— не&nbsp;работает: доказанных данных о&nbsp;том, что травы, диеты, сода или голодание уничтожают опухоль, нет, а&nbsp;потерянное время при онкологическом заболевании не&nbsp;возвращается. Вместе&nbsp;— не&nbsp;безобидно: часть растительных средств и&nbsp;высоких доз добавок меняет концентрацию химиопрепаратов в&nbsp;крови и&nbsp;способна сделать лечение либо неэффективным, либо токсичным. Если вы&nbsp;что-то принимаете или собираетесь начать&nbsp;— просто скажите врачу.',
  },
];

// — Экран 9. Перелинковка (чипы с шевроном) —
const links = [
  { t: 'Как выбирается метод лечения', href: '/lechenie' },
  { t: 'Молекулярно-генетические исследования', href: '/molekulyarnaya-diagnostika' },
  { t: 'Биопсия и&nbsp;гистология', href: '/biopsiya' },
  { t: 'Врачи клиники', href: '/vrachi' },
  { t: 'Цены', href: '/stoimost' },
  { t: 'С&nbsp;чего начать', href: '/s-chego-nachat' },
];

// — Экран 10. FAQ (статичный список, две колонки) —
const faq = [
  {
    q: 'Сколько длится один курс и&nbsp;сколько курсов будет?',
    a: 'Введение занимает от&nbsp;получаса до&nbsp;нескольких часов, весь день в&nbsp;стационаре&nbsp;— [X]&nbsp;часов. Цикл повторяется чаще всего каждые 1, 2 или 3&nbsp;недели. Общее число циклов определено схемой: для части схем это фиксированные 4–6, для других лечение продолжают, пока оно работает и&nbsp;переносимо. Ваш график назовут до&nbsp;начала лечения.',
  },
  {
    q: 'Можно ли&nbsp;лечиться и&nbsp;продолжать работать?',
    a: 'Многим удаётся, особенно на&nbsp;схемах с&nbsp;умеренной переносимостью и&nbsp;при гибком графике. Реалистичнее планировать так: день курса и&nbsp;2–3&nbsp;дня после&nbsp;— разгрузочные, дальше по&nbsp;самочувствию. Обсудите с&nbsp;врачом, каких дней ждать просадки именно на&nbsp;вашей схеме, и&nbsp;стройте расписание вокруг них.',
  },
  {
    q: 'Обязательно ли&nbsp;ложиться в&nbsp;больницу?',
    a: 'Для большинства схем нет: лечение проводят в&nbsp;дневном стационаре, и&nbsp;вечером вы&nbsp;уезжаете домой. Круглосуточная госпитализация нужна при отдельных схемах, требующих длительной инфузии или наблюдения, и&nbsp;при осложнениях.',
  },
  {
    q: 'Все&nbsp;ли теряют волосы?',
    a: 'Нет. Это зависит от&nbsp;препаратов: таксаны и&nbsp;антрациклины обычно вызывают выпадение, многие другие схемы&nbsp;— нет или незначительно. Спросите врача прямо, применительно к&nbsp;вашей схеме. Если выпадение будет, оно обратимо&nbsp;— волосы отрастают после окончания лечения.',
  },
  {
    q: 'Что делать, если поднялась температура?',
    a: 'Звонить сразу при 38&nbsp;°C и&nbsp;выше&nbsp;— в&nbsp;любое время суток, не&nbsp;дожидаясь утра и&nbsp;не&nbsp;принимая жаропонижающее самостоятельно. В&nbsp;период низких нейтрофилов это неотложное состояние, которое лечат антибиотиками в&nbsp;первые часы. Телефон для связи&nbsp;— [уточняется у&nbsp;клиники].',
  },
  {
    q: 'Нужна ли&nbsp;особая диета?',
    a: 'Специальной противораковой диеты не&nbsp;существует. Работает обычное сбалансированное питание дробными порциями, с&nbsp;достаточным количеством белка и&nbsp;жидкости. При мукозите временно убирают острое, кислое, горячее и&nbsp;твёрдое; в&nbsp;дни низких показателей крови избегают сырого мяса, рыбы и&nbsp;яиц. Голодание и&nbsp;жёсткие ограничения во&nbsp;время лечения вредны&nbsp;— потеря веса ухудшает переносимость.',
  },
  {
    q: 'Можно ли&nbsp;лечиться, если есть другие болезни&nbsp;— сердце, диабет, гипертония?',
    a: 'В&nbsp;большинстве случаев да, но&nbsp;схему и&nbsp;дозы подбирают с&nbsp;учётом этого, а&nbsp;иногда меняют на&nbsp;альтернативную. Именно поэтому перед началом лечения смотрят сердце, почки, печень и&nbsp;при необходимости привлекают профильных специалистов. Принесите на&nbsp;консультацию все свои диагнозы и&nbsp;препараты.',
  },
  {
    q: 'Можно ли&nbsp;перевести лечение к&nbsp;вам, если начал в&nbsp;другом месте?',
    a: 'Да, продолжение лечения по&nbsp;уже назначенной схеме возможно. Привезите выписки, протокол консилиума, результаты гистологии и&nbsp;молекулярных исследований, данные последних обследований, а&nbsp;также сведения о&nbsp;полученных курсах и&nbsp;дозах&nbsp;— последнее особенно важно для препаратов с&nbsp;предельной суммарной дозой. Порядок перевода&nbsp;— [уточняется у&nbsp;клиники].',
  },
];
---

<Base
  title="Химиотерапия в дневном стационаре — Клиника трансляционной медицины"
  description="Как проходит химиотерапия в дневном стационаре: группы препаратов, день лечения по шагам, пути введения и порт-система, побочные эффекты и что с ними делают, подготовка к курсу, частые вопросы."
>
  <Header current="himio" />

  <!-- HERO страницы -->
  <section class="page-hero">
    <div class="blob" style="width:480px;height:480px;background:var(--c-wash-teal);top:-160px;left:-60px;"></div>
    <div class="blob" style="width:420px;height:420px;background:var(--c-wash-blue);top:-80px;right:-40px;"></div>
    <div class="wrap" style="position:relative;z-index:1;">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/lechenie">Лечение</a><span aria-hidden="true">/</span><span>Химиотерапия</span>
      </nav>
      <div class="page-eyebrow">Лечение</div>
      <h1 class="page-title">Химиотерапия в&nbsp;дневном <em class="i-serif">стационаре</em></h1>
      <p class="page-sub">Химиотерапия&nbsp;— это лечение препаратами, которые останавливают деление клеток. Звучит страшнее, чем выглядит: вечером человек уезжает домой, потому что большинство схем сегодня проводят в&nbsp;дневном стационаре.</p>
      <div class="hero-cta">
        <a href="#contacts" class="btn btn-dark"><svg viewBox="0 0 24 24" class="ic-s" set:html={icon.phone}></svg>Записаться на&nbsp;консультацию</a>
        <a href="#day" class="btn btn-light">Как проходит день лечения</a>
      </div>
    </div>
  </section>

  <!-- КАК ЭТО РАБОТАЕТ -->
  <section class="sec" id="how">
    <div class="wrap">
      <div class="sec-head">
        <h2>Как работает химиотерапия</h2>
      </div>
      <!-- Ровно ДВЕ равные колонки: широкого лида над ними нет (правило меры строки) -->
      <div class="lead-grid">
        <div class="lead-col">
          <p class="lead-para">Опухоль живёт за&nbsp;счёт того, что делится быстрее и&nbsp;бесконтрольнее нормальных тканей. Химиопрепараты вмешиваются именно в&nbsp;процесс деления: повреждают ДНК опухолевой клетки или ломают механизм, который расходит хромосомы по&nbsp;дочерним клеткам. Клетка, которая не&nbsp;может поделиться, погибает.</p>
          <p class="lead-para">Отсюда и&nbsp;главная особенность метода. Препарат действует не&nbsp;только на&nbsp;опухоль, а&nbsp;на&nbsp;все быстро делящиеся клетки организма: костный мозг, слизистые оболочки, волосяные фолликулы. Поэтому у&nbsp;химиотерапии предсказуемый набор побочных эффектов&nbsp;— и&nbsp;поэтому лечение идёт циклами, с&nbsp;перерывами: здоровым тканям нужно время восстановиться, а&nbsp;опухоли этого времени не&nbsp;хватает.</p>
        </div>
        <div class="lead-col">
          <p class="lead-para">Химиотерапии больше полувека, и&nbsp;она до&nbsp;сих пор остаётся основой лечения многих опухолей. Причина простая: у&nbsp;значительной части заболеваний нет молекулярной мишени для таргетного препарата и&nbsp;нет надёжного иммунного ответа, а&nbsp;химиотерапия работает независимо от&nbsp;того, нашли мутацию или нет.</p>
          <p class="lead-para">Более того, для целого ряда опухолей&nbsp;— части лимфом, герминогенных опухолей&nbsp;— это лечение с&nbsp;радикальной целью, то&nbsp;есть с&nbsp;шансом на&nbsp;полное излечение. А&nbsp;в&nbsp;современных схемах химиопрепараты часто идут не&nbsp;вместо новых препаратов, а&nbsp;вместе с&nbsp;ними&nbsp;— <a href="/lechenie">как выбирается метод</a>, разбираем отдельно.</p>
        </div>
      </div>
      <div class="callout">
        <h3>Что мы&nbsp;делаем</h3>
        <p>Наша клиника&nbsp;— дневной стационар лекарственного лечения: химиотерапия, таргетная, иммуно-, гормональная и&nbsp;сопроводительная терапия. Схема, число циклов и&nbsp;препараты назначаются по&nbsp;результатам обследования и&nbsp;решению консилиума.</p>
      </div>
    </div>
  </section>

  <!-- ГРУППЫ ПРЕПАРАТОВ — справочная таблица -->
  <section class="sec" id="groups">
    <div class="wrap">
      <div class="sec-head">
        <h2>Какие бывают химиопрепараты</h2>
        <p class="sec-lead">Названий много, а&nbsp;принципов действия&nbsp;— несколько. Знать группу полезно: от&nbsp;неё зависит, каких побочных эффектов ждать и&nbsp;как их предупреждать.</p>
      </div>
      <div class="table-wrap">
        <table class="mk-table">
          <thead>
            <tr>
              <th>Группа</th>
              <th>Препараты</th>
              <th>Как действует и&nbsp;что учитывают</th>
            </tr>
          </thead>
          <tbody>
            {groups.map((g) => (
              <tr class="reveal">
                <td class="mk-abbr" set:html={g.g} />
                <td set:html={g.d} />
                <td class="mk-note" set:html={g.n} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">Список неполный: групп и&nbsp;препаратов больше, а&nbsp;набор для конкретной ситуации подбирает лечащий врач. В&nbsp;схему обычно входят два-три препарата разных групп&nbsp;— они бьют по&nbsp;клетке с&nbsp;разных сторон, а&nbsp;побочные эффекты при этом не&nbsp;суммируются в&nbsp;одну точку. Название схемы чаще всего&nbsp;— аббревиатура из&nbsp;первых букв препаратов.</p>
    </div>
  </section>

  <!-- ДЕНЬ ЛЕЧЕНИЯ — editorial-список 01–06 (паттерн PlanSteps) -->
  <section class="sec" id="day">
    <div class="wrap">
      <div class="sec-head">
        <h2>Как проходит день лечения</h2>
        <p class="sec-lead">Ничего внезапного в&nbsp;этот день не&nbsp;происходит. Порядок один и&nbsp;тот&nbsp;же, и&nbsp;его стоит знать заранее&nbsp;— так спокойнее.</p>
      </div>
      <ol class="plan-list">
        {day.map((s, i) => (
          <li class="plan-step reveal" style={`--d:${(i * 0.07).toFixed(2)}s`}>
            <span class="plan-num" aria-hidden="true">{s.n}</span>
            <div class="plan-body">
              <h3 set:html={s.t} />
              <p set:html={s.p} />
            </div>
          </li>
        ))}
      </ol>
      <div class="callout">
        <h3>Почему лечение идёт циклами</h3>
        <p>Цикл&nbsp;— это отрезок от&nbsp;начала одного введения до&nbsp;начала следующего: чаще всего 1, 2 или 3&nbsp;недели. Перерыв внутри цикла&nbsp;— не&nbsp;пауза в&nbsp;лечении, а&nbsp;его часть: за&nbsp;это время восстанавливаются костный мозг и&nbsp;слизистые, а&nbsp;опухоли на&nbsp;восстановление времени не&nbsp;хватает.</p>
        <p>Число циклов определено заранее клиническими рекомендациями: для части схем это фиксированные 4–6&nbsp;циклов, для других лечение продолжают, пока оно работает и&nbsp;переносимо. <mark>Интервалы важнее, чем кажется</mark>&nbsp;— интенсивность лечения влияет на&nbsp;его результат, поэтому сдвигать курсы без медицинской причины не&nbsp;стоит.</p>
      </div>
    </div>
  </section>

  <!-- ПУТИ ВВЕДЕНИЯ -->
  <section class="sec" id="access">
    <div class="wrap">
      <div class="sec-head">
        <h2>Как вводят препараты</h2>
        <p class="sec-lead">Выбор доступа обсуждают до&nbsp;начала лечения, а&nbsp;не&nbsp;когда вены закончились. Если предстоит долгое лечение&nbsp;— спросите про порт-систему на&nbsp;первой&nbsp;же консультации.</p>
      </div>
      <ul class="ed-list">
        {access.map((a, i) => (
          <li class="ed-item reveal" style={`--d:${(i * 0.06).toFixed(2)}s`}>
            <h3 set:html={a.t} />
            <p set:html={a.p} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ПОБОЧНЫЕ ЭФФЕКТЫ — одинаковые белые карточки -->
  <section class="sec" id="side">
    <div class="wrap">
      <div class="sec-head">
        <h2>Побочные эффекты: что бывает и&nbsp;что с&nbsp;этим делают</h2>
        <p class="sec-lead">Побочные эффекты у&nbsp;химиотерапии есть, скрывать это бессмысленно. Важнее другое: почти все они предсказуемы, у&nbsp;большинства есть готовое решение, а&nbsp;часть предупреждают заранее&nbsp;— до&nbsp;того, как станет плохо.</p>
      </div>
      <div class="side-grid">
        {side.map((s, i) => (
          <article class="side-card reveal" style={`--d:${(i * 0.06).toFixed(2)}s`}>
            <h3 set:html={s.t} />
            <p set:html={s.p} />
          </article>
        ))}
      </div>
      <div class="callout">
        <h3>Фертильность&nbsp;— единственный пункт, который нельзя отложить</h3>
        <p>Часть схем снижает или прекращает выработку половых клеток, иногда необратимо. Поэтому сохранение фертильности обсуждают до&nbsp;лечения: после первого курса возможности сужаются. Существующие методы&nbsp;— криоконсервация спермы для мужчин, криоконсервация яйцеклеток или эмбрионов, в&nbsp;отдельных случаях ткани яичника для женщин; всё это делают в&nbsp;профильных центрах по&nbsp;направлению онколога.</p>
        <p>Если вы&nbsp;в&nbsp;принципе рассматриваете детей в&nbsp;будущем&nbsp;— скажите об&nbsp;этом на&nbsp;первой консультации, даже если вопрос кажется преждевременным. Отдельно: во&nbsp;время лечения и&nbsp;некоторое время после нужна надёжная контрацепция, срок зависит от&nbsp;препаратов.</p>
      </div>
      <p class="sec-note">У&nbsp;любого побочного эффекта есть степень тяжести: легкая тошнота на&nbsp;второй день и&nbsp;невозможность пить двое суток&nbsp;— разные ситуации с&nbsp;разными действиями. Поэтому в&nbsp;разговоре с&nbsp;врачом полезны конкретика и&nbsp;цифры: сколько дней, сколько раз, какая температура. Управляемо почти всё&nbsp;— при условии, что врач узнаёт о&nbsp;симптоме вовремя.</p>
    </div>
  </section>

  <!-- КОГДА ЗВОНИТЬ — градиентная плашка с белыми карточками -->
  <section class="sec" id="urgent">
    <div class="wrap">
      <div class="urg-tile" style="--ang:150deg">
        <div class="urg-head">
          <h2>Когда звонить врачу</h2>
          <p class="urg-lead">Между курсами вы&nbsp;дома, и&nbsp;это нормально&nbsp;— но&nbsp;часть состояний ждать до&nbsp;следующего приёма не&nbsp;должна. Главное правило: температура 38&nbsp;°C и&nbsp;выше&nbsp;— <mark>звоните сразу</mark>, в&nbsp;любое время суток.</p>
        </div>
        <div class="urg-grid">
          <article class="urg-card">
            <h3>Немедленно, в&nbsp;любое время суток</h3>
            <ul class="urg-list">
              {callNow.map((c) => (<li set:html={c} />))}
            </ul>
            <p class="urg-note">Температура в&nbsp;период низких нейтрофилов&nbsp;— это фебрильная нейтропения: неотложное состояние, которое требует антибиотиков в&nbsp;первые часы, а&nbsp;не&nbsp;«посмотрим до&nbsp;утра». Не&nbsp;принимайте жаропонижающее, не&nbsp;сообщив врачу: оно сбьёт температуру и&nbsp;скроет проблему.</p>
          </article>
          <article class="urg-card">
            <h3>Не&nbsp;срочно, но&nbsp;обязательно&nbsp;— до&nbsp;следующего курса</h3>
            <ul class="urg-list">
              {callSoon.map((c) => (<li set:html={c} />))}
            </ul>
            <p class="urg-note">Все эти вещи корректируются, если о&nbsp;них знать до&nbsp;следующего курса, а&nbsp;не&nbsp;после: врач меняет дозы, схему профилактики и&nbsp;назначения именно по&nbsp;вашим словам.</p>
          </article>
        </div>
        <div class="urg-cta">
          <a href={clinic.phoneHref} class="btn btn-dark"><svg viewBox="0 0 24 24" class="ic-s" set:html={icon.phone}></svg>{clinic.phone}</a>
          <p class="urg-phone-note">Телефон для связи в&nbsp;период лечения, в&nbsp;том числе в&nbsp;нерабочее время,&nbsp;— [уточняется у&nbsp;клиники]. Его вам выдают вместе с&nbsp;выпиской после первого курса.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ПОДГОТОВКА К КУРСУ — чек-лист -->
  <section class="sec" id="prep">
    <div class="wrap">
      <div class="sec-head">
        <h2>Как подготовиться к&nbsp;курсу</h2>
        <p class="sec-lead">Подготовка занимает полчаса времени, а&nbsp;переносимость меняет заметно. Список короткий и&nbsp;одинаковый перед каждым циклом.</p>
      </div>
      <ul class="prep-list">
        {prep.map((p, i) => (
          <li class="prep-item reveal" style={`--d:${(i * 0.06).toFixed(2)}s`}>
            <span class="prep-ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icon.check}></svg></span>
            <div class="prep-body">
              <h3 set:html={p.t} />
              <p set:html={p.d} />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- МЕЖДУ КУРСАМИ -->
  <section class="sec" id="between">
    <div class="wrap">
      <div class="sec-head">
        <h2>Между курсами</h2>
        <p class="sec-lead">Дни между введениями&nbsp;— часть лечения, а&nbsp;не&nbsp;пауза в&nbsp;нём. Три привычки, которые заметно облегчают весь курс.</p>
      </div>
      <ul class="ed-list">
        {between.map((b, i) => (
          <li class="ed-item reveal" style={`--d:${(i * 0.06).toFixed(2)}s`}>
            <h3 set:html={b.t} />
            <p set:html={b.p} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- МИФЫ -->
  <section class="sec" id="myths">
    <div class="wrap">
      <div class="sec-head">
        <h2>Четыре вещи, которые говорят про химиотерапию</h2>
        <p class="sec-lead">Утверждение&nbsp;— и&nbsp;как дело обстоит на&nbsp;самом деле.</p>
      </div>
      <ul class="ed-list">
        {myths.map((m, i) => (
          <li class="ed-item reveal" style={`--d:${(i * 0.06).toFixed(2)}s`}>
            <h3 set:html={m.t} />
            <p set:html={m.p} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ПЕРЕЛИНКОВКА -->
  <section class="sec" id="more">
    <div class="wrap">
      <div class="sec-head">
        <h2>Что почитать дальше</h2>
        <p class="sec-lead">Схему лечения выбирают не&nbsp;по&nbsp;названию метода, а&nbsp;по&nbsp;данным о&nbsp;конкретной опухоли. Эти страницы объясняют, откуда берутся эти данные и&nbsp;что с&nbsp;ними делают.</p>
      </div>
      <ul class="chip-row">
        {links.map((l) => (
          <li>
            <a class="link-chip" href={l.href}>
              <span set:html={l.t} /><svg class="chev-r" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ — паттерн Faq.astro: статичный список, две колонки, левый край -->
  <section class="wrap sec faq-sec" id="faq">
    <div class="sec-head">
      <h2>Частые вопросы</h2>
    </div>
    <div class="faq">
      {faq.map((item) => (
        <div class="faq-item">
          <h3 class="faq-q" set:html={item.q} />
          <div class="faq-a">
            <p set:html={item.a} />
          </div>
        </div>
      ))}
    </div>
    <p class="faq-note">Стоимость консультации, дня в&nbsp;дневном стационаре и&nbsp;схем лечения&nbsp;— [уточняется у&nbsp;клиники]; актуальный прейскурант&nbsp;— в&nbsp;<a href="/stoimost">разделе «Цены»</a>. Работа по&nbsp;ОМС и&nbsp;ДМС&nbsp;— [уточняется у&nbsp;клиники].</p>
  </section>

  <!-- CTA + ДИСКЛЕЙМЕР + НОРМАТИВНАЯ ПЛАШКА -->
  <PageCta
    title="Разберём вашу схему на&nbsp;консультации"
    text="Принесите выписки, результаты гистологии и&nbsp;молекулярных исследований, сведения о&nbsp;полученных курсах и&nbsp;дозах&nbsp;— врач-онколог объяснит, что показано в&nbsp;вашей ситуации, чем варианты отличаются и&nbsp;как будет устроен день лечения. Если ехать тяжело, начните с&nbsp;телемедицинской консультации по&nbsp;документам."
    note="Материал носит информационный характер и&nbsp;не&nbsp;заменяет консультацию врача. Схема лечения назначается индивидуально по&nbsp;результатам обследования."
  />


  <!-- КОНТАКТЫ + ПОДВАЛ -->
  <FooterContacts />

  <style is:global>
    /* Стили шапки и .ic-s — в Header.astro, здесь не дублируются.
       Кнопки .btn/.btn-dark/.btn-light/.btn-ice — в global.css. */

    /* — hero страницы (паттерн page-hero) — */
    .page-hero { position:relative; overflow:hidden; background:var(--grad-uni); padding-block:52px 46px; }
    .crumbs { display:flex; align-items:center; gap:10px; flex-wrap:wrap; font-size:var(--fs-caption); color:var(--text-muted); margin:0 0 20px; }
    .crumbs a { color:var(--accent-soft); }
    .crumbs a:hover { color:var(--accent); }
    .page-eyebrow { font-size:var(--fs-caption); font-weight:600; letter-spacing:.02em; color:var(--accent); margin:0 0 14px; }
    .page-sub { font-size:var(--fs-sub); line-height:1.55; color:var(--text-body); max-width:var(--measure-lead); margin:0 0 30px; }
    .hero-cta { display:flex; gap:14px; flex-wrap:wrap; }

    /* — секции: мера строки токенами (заголовок в 2 строки, а не одна длинная) — */
    .sec { padding-block:var(--section-gap); }
    .sec-head { margin-bottom:var(--head-gap); }
    .sec-head h2 { font-size:var(--fs-h-lg); letter-spacing:-.025em; font-weight:600; margin:0; max-width:var(--measure-head); }
    .sec-lead { margin:16px 0 0; max-width:var(--measure-lead); font-size:var(--fs-body-lg); line-height:var(--lh-body-lg); letter-spacing:var(--tr-body-lg); color:var(--text-body); }
    .sec-note { margin:var(--s-24) 0 0; max-width:var(--measure-text); font-size:var(--fs-body-lg); line-height:var(--lh-body-lg); color:var(--text-body); }
    /* Ссылки внутри наборного текста (акцент + подчёркивание) — в global.css,
       единым правилом для всего сайта; per-page их не переопределяем. */

    /* — «как работает»: ДВЕ РАВНЫЕ колонки, широкого лида над ними нет — */
    .lead-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:36px; }
    .lead-col { display:grid; gap:16px; align-content:start; }
    .lead-para { margin:0; font-size:var(--fs-body-lg); line-height:1.65; color:var(--text-body); }

    /* — примечание на холсте (без плашки): мера — на самом абзаце — */
    .callout { margin-top:var(--s-32); }
    .callout h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; margin:0 0 10px; color:var(--text-strong); }
    .callout p { margin:0 0 12px; max-width:var(--measure-text); font-size:var(--fs-body); line-height:1.6; color:var(--text-body); }
    .callout p:last-child { margin-bottom:0; }

    /* — таблица групп препаратов (паттерн .mk-table /onkomarkery):
         линии строк — часть структуры таблицы, а не декор перечисления — */
    .table-wrap { overflow-x:auto; border:1px solid var(--border-hairline); border-radius:var(--r-card); background:var(--surface-card); }
    .mk-table { width:100%; border-collapse:collapse; min-width:760px; }
    .mk-table thead th { text-align:left; font-family:var(--ff-body); font-size:var(--fs-caption); font-weight:600; letter-spacing:.01em; color:var(--text-muted); padding:18px 24px; border-bottom:1px solid var(--border-strong); background:var(--surface-mist); }
    .mk-table tbody td { padding:18px 24px; font-size:var(--fs-body-sm); line-height:1.5; color:var(--text-body); border-bottom:1px solid var(--border-hairline); vertical-align:top; }
    .mk-table tbody tr:last-child td { border-bottom:0; }
    .mk-abbr { font-weight:600; color:var(--text-strong); }
    .mk-note { color:var(--text-body); }
    .table-note { margin:18px 0 0; max-width:var(--measure-text); font-size:var(--fs-caption); line-height:1.55; color:var(--text-muted); }

    /* — день лечения: editorial-список с крупными номерами (паттерн PlanSteps),
         БЕЗ разделительных линий между шагами — */
    .plan-list { list-style:none; margin:0; padding:0; }
    .plan-step { display:grid; grid-template-columns:clamp(96px,12vw,170px) minmax(0,1fr); gap:8px 32px; align-items:center; padding-block:14px; }
    .plan-num { font-family:var(--ff-display); font-weight:600; font-size:var(--fs-num-lg); line-height:1; letter-spacing:-.03em; color:var(--accent); font-variant-numeric:tabular-nums; }
    @supports (-webkit-text-stroke: 1px black) {
      .plan-num { color:transparent; -webkit-text-stroke:1.5px var(--accent); }
    }
    /* Контур на мобиле заливаем: обводка 1.5px при мелком кегле съедает цифру */
    @media (max-width:760px) {
      @supports (-webkit-text-stroke: 1px black) {
        .plan-num { color:var(--accent); -webkit-text-stroke:0; }
      }
    }
    .plan-body h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; line-height:1.15; margin:0 0 10px; color:var(--text-strong); }
    .plan-body p { margin:0; max-width:var(--measure-text); font-size:var(--fs-body-lg); line-height:var(--lh-body-lg); color:var(--text-body); }

    /* — editorial-список «заголовок + абзац» (пути введения, между курсами, мифы):
         ни буллитов, ни линий — держит вертикальный ритм — */
    .ed-list { list-style:none; margin:0; padding:0; display:grid; gap:14px; }
    .ed-item h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; line-height:1.2; margin:0 0 8px; color:var(--text-strong); }
    .ed-item p { margin:0; max-width:var(--measure-text); font-size:var(--fs-body); line-height:var(--lh-body); color:var(--text-body); }

    /* — побочные эффекты: ряд ОДИНАКОВЫХ белых карточек — */
    .side-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; }
    .side-card { background:var(--surface-card); border:1px solid var(--border-hairline); border-radius:var(--r-card); padding:28px; }
    .side-card h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; line-height:1.2; margin:0 0 10px; color:var(--text-strong); }
    .side-card p { margin:0; font-size:var(--fs-body-sm); line-height:1.55; color:var(--text-body); }

    /* — «когда звонить»: градиентная плашка + белые карточки внутри (паттерн .rel-tile).
         Заметность даёт градиент и структура, а не иконки-предупреждения — */
    .urg-tile { border-radius:var(--r-card); padding:44px 48px; background:linear-gradient(var(--ang,150deg), var(--g-uni-a), var(--g-uni-b) 55%, var(--g-uni-c)); }
    .urg-head { margin-bottom:32px; }
    .urg-head h2 { font-size:var(--fs-h-lg); letter-spacing:-.025em; font-weight:600; margin:0; max-width:var(--measure-head); }
    .urg-lead { margin:14px 0 0; max-width:var(--measure-lead); font-size:var(--fs-body-lg); line-height:var(--lh-body-lg); color:var(--text-body); }
    .urg-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; margin-bottom:28px; }
    /* карточки внутри градиентной плашки — чисто белые без обводки */
    .urg-card { background:var(--surface-card); border-radius:var(--r-glass); padding:28px 30px; }
    .urg-card h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; line-height:1.2; margin:0 0 16px; color:var(--text-strong); }
    .urg-list { list-style:none; margin:0; padding:0; display:grid; gap:12px; }
    .urg-list li { font-size:var(--fs-body-sm); line-height:1.5; color:var(--text-body); }
    .urg-note { margin:18px 0 0; font-size:var(--fs-caption); line-height:1.55; color:var(--text-body); }
    .urg-cta { display:flex; align-items:center; gap:20px; flex-wrap:wrap; }
    .urg-phone-note { margin:0; max-width:var(--measure-text); font-size:var(--fs-body-sm); line-height:1.5; color:var(--text-body); }

    /* — подготовка: чек-лист (паттерн .prep-list /onkomarkery); иконка без плашки — */
    .prep-list { list-style:none; margin:0; padding:0; display:grid; gap:14px; }
    .prep-item { display:flex; gap:16px; align-items:flex-start; }
    .prep-ic { flex:none; display:inline-flex; color:var(--accent-soft); }
    .prep-ic svg { width:20px; height:20px; }
    .prep-body h3 { font-size:var(--fs-body-lg); font-weight:600; letter-spacing:-.02em; line-height:1.2; color:var(--text-strong); margin:0 0 4px; }
    .prep-body p { margin:0; max-width:var(--measure-text); font-size:var(--fs-body-sm); line-height:1.55; color:var(--text-body); }

    /* — перелинковка: контурные чипы с шевроном (стили чипа — global.css) — */
    .chip-row { list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:12px; }

    /* — FAQ: 1:1 паттерн Faq.astro — статичный список, две колонки, левый край — */
    .faq { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:clamp(32px,5vw,72px); }
    .faq-item { padding:14px 0; }
    .faq-q { font-size:var(--fs-h); font-weight:600; line-height:1.3; letter-spacing:-.01em; color:var(--text-strong); margin:0 0 10px; }
    .faq-a p { font-size:var(--fs-body-sm); line-height:1.6; color:var(--text-body); margin:0; }
    .faq-note { margin:var(--s-24) 0 0; max-width:var(--measure-text); font-size:var(--fs-body-sm); line-height:1.55; color:var(--text-body); }

    /* — CTA + дисклеймер + нормативная плашка — */
    /* Нормативная плашка — единственное разрешённое центрирование текста; сужена */
    /* — reveal (паттерн главной) — */
    .reveal { opacity:0; transform:translateY(18px); transition:opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); transition-delay:var(--d,0s); }
    .reveal.in { opacity:1; transform:none; }
    @media (prefers-reduced-motion:reduce) { .reveal { opacity:1; transform:none; transition:none; } }

    /* — адаптив — */
    @media (max-width:1100px) {
      .side-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
    @media (max-width:960px) {
      .page-title { max-width:none; }
      .lead-grid { grid-template-columns:1fr; gap:16px; }
      .sec-head h2, .urg-head h2 { max-width:none; }
      .faq { grid-template-columns:1fr; }
      .side-grid { grid-template-columns:1fr; }
      .urg-grid { grid-template-columns:1fr; }
      .urg-tile { padding:32px 24px; }
    }
    @media (max-width:720px) {
      .plan-step { grid-template-columns:1fr; gap:4px; }
      .plan-num { font-size:var(--fs-num); }
    }
  </style>

  <script>
    // появление блоков при скролле (паттерн главной)
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</Base>

---
/* ВРЕМЕННАЯ страница — макет og-картинки (1200×630) на реальных шрифтах сайта.
   Скриншотится в public/og.png, после чего файл удаляется. */
import Base from '../layouts/Base.astro';
import { clinic } from '../data/clinic';
---

<Base title="og">
  <div class="og">
    <img src="/images/logo-mark.svg" alt="" class="og-mark" />
    <div class="og-txt">
      <p class="og-name">Клиника трансляционной медицины</p>
      <p class="og-sub">Лекарственное лечение онкологических заболеваний в&nbsp;дневном стационаре</p>
      <p class="og-meta">{clinic.city} · {clinic.addrShort} · ctmedspb.ru</p>
    </div>
  </div>
</Base>

<style>
  :global(body) { margin: 0; }
  .og {
    width: 1200px; height: 630px; box-sizing: border-box;
    background: var(--grad-uni);
    display: flex; align-items: center; gap: 64px;
    padding: 0 96px;
  }
  .og-mark { height: 300px; width: auto; flex: none; }
  .og-name {
    font-family: var(--ff-display); font-weight: 600; font-size: 64px; line-height: 1.1;
    letter-spacing: -.025em; color: var(--text-strong); margin: 0 0 24px; max-width: 14ch;
  }
  .og-sub {
    font-family: var(--ff-body); font-size: 30px; line-height: 1.35; color: var(--text-body);
    margin: 0 0 32px; max-width: 24ch;
  }
  .og-meta { font-family: var(--ff-body); font-size: 22px; color: var(--c-teal-deep); margin: 0; }
</style>

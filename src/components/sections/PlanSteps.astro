---
/* ============================================================
   Экран 2. План действий — editorial-список из 5 шагов.
   Слева крупный контурный номер 01–05 (паттерн /s-chego-nachat),
   справа заголовок + текст + ссылка-стрелка. Между шагами — hairline.
   Контент из docs/ТЗ-главная.md (правки заказчика — docs/тексты-главной.md).
   Заголовки шагов сняты с «Мы…»: пять подряд «Мы изучаем / Мы уточняем…»
   читались как заклинание. Глагол первым, совершенный вид («Изучим»,
   «Уточним») — обещание, а не описание процесса.
   ============================================================ */
const steps = [
  {
    n: '01',
    t: 'Изучим ваши документы',
    p: 'Выписки, результаты биопсии, снимки, стёкла и&nbsp;блоки&nbsp;— всё, что уже есть на&nbsp;руках. Наши специалисты подробно анализируют каждый документ: это работа врача, а&nbsp;не&nbsp;ваша задача.',
    link: 'С&nbsp;чего начать',
    href: '/s-chego-nachat',
  },
  {
    n: '02',
    t: 'Уточним диагноз, если это необходимо',
    p: 'Пересматриваем гистологию в&nbsp;нашей лаборатории. Диагноз при этом не&nbsp;отменяется&nbsp;— уточняется, и&nbsp;иногда уточнение меняет тактику лечения, в&nbsp;том числе в&nbsp;сторону меньшего объёма.',
    link: 'Пересмотр стёкол',
    href: '#',
  },
  {
    n: '03',
    t: 'Расскажем всё о&nbsp;вашей опухоли',
    p: 'Основа&nbsp;— молекулярно-генетические исследования: они показывают конкретные поломки в&nbsp;клетках опухоли. Зная молекулярно-генетическую структуру опухоли, мы&nbsp;подбираем точный препарат.',
    link: 'Молекулярно-генетические исследования',
    href: '#',
  },
  {
    n: '04',
    t: 'Объясним все варианты лечения',
    p: 'Химиотерапия, таргетная и&nbsp;иммунотерапия&nbsp;— наши врачи разбирают, что показано именно в&nbsp;вашей ситуации, чем варианты отличаются друг от&nbsp;друга и&nbsp;почему мы&nbsp;предлагаем именно эту схему.',
    link: 'Лечение',
    href: '#',
  },
  {
    n: '05',
    t: 'Дадим доступ к&nbsp;новым препаратам',
    p: 'Часть современных лекарств становится доступна раньше, чем появляется в&nbsp;продаже,&nbsp;— через клинические исследования, которые мы&nbsp;проводим по&nbsp;стандартам&nbsp;GCP.',
    link: 'Клинические исследования',
    href: '#',
  },
];
---

<section class="sec plan-sec" id="plan">
  <div class="wrap">
    <div class="plan-head">
      <h2>Как мы&nbsp;поможем в&nbsp;вашей ситуации</h2>
      <p class="plan-intro">
        Онкологический диагноз выбивает почву из-под ног. Самим разбираться
        в&nbsp;документах, анализах, точных схемах лечения для жизни&nbsp;—
        это сложный путь. Наша клиника помогает разобраться с&nbsp;каждым
        этапом.
      </p>
    </div>

    <ol class="plan-list">
      {steps.map((s, i) => (
        <li class="plan-step reveal" style={`--d:${(i * 0.08).toFixed(2)}s`}>
          <span class="plan-num" aria-hidden="true">{s.n}</span>
          <div class="plan-body">
            <h3 set:html={s.t} />
            <p set:html={s.p} />
          </div>
          <a class="link-chip plan-link" href={s.href}>
            <span set:html={s.link} /><svg class="chev-r" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </li>
      ))}
    </ol>

    <p class="plan-outro reveal" style="--d:.42s">
      Такой порядок работы позволяет в&nbsp;короткие сроки выбрать оптимальное
      решение в&nbsp;лечении. Мы&nbsp;бережём ваше время и&nbsp;проходим этот
      путь вместе&nbsp;— с&nbsp;<a href="#doctors">нашими врачами</a>
      на&nbsp;каждом шаге.
    </p>
  </div>
</section>

<style>
  .plan-sec { padding-block: var(--section-gap); }

  /* — Шапка секции (паттерн sec-head/kicker главной) — */
  .plan-head { margin-bottom: 16px; }
  .kicker { font-size: var(--fs-caption); letter-spacing: .06em; text-transform: none; color: var(--accent); margin: 0 0 12px; }
  .plan-head h2 { font-size: var(--fs-h-lg); letter-spacing: -.025em; font-weight: 600; margin: 0; max-width: var(--measure-head); }
  .plan-intro { margin: 16px 0 0; max-width: var(--measure-lead); font-size: var(--fs-body-lg); line-height: var(--lh-body-lg); letter-spacing: var(--tr-body-lg); color: var(--text-body); }

  /* — Editorial-список шагов — */
  .plan-list { list-style: none; margin: 0; padding: 0; }
  /* Три колонки: крупный номер | заголовок+текст | ссылка справа */
  .plan-step {
    display: grid;
    grid-template-columns: clamp(96px, 12vw, 170px) minmax(0, 1fr) auto;
    gap: 8px 32px;
    align-items: center;
    padding-block: 14px;
  }

  /* Крупный контурный номер 01–05 (паттерн /s-chego-nachat) */
  .plan-num {
    font-family: var(--ff-display);
    font-weight: 600;
    font-size: var(--fs-num-lg);
    line-height: 1;
    letter-spacing: -.03em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  @supports (-webkit-text-stroke: 1px black) {
    .plan-num { color: transparent; -webkit-text-stroke: 1.5px var(--accent); }
  }

  .plan-body h3 {
    font-size: var(--fs-h);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 10px;
    color: var(--text-strong);
  }
  .plan-body p { margin: 0; max-width: 62ch; color: var(--text-body); }

  /* Ссылка-чип (глобальный .link-chip) — своя колонка справа, по центру ряда */
  .plan-link { justify-self: end; white-space: nowrap; }

  .plan-outro {
    margin: 32px 0 0;
    max-width: var(--measure-text);
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    letter-spacing: var(--tr-body-lg);
    color: var(--text-body);
  }

  /* — Reveal-каскад (паттерн главной: .reveal + --d) — */
  .reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); transition-delay: var(--d, 0s); }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }

  @media (max-width: 720px) {
    .plan-step { grid-template-columns: 1fr; gap: 4px; }
    .plan-num { font-size: var(--fs-num); }
    .plan-link { justify-self: start; margin-top: 12px; }
  }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('.plan-sec .reveal').forEach((el) => io.observe(el));
</script>

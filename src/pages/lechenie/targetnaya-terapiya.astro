---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import FooterContacts from '../../components/sections/FooterContacts.astro';
import PageCta from '../../components/sections/PageCta.astro';
import { clinic } from '../../data/clinic';
import '../../styles/page-article.css';

/* ============================================================
   «Таргетная терапия» — страница раздела «Лечение» (ТЗ, пункт меню 4).
   До этой страницы пункт меню висел заглушкой href="#", а само понятие
   упоминалось на сайте 24 раза и нигде не раскрывалось.

   Сценарий страницы:
   1) hero + крошки + лид «работает там, где мишень есть»;
   2) как это работает — две равные колонки (широкого лида над ними нет);
   3) откуда берётся мишень — справочная таблица методов (паттерн .mk-table);
   4) какие мишени ищут — вторая справочная таблица;
   5) кому подходит — две колонки;
   6) как проходит лечение — две колонки + примечание про стоимость;
   7) побочные эффекты — две колонки;
   8) когда звонить — без плашки, мера на самих абзацах;
   9) резистентность — две колонки;
   10) что взять с собой — две колонки;
   11) мифы — editorial-список;
   12) перелинковка абзацами со ссылками;
   13) FAQ статичным списком;
   14) CTA + нормативная плашка ФЗ-38.

   Текст дословно соответствует утверждённому черновику, который клиника
   вычитывает в Google Docs: расхождение ловится `diff-gdoc.mjs`.
   Конкретика клиники — видимыми заглушками [уточняется у клиники].
   Общие стили страниц раздела — src/styles/page-article.css.
   ============================================================ */

const icon: Record<string, string> = {
  phone: '<path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" fill="currentColor"/>',
};

// — Экран 3. Методы поиска мишени: справочная таблица —
const methods = [
  {
    m: 'Иммуногистохимия (ИГХ)',
    d: 'Окрашивают срез ткани антителами и&nbsp;смотрят, есть&nbsp;ли на&nbsp;клетках нужный белок и&nbsp;сколько его. Быстрый и&nbsp;самый распространённый метод.',
  },
  {
    m: 'ПЦР',
    d: 'Ищет заранее известную мутацию в&nbsp;конкретном гене&nbsp;— точечно и&nbsp;точно, но&nbsp;только то, что искали.',
  },
  {
    m: 'FISH',
    d: 'Показывает перестройки и&nbsp;умножение участков хромосом: например, когда ген не&nbsp;изменён по&nbsp;букве, но&nbsp;его копий стало слишком много.',
  },
  {
    m: 'Секвенирование (NGS)',
    d: 'Читает сразу множество генов за&nbsp;один раз. Дороже и&nbsp;дольше, зато находит редкие мишени, о&nbsp;которых заранее не&nbsp;думали.',
  },
];

// — Экран 4. Частые мишени —
// Названия генов — как в клинических рекомендациях; трактует заключение
// только лечащий врач, таблица нужна, чтобы человек узнал буквы из своей выписки.
const targets = [
  { t: 'EGFR', o: 'Немелкоклеточный рак лёгкого' },
  { t: 'ALK, ROS1', o: 'Немелкоклеточный рак лёгкого, чаще у&nbsp;некурящих' },
  { t: 'HER2', o: 'Рак молочной железы, рак желудка' },
  { t: 'BRAF', o: 'Меланома, реже&nbsp;— щитовидная железа и&nbsp;кишечник' },
  { t: 'KRAS G12C', o: 'Рак лёгкого, рак толстой кишки' },
  { t: 'BRCA1, BRCA2', o: 'Яичники, молочная железа, поджелудочная железа, предстательная железа' },
];

// — Экран 11. Мифы —
const myths = [
  {
    t: '«Таргетная терапия&nbsp;— это лечение без побочных эффектов»',
    p: 'Побочные эффекты есть, просто другие: кожа, давление, печень, кишечник вместо костного мозга и&nbsp;волос. Переносится в&nbsp;среднем легче химиотерапии&nbsp;— но&nbsp;«легче» не&nbsp;равно «никак», и&nbsp;часть эффектов требует лечения и&nbsp;контроля.',
  },
  {
    t: '«Таргетная&nbsp;— значит современнее и&nbsp;лучше химиотерапии»',
    p: 'Это разные инструменты, а&nbsp;не&nbsp;старая и&nbsp;новая версия одного. При опухоли без мишени таргетный препарат не&nbsp;сработает, а&nbsp;химиотерапия сработает. Во&nbsp;многих схемах их назначают вместе, и&nbsp;это даёт лучший результат, чем каждый по&nbsp;отдельности.',
  },
  {
    t: '«Раз мутацию не&nbsp;нашли, лечить нечем»',
    p: 'Отсутствие мишени сужает выбор, но&nbsp;не&nbsp;отменяет лечение: остаются химиотерапия, иммунотерапия, гормональная терапия и&nbsp;их комбинации. Кроме того, набор мишеней, которые умеют искать и&nbsp;лечить, расширяется&nbsp;— и&nbsp;повторное исследование через время иногда меняет картину.',
  },
  {
    t: '«Анализ на&nbsp;мутации лучше сдать заранее, до&nbsp;врача, чтобы не&nbsp;терять время»',
    p: 'Набор исследований зависит от&nbsp;диагноза и&nbsp;от&nbsp;того, что уже известно про опухоль. Сданная наугад широкая панель часто оказывается не&nbsp;той, которая нужна,&nbsp;— а&nbsp;деньги и&nbsp;время уже потрачены. Двадцать минут разговора с&nbsp;врачом до&nbsp;анализа экономят недели после.',
  },
];

// — Экран 13. FAQ —
const faq = [
  {
    q: 'Таргетная терапия&nbsp;— это химиотерапия?',
    a: 'Нет. Химиопрепараты действуют на&nbsp;процесс деления клеток вообще, таргетные&nbsp;— на&nbsp;конкретный сломанный белок внутри опухолевой клетки. Это разные механизмы, разные показания и&nbsp;разные побочные эффекты.',
  },
  {
    q: 'Можно&nbsp;ли назначить таргетный препарат без анализа на&nbsp;мутацию?',
    a: 'Нет. Без подтверждённой мишени препарат назначать не&nbsp;на&nbsp;что: он&nbsp;не&nbsp;подействует. Именно поэтому молекулярное исследование делают до&nbsp;начала лечения, а&nbsp;не&nbsp;после.',
  },
  {
    q: 'Нужно&nbsp;ли делать повторную биопсию ради анализа?',
    a: 'Чаще всего нет. Исследование делают из&nbsp;парафинового блока, который остался после первой биопсии или операции. Повторный забор обсуждают отдельно&nbsp;— например, когда материала мало или когда препарат перестал работать и&nbsp;нужно понять почему.',
  },
  {
    q: 'Сколько ждать результат молекулярного исследования?',
    a: 'Зависит от&nbsp;метода: точечный анализ готовится быстрее широкой панели. Конкретные сроки в&nbsp;нашей лаборатории&nbsp;— [уточняется у&nbsp;клиники].',
  },
  {
    q: 'Таргетные препараты принимают дома?',
    a: 'Большинство&nbsp;— да, это таблетки или капсулы для ежедневного приёма. Часть препаратов вводят внутривенно в&nbsp;дневном стационаре.',
  },
  {
    q: 'Можно&nbsp;ли принимать обычные лекарства и&nbsp;витамины вместе с&nbsp;таргетным препаратом?',
    a: 'Только после разговора с&nbsp;врачом. Многие препараты меняют скорость переработки таргетного лекарства в&nbsp;печени&nbsp;— сюда попадают и&nbsp;зверобой, и&nbsp;грейпфрутовый сок, и&nbsp;некоторые средства от&nbsp;изжоги.',
  },
  {
    q: 'Что делать, если пропустил приём таблетки?',
    a: 'Позвонить врачу и&nbsp;спросить. Правило зависит от&nbsp;конкретного препарата и&nbsp;от&nbsp;того, сколько времени прошло,&nbsp;— универсального ответа нет, а&nbsp;самостоятельное удвоение дозы опасно.',
  },
  {
    q: 'Входит&nbsp;ли таргетная терапия в&nbsp;ОМС?',
    a: '[уточняется у&nbsp;клиники]',
  },
];
---

<Base
  title="Таргетная терапия — Клиника трансляционной медицины"
  description="Как работает таргетная терапия: что такое мишень и откуда её берут, какие мутации ищут, кому подходит лечение, как оно проходит, побочные эффекты, что делать при резистентности, частые вопросы."
>
  <Header current="target" />

  <!-- HERO страницы -->
  <section class="page-hero">
    <div class="blob" style="width:480px;height:480px;background:var(--c-wash-teal);top:-160px;left:-60px;"></div>
    <div class="blob" style="width:420px;height:420px;background:var(--c-wash-blue);top:-80px;right:-40px;"></div>
    <div class="wrap" style="position:relative;z-index:1;">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/lechenie">Лечение</a><span aria-hidden="true">/</span><span>Таргетная терапия</span>
      </nav>
      <div class="page-eyebrow">Лечение</div>
      <h1 class="page-title">Таргетная <em class="i-serif">терапия</em></h1>
      <p class="page-sub">Таргетный препарат бьёт не&nbsp;по&nbsp;всем делящимся клеткам подряд, а&nbsp;по&nbsp;конкретной поломке внутри опухоли. Это не&nbsp;«улучшенная химиотерапия»&nbsp;— это другой принцип действия. И&nbsp;главное следствие из&nbsp;него: <mark>препарат работает там, где мишень действительно есть</mark>, и&nbsp;бесполезен там, где её нет.</p>
      <div class="hero-cta">
        <a href="#contacts" class="btn btn-dark"><svg viewBox="0 0 24 24" class="ic-s" set:html={icon.phone}></svg>Записаться на&nbsp;консультацию</a>
        <a href="/biopsiya#peresmotr" class="btn btn-light">Сдать документы на&nbsp;пересмотр</a>
      </div>
    </div>
  </section>

  <!-- КАК РАБОТАЕТ -->
  <section class="sec" id="how">
    <div class="wrap">
      <div class="sec-head">
        <h2>Как работает таргетная терапия</h2>
      </div>
      <!-- Ровно ДВЕ равные колонки: широкого лида над ними нет (правило меры строки) -->
      <div class="lead-grid">
        <div class="lead-col">
          <p class="lead-para">Опухолевая клетка растёт не&nbsp;«просто так». Обычно в&nbsp;ней есть поломка в&nbsp;гене&nbsp;— мутация, из-за которой белок, отвечающий за&nbsp;деление, застревает во&nbsp;включённом положении. Клетка получает команду делиться и&nbsp;не&nbsp;получает команду остановиться. Такую поломку называют драйверной: она не&nbsp;одна из&nbsp;многих, она ведёт болезнь.</p>
          <p class="lead-para">Таргетный препарат&nbsp;— это молекула, подобранная под конкретный сломанный белок. Она садится на&nbsp;него и&nbsp;выключает сигнал. Слово «таргетный» происходит от&nbsp;английского target, «мишень»: мишень здесь не&nbsp;образ, а&nbsp;вполне конкретный белок, который можно найти в&nbsp;анализе.</p>
        </div>
        <div class="lead-col">
          <p class="lead-para">Отсюда разница с&nbsp;химиотерапией. Химиопрепарат действует на&nbsp;механизм деления вообще&nbsp;— и&nbsp;потому задевает здоровые быстро обновляющиеся ткани: костный мозг, слизистые, волосы. Таргетный препарат вмешивается в&nbsp;один конкретный сигнальный путь. Побочные эффекты у&nbsp;него тоже есть, но&nbsp;другие, и&nbsp;обычно они не&nbsp;про костный мозг и&nbsp;не&nbsp;про волосы.</p>
          <p class="lead-para">Важно не&nbsp;переносить на&nbsp;таргетную терапию слово «сильнее». Она не&nbsp;сильнее&nbsp;— она избирательнее. Для опухоли с&nbsp;подходящей мишенью это огромное преимущество. Для опухоли без мишени такой препарат просто не&nbsp;за&nbsp;что зацепиться, и&nbsp;назначать его бессмысленно.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ОТКУДА БЕРЁТСЯ МИШЕНЬ — справочная таблица методов -->
  <section class="sec" id="target">
    <div class="wrap">
      <div class="sec-head">
        <h2>Откуда берётся мишень</h2>
        <p class="sec-lead">Мишень не&nbsp;видна ни&nbsp;на&nbsp;КТ, ни&nbsp;на&nbsp;УЗИ, ни&nbsp;в&nbsp;анализе крови. Её находят в&nbsp;самой опухолевой ткани&nbsp;— в&nbsp;том материале, который уже взяли при биопсии или операции. Отдельная процедура для этого чаще всего не&nbsp;нужна: исследование делают из&nbsp;парафинового блока, который хранится в&nbsp;лаборатории.</p>
        <p class="sec-lead">Методы разные, и&nbsp;они отвечают на&nbsp;разные вопросы.</p>
      </div>
      <div class="table-wrap">
        <table class="mk-table">
          <thead>
            <tr>
              <th>Что делают</th>
              <th>Что показывает</th>
            </tr>
          </thead>
          <tbody>
            {methods.map((m) => (
              <tr class="reveal">
                <td class="mk-abbr" set:html={m.m} />
                <td class="mk-note" set:html={m.d} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="sec-note">Какой метод нужен&nbsp;— решает не&nbsp;пациент и&nbsp;не&nbsp;прайс, а&nbsp;вопрос, на&nbsp;который надо ответить в&nbsp;конкретной ситуации. Иногда достаточно одного ИГХ, иногда правильнее сразу широкая панель.</p>
      <p class="sec-note">Подробно про сами исследования, сроки и&nbsp;материал мы&nbsp;написали на&nbsp;отдельной странице&nbsp;— <a href="/molekulyarnaya-diagnostika">молекулярно-генетические исследования</a>. Про то, откуда берётся блок и&nbsp;что такое пересмотр стёкол,&nbsp;— на&nbsp;странице про <a href="/biopsiya">биопсию и&nbsp;гистологию</a>.</p>
    </div>
  </section>

  <!-- КАКИЕ МИШЕНИ ИЩУТ -->
  <section class="sec" id="what">
    <div class="wrap">
      <div class="sec-head">
        <h2>Какие мишени ищут чаще всего</h2>
        <p class="sec-lead">Список неполный и&nbsp;постоянно растёт: препараты появляются быстрее, чем обновляются справочники. Ниже&nbsp;— самые частые ситуации, чтобы вы&nbsp;понимали, о&nbsp;чём речь, если увидите эти буквы в&nbsp;своём заключении.</p>
      </div>
      <div class="table-wrap">
        <table class="mk-table">
          <thead>
            <tr>
              <th>Мишень</th>
              <th>Где встречается чаще</th>
            </tr>
          </thead>
          <tbody>
            {targets.map((t) => (
              <tr class="reveal">
                <td class="mk-abbr" set:html={t.t} />
                <td class="mk-note" set:html={t.o} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="sec-note">Буквы в&nbsp;заключении&nbsp;— это названия генов, а&nbsp;не&nbsp;диагноз и&nbsp;не&nbsp;приговор. Одна и&nbsp;та&nbsp;же мишень в&nbsp;разных органах может означать разную тактику, поэтому расшифровывать заключение имеет смысл вместе с&nbsp;врачом, а&nbsp;не&nbsp;сравнивая с&nbsp;чужими историями на&nbsp;форуме.</p>
    </div>
  </section>

  <!-- КОМУ ПОДХОДИТ -->
  <section class="sec" id="who">
    <div class="wrap">
      <div class="sec-head">
        <h2>Кому подходит</h2>
        <p class="sec-lead">Формально ответ короткий: тому, у&nbsp;кого нашли мишень, для которой есть зарегистрированный препарат. На&nbsp;практике за&nbsp;этой фразой стоит несколько условий, и&nbsp;решение принимается по&nbsp;совокупности.</p>
      </div>
      <div class="lead-grid">
        <div class="lead-col">
          <p class="lead-para">Первое&nbsp;— мишень должна быть подтверждена лабораторно. Не&nbsp;«похоже по&nbsp;типу опухоли», а&nbsp;найдена в&nbsp;исследовании.</p>
          <p class="lead-para">Второе&nbsp;— препарат должен подходить именно вашей ситуации: одна и&nbsp;та&nbsp;же мутация при разной стадии и&nbsp;разной предшествующей терапии лечится по-разному.</p>
        </div>
        <div class="lead-col">
          <p class="lead-para">Третье&nbsp;— общее состояние и&nbsp;сопутствующие болезни. Таргетные препараты переносятся легче химиотерапии, но&nbsp;они не&nbsp;безобидны: часть из&nbsp;них влияет на&nbsp;сердце, давление, печень.</p>
          <p class="lead-para">И&nbsp;четвёртое, о&nbsp;чём редко говорят вслух: <mark>отсутствие мишени&nbsp;— это не&nbsp;тупик</mark>. Это означает лишь, что таргетный препарат конкретно здесь не&nbsp;сработает, а&nbsp;лечение выстраивается на&nbsp;других методах&nbsp;— химиотерапии, иммунотерапии или их сочетании. Как именно выбирают метод, <a href="/lechenie">разбираем отдельно</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- КАК ПРОХОДИТ ЛЕЧЕНИЕ -->
  <section class="sec" id="how-taken">
    <div class="wrap">
      <div class="sec-head">
        <h2>Как проходит лечение</h2>
      </div>
      <div class="lead-grid">
        <div class="lead-col">
          <p class="lead-para">Большинство таргетных препаратов&nbsp;— это таблетки или капсулы, которые принимают дома, ежедневно, длительно. Часть препаратов вводится внутривенно в&nbsp;дневном стационаре, с&nbsp;интервалом в&nbsp;несколько недель.</p>
          <p class="lead-para">Ежедневный приём меняет саму логику лечения. Здесь нет «курса», который заканчивается, и&nbsp;нет ощущения, что пройдены три из&nbsp;шести. Препарат работает, пока его принимают, и&nbsp;лечение продолжается до&nbsp;тех пор, пока оно помогает и&nbsp;переносится.</p>
        </div>
        <div class="lead-col">
          <p class="lead-para">Отсюда два практических следствия. Пропуск приёма&nbsp;— не&nbsp;мелочь, а&nbsp;перерыв в&nbsp;лечении, и&nbsp;о&nbsp;пропусках нужно говорить врачу честно. И&nbsp;второе: важна каждая другая таблетка, которую вы&nbsp;принимаете. Многие таргетные препараты конфликтуют с&nbsp;обычными лекарствами и&nbsp;даже с&nbsp;грейпфрутовым соком и&nbsp;зверобоем&nbsp;— они меняют скорость, с&nbsp;которой печень перерабатывает препарат, и&nbsp;доза перестаёт быть той, что назначили.</p>
          <p class="lead-para">Эффект оценивают по&nbsp;контрольным обследованиям, обычно по&nbsp;КТ, через промежутки, которые определяет врач. Между обследованиями ориентироваться на&nbsp;самочувствие можно не&nbsp;всегда: таргетная терапия часто работает тише, чем ожидают.</p>
        </div>
      </div>
      <p class="sec-note">Длительность приёма, схему контроля и&nbsp;стоимость лечения в&nbsp;нашей клинике&nbsp;— [уточняется у&nbsp;клиники].</p>
    </div>
  </section>

  <!-- ПОБОЧНЫЕ ЭФФЕКТЫ -->
  <section class="sec" id="side">
    <div class="wrap">
      <div class="sec-head">
        <h2>Побочные эффекты</h2>
      </div>
      <div class="lead-grid">
        <div class="lead-col">
          <p class="lead-para">Главное, что стоит знать заранее: побочные эффекты у&nbsp;таргетной терапии другие, не&nbsp;такие, как у&nbsp;химиотерапии. Волосы обычно не&nbsp;выпадают, тошнота бывает реже, показатели крови страдают меньше. Зато появляется то, чего при химиотерапии почти не&nbsp;бывает.</p>
          <p class="lead-para">Чаще всего это кожа. Сыпь, похожая на&nbsp;угревую, сухость, трещины на&nbsp;пальцах, воспаление вокруг ногтей, повышенная чувствительность к&nbsp;солнцу. Выглядит неприятно и&nbsp;пугает, но&nbsp;обычно управляется уходом и&nbsp;препаратами&nbsp;— и, что важно, у&nbsp;ряда лекарств сыпь считается признаком того, что препарат работает.</p>
        </div>
        <div class="lead-col">
          <p class="lead-para">Второе по&nbsp;частоте&nbsp;— желудочно-кишечный тракт: диарея, реже тошнота. Третье&nbsp;— повышение артериального давления и&nbsp;нагрузка на&nbsp;сердце у&nbsp;препаратов, влияющих на&nbsp;сосуды опухоли. Отдельно контролируют печень: часть препаратов повышает печёночные показатели, и&nbsp;это видно в&nbsp;анализах раньше, чем по&nbsp;самочувствию.</p>
          <p class="lead-para">Ни&nbsp;один из&nbsp;этих эффектов не&nbsp;повод молча терпеть. Почти для каждого есть либо поддерживающее лечение, либо коррекция дозы. Сопроводительная терапия&nbsp;— не&nbsp;приятное дополнение, а&nbsp;условие того, что вы&nbsp;получите нужную дозу вовремя и&nbsp;лечение не&nbsp;придётся прерывать.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- КОГДА ЗВОНИТЬ — без плашки: перечисление держит вертикальный ритм,
       мера задана на самих абзацах (сняли плашку — вернули меру тексту) -->
  <section class="sec" id="urgent">
    <div class="wrap">
      <div class="sec-head">
        <h2>Когда звонить врачу, не&nbsp;дожидаясь приёма</h2>
        <p class="sec-lead">Есть симптомы, при которых счёт идёт на&nbsp;дни, и&nbsp;ждать планового визита не&nbsp;нужно.</p>
      </div>
      <div class="urg-plain">
        <p>Одышка, которой раньше не&nbsp;было, или сухой кашель, который нарастает,&nbsp;— редкое, но&nbsp;серьёзное осложнение со&nbsp;стороны лёгких, и&nbsp;его нужно исключить быстро.</p>
        <p>Диарея чаще четырёх-пяти раз в&nbsp;сутки или диарея с&nbsp;температурой&nbsp;— это риск обезвоживания, и&nbsp;он выше, чем кажется.</p>
        <p>Сыпь, которая покрывает большую площадь, мокнет или сопровождается температурой. Резкое повышение давления. Желтизна кожи или белков глаз, тёмная моча. Внезапное ухудшение зрения.</p>
      </div>
      <p class="sec-note">Звоните в&nbsp;клинику&nbsp;— {clinic.hours}. Отдельный телефон для связи в&nbsp;период лечения, в&nbsp;том числе в&nbsp;нерабочее время, вам выдают вместе с&nbsp;выпиской после первого курса&nbsp;— [уточняется у&nbsp;клиники].</p>
      <div class="sec-cta">
        <a href={clinic.phoneHref} class="btn btn-dark"><svg viewBox="0 0 24 24" class="ic-s" set:html={icon.phone}></svg>{clinic.phone}</a>
      </div>
    </div>
  </section>

  <!-- РЕЗИСТЕНТНОСТЬ -->
  <section class="sec" id="resist">
    <div class="wrap">
      <div class="sec-head">
        <h2>Если препарат перестал работать</h2>
      </div>
      <div class="lead-grid">
        <div class="lead-col">
          <p class="lead-para">Это происходит с&nbsp;большинством таргетных препаратов рано или поздно, и&nbsp;об&nbsp;этом честнее сказать сразу. Опухоль неоднородна: в&nbsp;ней есть клетки с&nbsp;другими поломками, и&nbsp;со&nbsp;временем они получают преимущество. Препарат продолжает выключать свою мишень, но&nbsp;клетки научились обходиться без неё. Такую ситуацию называют резистентностью, то&nbsp;есть устойчивостью.</p>
          <p class="lead-para">Резистентность&nbsp;— не&nbsp;конец лечения и&nbsp;не&nbsp;ваша вина. Это ожидаемый этап, к&nbsp;которому есть подготовленные ходы.</p>
        </div>
        <div class="lead-col">
          <p class="lead-para">Обычно делают повторное исследование, чтобы понять, какая поломка стала главной теперь. Иногда для этого нужна повторная биопсия, иногда достаточно анализа крови на&nbsp;циркулирующую опухолевую ДНК&nbsp;— обломки ДНК опухоли, которые попадают в&nbsp;кровоток. По&nbsp;результату подбирают препарат следующей линии: для ряда мутаций такие препараты уже существуют именно на&nbsp;этот случай.</p>
          <p class="lead-para">Если подходящего препарата нет, обсуждают другие методы или участие в&nbsp;клиническом исследовании.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ЧТО ВЗЯТЬ С СОБОЙ -->
  <section class="sec" id="prep">
    <div class="wrap">
      <div class="sec-head">
        <h2>Что взять с&nbsp;собой на&nbsp;консультацию</h2>
        <p class="sec-lead">Разговор о&nbsp;таргетной терапии почти целиком строится вокруг лабораторных данных, поэтому чем полнее документы, тем содержательнее будет приём.</p>
      </div>
      <div class="lead-grid">
        <div class="lead-col">
          <p class="lead-para">Возьмите гистологическое заключение и&nbsp;результаты молекулярных исследований, если они уже делались. Если исследований не&nbsp;было, важно знать, где хранится парафиновый блок и&nbsp;стёкла: чаще всего именно из&nbsp;них и&nbsp;делают анализ, и&nbsp;заново брать материал не&nbsp;нужно.</p>
        </div>
        <div class="lead-col">
          <p class="lead-para">Возьмите выписки о&nbsp;предыдущем лечении&nbsp;— какие препараты уже получали и&nbsp;как переносили. И&nbsp;обязательно составьте список всех лекарств, которые принимаете постоянно, включая безрецептурные и&nbsp;травы: как раз здесь чаще всего обнаруживаются конфликты с&nbsp;таргетными препаратами.</p>
        </div>
      </div>
      <p class="sec-note">Полный чек-лист документов мы&nbsp;собрали на&nbsp;странице <a href="/s-chego-nachat">«С&nbsp;чего начать»</a>. Документы можно прислать заранее&nbsp;— врач изучит их до&nbsp;визита.</p>
    </div>
  </section>

  <!-- МИФЫ -->

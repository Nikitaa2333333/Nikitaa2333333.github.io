---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import FooterContacts from '../../components/sections/FooterContacts.astro';
import PageCta from '../../components/sections/PageCta.astro';

/* ============================================================
   «Как выбирается метод лечения» — обзорная страница раздела «Лечение»
   (URL /lechenie). Структура повторяет эталон /onkomarkery: page-hero →
   секции .sec → FAQ статичным списком → CTA + нормативная плашка ФЗ-38.

   Сценарий:
   1) hero + главная мысль «нет одного лучшего лечения, есть подходящее»;
   2) от чего зависит выбор — пять групп факторов (editorial-список);
   3) цель лечения честно: три цели (одинаковые белые плашки) + четыре
      слова, которые пациент услышит (editorial-список);
   4) пять видов лекарственного лечения — ряд ОДИНАКОВЫХ белых плашек,
      «Химиотерапия» среди них — плашка-ссылка на /lechenie/himioterapiya;
   5) роль диагностики — цепочка 01–04 крупными номерами (паттерн PlanSteps);
   6) кто принимает решение — рекомендации, консилиум, исследования;
   7) как это выглядит на практике — схема, цикл, оценка эффекта, линии;
   8) смежные разделы — контурные чипы с шевроном;
   9) FAQ; 10) CTA + нормативка + информационный дисклеймер.

   Клиника занимается ЛЕКАРСТВЕННЫМ лечением в дневном стационаре: хирургия
   и радиотерапия упомянуты как части общего плана, а не как наши услуги.
   Вся конкретика клиники — видимыми заглушками [уточняется у клиники].
   ============================================================ */

const icon: Record<string, string> = {
  phone: '<path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" fill="currentColor"/>',
  video: '<rect x="3" y="6" width="12" height="12" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M15 11l6-3.5v9L15 13z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>',
};

// — Экран 2. От чего зависит выбор: пять групп факторов —
const factors = [
  {
    t: 'Тип и&nbsp;локализация опухоли',
    d: 'Рак молочной железы, рак лёгкого и&nbsp;лимфома лечатся принципиально разными препаратами&nbsp;— даже если у&nbsp;людей похожие жалобы. Отправная точка&nbsp;— что именно за&nbsp;клетки увидел патоморфолог под микроскопом.',
  },
  {
    t: 'Стадия и&nbsp;распространённость',
    d: 'Опухоль в&nbsp;пределах органа, поражённые лимфоузлы и&nbsp;отдалённые метастазы&nbsp;— это три разные задачи. Стадия определяет, идёт ли&nbsp;речь о&nbsp;радикальном лечении или о&nbsp;длительном контроле болезни.',
  },
  {
    t: 'Молекулярный профиль',
    d: 'У&nbsp;части опухолей есть конкретные «поломки»&nbsp;— мутации, перестройки генов, избыток определённых белков на&nbsp;поверхности клеток. Если такая мишень найдена, к&nbsp;ней часто есть препарат, который бьёт точно в&nbsp;неё.',
  },
  {
    t: 'Состояние пациента',
    d: 'Возраст сам по&nbsp;себе решает мало, а&nbsp;вот общее состояние, работа сердца, почек, печени и&nbsp;костного мозга, сопутствующие болезни и&nbsp;уже перенесённое лечение&nbsp;— решают много. Врач оценивает это по&nbsp;шкале общего состояния и&nbsp;по&nbsp;анализам, прежде чем назначить схему.',
  },
  {
    t: 'Цель лечения',
    d: 'Разные цели требуют разной интенсивности и&nbsp;разной готовности мириться с&nbsp;побочными эффектами. О&nbsp;цели говорят вслух, до&nbsp;первого укола.',
  },
];

// — Экран 3. Три цели лечения (одинаковые белые плашки) —
const goals = [
  {
    t: 'Радикальная цель&nbsp;— излечение',
    d: 'Задача&nbsp;— полностью убрать болезнь и&nbsp;не&nbsp;допустить рецидива. Так лечат опухоли на&nbsp;ранних стадиях, а&nbsp;также ряд заболеваний, излечимых даже при распространённом процессе: часть лимфом, герминогенные опухоли, хориокарциному. Лечение проводится в&nbsp;полных дозах и&nbsp;по&nbsp;срокам, потому что недолеченность стоит дороже.',
  },
  {
    t: 'Контроль болезни',
    d: 'Задача&nbsp;— остановить рост опухоли, удержать её в&nbsp;спокойном состоянии и&nbsp;вернуть человеку обычную жизнь на&nbsp;максимально долгий срок. Так работают при метастатическом процессе. Лечение здесь не&nbsp;курс из&nbsp;шести недель, а&nbsp;длительный режим: линии терапии сменяют друг друга по&nbsp;мере необходимости, иногда годами.',
  },
  {
    t: 'Облегчение симптомов',
    d: 'Задача&nbsp;— убрать боль, одышку, слабость, вернуть возможность есть и&nbsp;двигаться. Такое лечение выбирают, когда агрессивная терапия принесёт больше вреда, чем пользы. Это не&nbsp;«отказ от&nbsp;лечения»&nbsp;— это лечение, у&nbsp;которого другая, тоже вполне конкретная цель.',
  },
];

// — Экран 3b. Четыре слова, которые вы услышите —
const terms = [
  {
    t: 'Неоадъювантная терапия',
    d: 'Лекарства до&nbsp;операции или до&nbsp;облучения. Цель&nbsp;— уменьшить опухоль, сделать операцию менее калечащей и&nbsp;заодно увидеть, отвечает ли&nbsp;болезнь на&nbsp;препараты. Ответ опухоли на&nbsp;предоперационное лечение&nbsp;— важная информация о&nbsp;прогнозе.',
  },
  {
    t: 'Адъювантная терапия',
    d: 'Лекарства после радикальной операции или облучения, когда видимой опухоли уже нет. Цель&nbsp;— уничтожить единичные клетки, которые могли остаться, и&nbsp;снизить риск рецидива. Отсюда частый вопрос: «Опухоль удалили, зачем химия?»&nbsp;— именно затем.',
  },
  {
    t: 'Паллиативная терапия',
    d: 'Лечение при распространённом или метастатическом процессе. Цель&nbsp;— продлить жизнь и&nbsp;сохранить её качество. Слово «паллиативная» в&nbsp;онкологии означает не&nbsp;«отказались лечить», а&nbsp;«лечим не&nbsp;для полного удаления опухоли»; активная лекарственная терапия при этом продолжается.',
  },
  {
    t: 'Поддерживающая терапия',
    d: 'Более мягкий режим после того, как основное лечение дало эффект. Цель&nbsp;— удержать достигнутый результат.',
  },
];

// — Экран 4. Пять видов лекарственного лечения.
// Все пять — ОДИНАКОВЫЕ белые плашки; у «Химиотерапии» есть href, поэтому
// плашка рендерится ссылкой с шевроном (вид плашки при этом тот же). —
const kinds = [
  {
    t: 'Химиотерапия',
    d: 'Химиопрепараты действуют на&nbsp;клетки, которые активно делятся, и&nbsp;разрушают механизм их деления. Опухоль делится быстрее здоровых тканей и&nbsp;получает основной удар, но&nbsp;попутно страдают нормальные быстро обновляющиеся клетки: костный мозг, слизистые, волосяные фолликулы. Отсюда знакомый набор побочных эффектов и&nbsp;цикличность: организму нужны перерывы на&nbsp;восстановление. Химиотерапия остаётся основой лечения многих опухолей&nbsp;— в&nbsp;том числе тех, для которых пока нет ни&nbsp;мишени, ни&nbsp;надёжного иммунного ответа.',
    href: '/lechenie/himioterapiya',
    link: 'Подробнее о&nbsp;химиотерапии',
  },
  {
    t: 'Таргетная терапия',
    href: '/lechenie/targetnaya-terapiya',
    link: 'Подробнее о&nbsp;таргетной терапии',
    d: 'Таргетные препараты нацелены на&nbsp;конкретную молекулярную мишень&nbsp;— мутировавший белок, рецептор роста, сосуды опухоли. Они не&nbsp;«сильнее» химиотерапии, они точнее: работают там, где эта мишень действительно есть, и&nbsp;не&nbsp;работают там, где её нет. Поэтому таргетную терапию назначают по&nbsp;результату молекулярного исследования, а&nbsp;не&nbsp;по&nbsp;названию диагноза. Побочные эффекты у&nbsp;них другие&nbsp;— чаще кожа, давление, слизистые.',
  },
  {
    t: 'Иммунотерапия',
    href: '/lechenie/immunoterapiya',
    link: 'Подробнее об&nbsp;иммунотерапии',
    d: 'Иммунотерапия действует не&nbsp;на&nbsp;опухоль напрямую, а&nbsp;на&nbsp;иммунную систему: снимает «тормоза», которыми опухоль защищается от&nbsp;Т-лимфоцитов, и&nbsp;позволяет собственному иммунитету её распознать. Работает не&nbsp;у&nbsp;всех&nbsp;— вероятность ответа оценивают по&nbsp;специальным маркёрам в&nbsp;опухолевой ткани. Зато у&nbsp;тех, у&nbsp;кого сработала, эффект бывает очень стойким. Побочные эффекты здесь иммунные: организм может начать атаковать свои&nbsp;же органы, поэтому о&nbsp;любом новом симптоме нужно сообщать сразу.',
  },
  {
    t: 'Гормональная (эндокринная) терапия',
    d: 'Часть опухолей&nbsp;— прежде всего рак молочной железы и&nbsp;рак предстательной железы&nbsp;— растёт под действием собственных гормонов. Эндокринная терапия перекрывает эту подпитку: снижает уровень гормона или блокирует рецептор, через который сигнал доходит до&nbsp;клетки. Это таблетки или инъекции, обычно долгие&nbsp;— месяцы и&nbsp;годы, а&nbsp;переносимость заметно легче, чем у&nbsp;химиотерапии. Назначают её только при гормонозависимой опухоли, что определяют иммуногистохимическим исследованием.',
  },
  {
    t: 'Сопроводительная терапия',
    d: 'Лечение, которое обеспечивает возможность основного: противотошнотные препараты, стимуляторы кроветворения, коррекция анемии, обезболивание, защита костей, питательная поддержка, уход за&nbsp;венозным доступом. Её роль часто недооценивают, а&nbsp;именно она определяет, сможете ли&nbsp;вы&nbsp;получить полную дозу вовремя. Снижение дозы и&nbsp;сдвиг курсов из-за побочных эффектов ухудшают результат, поэтому сопроводительную терапию мы&nbsp;назначаем заранее, а&nbsp;не&nbsp;«когда станет плохо».',
  },
];

// — Экран 5. Цепочка «от стекла до препарата»: 01–04 крупными номерами —
const chain = [
  {
    n: '01',
    t: 'Гистология&nbsp;— что это за&nbsp;клетки',
    p: 'Патоморфолог смотрит фрагмент ткани, полученный при биопсии или операции, и&nbsp;определяет тип опухоли и&nbsp;степень её злокачественности. Это фундамент: без морфологического подтверждения противоопухолевое лечение не&nbsp;начинают.',
    link: 'Биопсия и&nbsp;гистология',
    href: '/biopsiya',
  },
  {
    n: '02',
    t: 'Иммуногистохимия&nbsp;— какие белки на&nbsp;клетках',
    p: 'Специальные окрашивания показывают, есть ли&nbsp;на&nbsp;клетках рецепторы гормонов, избыток HER2-белка, маркёры, по&nbsp;которым различают близкие типы опухолей. От&nbsp;этого напрямую зависит, обсуждать ли&nbsp;гормональную терапию и&nbsp;анти-HER2-препараты.',
  },
  {
    n: '03',
    t: 'Молекулярный профиль&nbsp;— есть ли&nbsp;мишень',
    p: 'Опухолевую ДНК проверяют на&nbsp;конкретные мутации и&nbsp;перестройки. Найденная мутация&nbsp;— это не&nbsp;приговор и&nbsp;не&nbsp;диагноз, а&nbsp;адрес: к&nbsp;части таких поломок уже существуют препараты, которые действуют именно по&nbsp;ним. Набор исследований зависит от&nbsp;типа опухоли, полный список доступных в&nbsp;клинике методов&nbsp;— [уточняется у&nbsp;клиники].',
    link: 'Молекулярно-генетические исследования',
    href: '/molekulyarnaya-diagnostika',
  },
  {
    n: '04',
    t: 'Оценка организма, а&nbsp;не&nbsp;только опухоли',
    p: 'Параллельно смотрят анализы крови, работу почек и&nbsp;печени, сердце, при необходимости&nbsp;— консультации профильных специалистов. Это нужно, чтобы выбрать не&nbsp;только эффективную, но&nbsp;и&nbsp;переносимую схему.',
  },
];

// — Экран 6. Три опоры решения о лечении (одинаковые белые плашки) —
const pillars = [
  {
    t: 'Клинические рекомендации',
    d: 'Схемы лечения описаны в&nbsp;клинических рекомендациях Минздрава&nbsp;РФ и&nbsp;практических рекомендациях профессиональных сообществ&nbsp;— российского RUSSCO, международных ESMO и&nbsp;NCCN. Это не&nbsp;сборник инструкций «на&nbsp;всех», а&nbsp;свод доказанного: какие препараты при какой ситуации дают результат, в&nbsp;каких дозах, сколько циклов. Отклонение возможно, но&nbsp;оно должно быть обосновано и&nbsp;зафиксировано.',
  },
  {
    t: 'Консилиум',
    d: 'Тактику лечения при онкологическом заболевании устанавливает консилиум врачей: по&nbsp;действующему порядку оказания помощи в&nbsp;него входят онкологи и&nbsp;радиотерапевт, при необходимости привлекают других специалистов. Решение оформляется протоколом и&nbsp;вносится в&nbsp;вашу медицинскую документацию&nbsp;— вы&nbsp;имеете право его получить. При смене метода лечения консилиум собирают заново. Состав и&nbsp;порядок работы консилиума у&nbsp;нас&nbsp;— [уточняется у&nbsp;клиники].',
  },
  {
    t: 'Клинические исследования',
    d: 'Для части пациентов участие в&nbsp;клиническом исследовании&nbsp;— это доступ к&nbsp;препарату, которого пока нет в&nbsp;рутинной практике. Это не&nbsp;эксперимент «наугад»: исследования идут по&nbsp;международному стандарту GCP, с&nbsp;одобрением этического комитета, письменным информированным согласием и&nbsp;правом выйти в&nbsp;любой момент без потери права на&nbsp;обычное лечение. Актуальный перечень&nbsp;— [уточняется у&nbsp;клиники].',
  },
];

// — Экран 7. Как это выглядит на практике —
const practice = [
  {
    t: 'Схема и&nbsp;цикл',
    d: 'Лечение назначают не&nbsp;«курсом капельниц», а&nbsp;конкретной схемой: набор препаратов, дозы, дни введения и&nbsp;интервал. Цикл&nbsp;— это отрезок от&nbsp;начала одного введения до&nbsp;начала следующего, чаще всего 1, 2 или 3&nbsp;недели. Перерыв внутри цикла&nbsp;— рабочая часть лечения: за&nbsp;это время восстанавливаются костный мозг и&nbsp;слизистые. Схему и&nbsp;число циклов вам называют заранее, вместе с&nbsp;примерным расписанием.',
  },
  {
    t: 'Как оценивают эффект',
    d: 'Эффект оценивают по&nbsp;контрольным обследованиям&nbsp;— обычно КТ или МРТ тех&nbsp;же зон, что и&nbsp;до&nbsp;лечения, чтобы результаты можно было сравнить. Делают их не&nbsp;после каждого цикла, а&nbsp;примерно каждые 6–12&nbsp;недель, то&nbsp;есть после 2–3&nbsp;циклов. Ответ описывают стандартизованными критериями RECIST: полный ответ&nbsp;— очаги исчезли; частичный&nbsp;— сумма размеров уменьшилась на&nbsp;30&nbsp;% и&nbsp;более; стабилизация&nbsp;— существенных изменений нет; прогрессирование&nbsp;— рост на&nbsp;20&nbsp;% и&nbsp;более или новые очаги.',
  },
  {
    t: 'Стабилизация&nbsp;— это результат',
    d: 'При метастатическом процессе <mark>стабилизация&nbsp;— хороший результат</mark>, а&nbsp;не&nbsp;«лечение не&nbsp;работает». Задача такого лечения&nbsp;— удерживать болезнь под контролем, и&nbsp;отсутствие роста означает, что схема справляется.',
  },
  {
    t: 'Самочувствие&nbsp;— не&nbsp;показатель эффекта',
    d: 'Ни&nbsp;тошнота, ни&nbsp;её отсутствие ничего не&nbsp;говорят о&nbsp;том, работает ли&nbsp;лечение. Люди с&nbsp;тяжёлой переносимостью бывают в&nbsp;полной ремиссии, и&nbsp;наоборот. Судить об&nbsp;эффекте по&nbsp;побочным эффектам&nbsp;— распространённая и&nbsp;мучительная ошибка.',
  },
  {
    t: 'Смена линии терапии',
    d: 'Если опухоль перестала отвечать или лечение стало непереносимым, схему меняют&nbsp;— это называется переходом на&nbsp;следующую линию терапии. Смена линии заранее заложена в&nbsp;план и&nbsp;не&nbsp;означает, что что-то пошло не&nbsp;так или что «время упущено». Перед сменой метода лечения решение снова принимает консилиум. Сколько линий возможно в&nbsp;вашей ситуации&nbsp;— вопрос, который стоит задать врачу прямо.',
  },
  {
    t: 'Дозы и&nbsp;сдвиги расписания',
    d: 'При выраженных побочных эффектах дозу могут снизить или курс отложить&nbsp;— так предусмотрено рекомендациями, и&nbsp;это способ дойти до&nbsp;конца лечения, а&nbsp;не&nbsp;признак неудачи. Обратное тоже верно: без причины дозу не&nbsp;снижают и&nbsp;курс не&nbsp;сдвигают, потому что интенсивность лечения влияет на&nbsp;результат.',
  },
  {
    t: 'Ваше право на&nbsp;второе мнение',
    d: 'Вы&nbsp;имеете право на&nbsp;консультацию другого врача и&nbsp;на&nbsp;второе мнение по&nbsp;морфологии&nbsp;— пересмотр стёкол независимым патоморфологом. Расхождения в&nbsp;гистологических заключениях случаются, и&nbsp;они меняют лечение. Просьба о&nbsp;втором мнении&nbsp;— не&nbsp;недоверие и&nbsp;не&nbsp;конфликт. Также вы&nbsp;вправе получить копии всех своих медицинских документов, включая протокол консилиума.',
  },
];

// — Экран 8. Смежные разделы (контурные чипы с шевроном) —
const related = [
  { t: 'Химиотерапия', href: '/lechenie/himioterapiya' },
  { t: 'Биопсия и&nbsp;гистология', href: '/biopsiya' },
  { t: 'Молекулярно-генетические исследования', href: '/molekulyarnaya-diagnostika' },
  { t: 'Онкомаркеры', href: '/onkomarkery' },
  { t: 'Наши врачи', href: '/vrachi' },
  { t: 'Цены', href: '/stoimost' },
  { t: 'С&nbsp;чего начать', href: '/s-chego-nachat' },
];

// — Экран 9. FAQ (статичный список, паттерн Faq.astro) —
const faq = [
  {
    q: 'Можно ли&nbsp;начать лечение сразу, без всех этих исследований?',
    a: 'Морфологическое подтверждение диагноза нужно всегда: без него неизвестно, что лечить. Молекулярные исследования занимают время, и&nbsp;иногда лечение начинают, не&nbsp;дожидаясь их результата,&nbsp;— если ситуация не&nbsp;позволяет ждать. Тогда первую схему выбирают из&nbsp;тех, что работают независимо от&nbsp;мутаций, а&nbsp;результат исследования учитывают при следующем шаге. Что возможно именно в&nbsp;вашем случае, скажет врач на&nbsp;консультации.',
  },
  {
    q: 'Химиотерапия&nbsp;— это устаревшее лечение?',
    a: 'Нет. Таргетная и&nbsp;иммунотерапия расширили возможности, но&nbsp;не&nbsp;заменили химиотерапию: для многих опухолей мишени просто не&nbsp;найдено, а&nbsp;во&nbsp;многих схемах химиопрепараты работают вместе с&nbsp;новыми&nbsp;— например, химиотерапия плюс иммунотерапия. Химиотерапия остаётся основой лечения целого ряда заболеваний, в&nbsp;том числе излечимых.',
  },
  {
    q: 'Почему одному назначают таблетки, а&nbsp;другому капельницы?',
    a: 'Потому что это разные препараты с&nbsp;разным механизмом. Форма выпуска не&nbsp;показатель «силы»: гормональная и&nbsp;часть таргетной терапии&nbsp;— таблетки, которые принимают годами и&nbsp;которые при своей опухоли эффективнее любой капельницы. И&nbsp;наоборот.',
  },
  {
    q: 'Мне сказали «стадия&nbsp;IV». Лечение вообще имеет смысл?',
    a: 'Да. При IV&nbsp;стадии цель лечения обычно не&nbsp;полное удаление опухоли, а&nbsp;контроль болезни: остановить рост, снять симптомы, вернуть человеку работоспособность и&nbsp;время. Для части заболеваний речь идёт о&nbsp;годах жизни при сохранном самочувствии. Конкретный прогноз зависит от&nbsp;типа опухоли и&nbsp;молекулярного профиля, и&nbsp;обсуждать его нужно с&nbsp;врачом по&nbsp;вашим документам, а&nbsp;не&nbsp;по&nbsp;общим цифрам из&nbsp;интернета.',
  },
  {
    q: 'Опухоль удалили полностью. Зачем ещё лекарства?',
    a: 'Это адъювантная терапия. Её задача&nbsp;— уничтожить единичные опухолевые клетки, которые могли разойтись по&nbsp;организму до&nbsp;операции и&nbsp;которые не&nbsp;видны ни&nbsp;на&nbsp;КТ, ни&nbsp;глазом хирурга. Назначают её не&nbsp;всем: показания зависят от&nbsp;типа опухоли, стадии и&nbsp;риска рецидива.',
  },
  {
    q: 'Можно ли&nbsp;отказаться от&nbsp;части лечения или выбрать «что-нибудь помягче»?',
    a: 'Отказаться вы&nbsp;вправе&nbsp;— это ваше законное право, и&nbsp;врач обязан объяснить последствия без давления. Но&nbsp;«помягче» имеет цену: при радикальной цели лечения снижение интенсивности уменьшает шанс на&nbsp;излечение. Если причина отказа&nbsp;— страх побочных эффектов, скажите об&nbsp;этом прямо: у&nbsp;большинства побочных эффектов есть управляемые решения.',
  },
  {
    q: 'Как понять, что лечение работает, если я&nbsp;не&nbsp;чувствую разницы?',
    a: 'По&nbsp;контрольным обследованиям, обычно каждые 6–12&nbsp;недель. Самочувствие&nbsp;— плохой индикатор: опухоль может уменьшаться при тяжёлой переносимости и&nbsp;расти при отличной. Именно поэтому контрольные КТ или МРТ делают по&nbsp;расписанию, а&nbsp;не&nbsp;по&nbsp;ощущениям.',
  },
  {
    q: 'Сколько стоит консультация и&nbsp;лечение? Работаете ли&nbsp;вы&nbsp;по&nbsp;ОМС или ДМС?',
    stub: '(Уточняется у&nbsp;клиники: стоимость первичной консультации и&nbsp;схем лечения, условия работы по&nbsp;ОМС и&nbsp;ДМС. Актуальный прейскурант&nbsp;— в&nbsp;разделе «Цены».)',
  },
];
---

<Base
  title="Как выбирается метод лечения — Клиника трансляционной медицины"
  description="От чего зависит выбор схемы: тип опухоли, стадия, молекулярный профиль, состояние пациента и цель лечения. Пять видов лекарственной терапии, роль диагностики, консилиум."
>
  <Header current="lechenie-obzor" />

  <!-- HERO страницы -->
  <section class="page-hero">
    <div class="blob" style="width:480px;height:480px;background:var(--c-wash-teal);top:-160px;left:-60px;"></div>
    <div class="blob" style="width:420px;height:420px;background:var(--c-wash-blue);top:-80px;right:-40px;"></div>
    <div class="wrap" style="position:relative;z-index:1;">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span aria-hidden="true">/</span><span>Лечение</span>
      </nav>
      <div class="page-eyebrow">Лечение</div>
      <h1 class="page-title">Как выбирается <em class="i-serif">метод</em> лечения</h1>
      <p class="page-sub">Не&nbsp;существует одного «лучшего» лечения от&nbsp;рака. Есть лечение, которое подходит именно вашей опухоли и&nbsp;именно вам. Схему подбирают под конкретные данные&nbsp;— и&nbsp;пока этих данных нет, честного ответа на&nbsp;вопрос «чем меня будут лечить» тоже нет.</p>
      <div class="hero-cta">
        <a href="#contacts" class="btn btn-dark"><svg viewBox="0 0 24 24" class="ic-s" set:html={icon.phone}></svg>Записаться на&nbsp;консультацию</a>
        <a href="#types" class="btn btn-light">Виды лечения</a>
      </div>
    </div>
  </section>

  <!-- ОТ ЧЕГО ЗАВИСИТ ВЫБОР -->
  <section class="sec" id="factors">
    <div class="wrap">
      <div class="sec-head">
        <h2>От&nbsp;чего зависит выбор схемы</h2>
        <p class="sec-lead">На&nbsp;решение врача влияет пять групп факторов. Ни&nbsp;один из&nbsp;них не&nbsp;работает в&nbsp;одиночку: схему собирают из&nbsp;всех пяти сразу.</p>
      </div>
      <ul class="ed-list">
        {factors.map((f, i) => (
          <li class="ed-item reveal" style={`--d:${(i * 0.06).toFixed(2)}s`}>
            <h3 set:html={f.t} />
            <p set:html={f.d} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ЦЕЛЬ ЛЕЧЕНИЯ -->
  <section class="sec" id="goal">
    <div class="wrap">
      <div class="sec-head">
        <h2>Какая цель у&nbsp;лечения</h2>
        <p class="sec-lead">Это самый неудобный и&nbsp;самый важный разговор. Мы&nbsp;считаем, что пациент имеет право знать, на&nbsp;что рассчитывает врач, и&nbsp;не&nbsp;строить догадки по&nbsp;интонации.</p>
      </div>
      <div class="card-grid">
        {goals.map((g, i) => (
          <article class="tile reveal" style={`--d:${(i * 0.08).toFixed(2)}s`}>
            <h3 set:html={g.t} />
            <p set:html={g.d} />
          </article>
        ))}
      </div>

      <div class="sub-block">
        <h3 class="sub-title">Четыре слова, которые вы&nbsp;услышите</h3>
        <ul class="ed-list">
          {terms.map((t) => (
            <li class="ed-item">
              <h4 set:html={t.t} />
              <p set:html={t.d} />
            </li>
          ))}
        </ul>
      </div>

      <div class="callout">
        <p>Цель лечения может измениться&nbsp;— в&nbsp;обе стороны. Опухоль, которая хорошо ответила на&nbsp;предоперационную терапию, иногда становится операбельной. Это нормальный ход дела, а&nbsp;не&nbsp;«врачи передумали».</p>
      </div>
    </div>
  </section>

  <!-- ПЯТЬ ВИДОВ ЛЕКАРСТВЕННОГО ЛЕЧЕНИЯ -->
  <section class="sec" id="types">
    <div class="wrap">
      <div class="sec-head">
        <h2>Пять видов лекарственного лечения</h2>
        <p class="sec-lead">Противоопухолевая лекарственная терапия&nbsp;— это не&nbsp;только химиотерапия. Их часто комбинируют: выбор&nbsp;— не&nbsp;«или-или», а&nbsp;вопрос, что в&nbsp;вашем случае работает и&nbsp;в&nbsp;каком порядке.</p>
      </div>
      <div class="card-grid">
        {kinds.map((k, i) => (
          k.href ? (
            <a class="tile reveal" href={k.href} style={`--d:${(i * 0.06).toFixed(2)}s`}>
              <h3 set:html={k.t} />
              <p set:html={k.d} />
              <span class="tile-link"><span set:html={k.link} /><svg class="chev-r" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </a>
          ) : (
            <article class="tile reveal" style={`--d:${(i * 0.06).toFixed(2)}s`}>
              <h3 set:html={k.t} />
              <p set:html={k.d} />
            </article>
          )
        ))}
      </div>

      <div class="callout">
        <p>Хирургия и&nbsp;лучевая терапия&nbsp;— тоже части плана лечения, и&nbsp;о&nbsp;них с&nbsp;вами говорят на&nbsp;консилиуме. Наша клиника занимается лекарственным лечением в&nbsp;дневном стационаре; при необходимости в&nbsp;операции или облучении мы&nbsp;работаем в&nbsp;связке с&nbsp;профильными центрами [уточняется у&nbsp;клиники].</p>
      </div>
    </div>
  </section>

  <!-- РОЛЬ ДИАГНОСТИКИ: ОТ СТЕКЛА ДО ПРЕПАРАТА -->
  <section class="sec" id="diagnostics">
    <div class="wrap">
      <div class="sec-head">
        <h2>Почему без диагностики нельзя назначить лечение</h2>
        <p class="sec-lead">Лекарство выбирают не&nbsp;по&nbsp;локализации опухоли, а&nbsp;по&nbsp;её биологии. Путь от&nbsp;«нашли опухоль» до&nbsp;«назначили конкретный препарат» проходит через несколько уровней исследований.</p>
      </div>

      <ol class="chain-list">
        {chain.map((c, i) => (
          <li class="chain-step reveal" style={`--d:${(i * 0.08).toFixed(2)}s`}>
            <span class="chain-num" aria-hidden="true">{c.n}</span>
            <div class="chain-body">
              <h3 set:html={c.t} />
              <p set:html={c.p} />
            </div>
            {c.link && (
              <a class="link-chip chain-link" href={c.href}>
                <span set:html={c.link} /><svg class="chev-r" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            )}
          </li>
        ))}
      </ol>

      <p class="chain-result"><mark>Сначала диагноз, потом мишень, и&nbsp;только потом препарат.</mark></p>

      <div class="callout">
        <p>Часть исследований выполняется по&nbsp;уже имеющемуся у&nbsp;вас материалу&nbsp;— стёклам и&nbsp;блокам после биопсии или операции. Их не&nbsp;нужно делать заново: привезите то, что есть, и&nbsp;заключения. Если качество материала не&nbsp;позволяет провести исследование, врач скажет об&nbsp;этом прямо и&nbsp;объяснит, что делать. Подробности&nbsp;— в&nbsp;разделах <a href="/biopsiya">«Биопсия и&nbsp;гистология»</a> и&nbsp;<a href="/molekulyarnaya-diagnostika">«Молекулярно-генетические исследования»</a>.</p>
      </div>
    </div>
  </section>

  <!-- КТО И КАК ПРИНИМАЕТ РЕШЕНИЕ -->
  <section class="sec" id="decision">
    <div class="wrap">
      <div class="sec-head">
        <h2>Кто и&nbsp;как принимает решение о&nbsp;лечении</h2>
        <p class="sec-lead">Решение не&nbsp;принимается одним врачом в&nbsp;одиночку и&nbsp;не&nbsp;выводится «по&nbsp;опыту». У&nbsp;него есть три опоры.</p>
      </div>
      <div class="card-grid">
        {pillars.map((p, i) => (
          <article class="tile reveal" style={`--d:${(i * 0.08).toFixed(2)}s`}>
            <h3 set:html={p.t} />
            <p set:html={p.d} />
          </article>
        ))}
      </div>
      <p class="sec-note">Лечит вас не&nbsp;протокол, а&nbsp;врач&nbsp;— <a href="/vrachi">наши онкологи</a> разбирают документы, объясняют варианты и&nbsp;ведут вас на&nbsp;всём пути.</p>
    </div>
  </section>

  <!-- КАК ЭТО ВЫГЛЯДИТ НА ПРАКТИКЕ -->
  <section class="sec" id="practice">
    <div class="wrap">
      <div class="sec-head">
        <h2>Как всё это выглядит на&nbsp;практике</h2>
        <p class="sec-lead">Несколько понятий, которые снимают большую часть тревоги: если знать, как устроен цикл и&nbsp;как оценивают эффект, лечение перестаёт быть чёрным ящиком.</p>
      </div>
      <ul class="ed-list">
        {practice.map((p, i) => (
          <li class="ed-item reveal" style={`--d:${(i * 0.05).toFixed(2)}s`}>
            <h3 set:html={p.t} />
            <p set:html={p.d} />
          </li>
        ))}
      </ul>

      <div class="callout">
        <p>Приходите на&nbsp;приём с&nbsp;вопросами, записанными заранее, и&nbsp;по&nbsp;возможности с&nbsp;близким человеком: вдвоём запоминается больше. Хорошие вопросы: какая цель у&nbsp;лечения, какой план на&nbsp;ближайшие месяцы, когда и&nbsp;как оценим эффект, каких побочных эффектов ждать, в&nbsp;каких случаях звонить немедленно.</p>
      </div>
    </div>
  </section>

  <!-- СМЕЖНЫЕ РАЗДЕЛЫ -->
  <section class="sec" id="related">
    <div class="wrap">
      <div class="sec-head">
        <h2>Куда идти дальше</h2>
        <p class="sec-lead">Разделы, которые продолжают эту страницу: диагностика, из&nbsp;которой берутся данные для выбора схемы, и&nbsp;практическая часть лечения.</p>
      </div>
      <div class="chip-row">
        {related.map((r) => (
          <a class="link-chip" href={r.href}>
            <span set:html={r.t} /><svg class="chev-r" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ — статичный список (паттерн Faq.astro): вопрос-заголовок и ответ
       видны сразу, две равные колонки, левый край. Аккордеонов нет нигде. -->
  <section class="wrap sec faq-sec" id="faq">
    <div class="sec-head">
      <h2>Частые вопросы</h2>
    </div>
    <div class="faq">
      {faq.map((item) => (
        <div class="faq-item">
          <h3 class="faq-q" set:html={item.q} />
          <div class="faq-a">
            {item.a && <p set:html={item.a} />}
            {item.stub && <p class="faq-stub" set:html={item.stub} />}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA + НОРМАТИВНАЯ ПЛАШКА -->
  <PageCta
    title="Разберём ваши документы и&nbsp;объясним варианты"
    text="Принесите выписки, результаты биопсии и&nbsp;молекулярных исследований, снимки, стёкла и&nbsp;блоки&nbsp;— всё, что есть на&nbsp;руках. Врач-онколог разберёт материал, назовёт цель лечения и&nbsp;объяснит, какие схемы обсуждаются именно в&nbsp;вашей ситуации."
    note="Материал носит информационный характер и&nbsp;не&nbsp;заменяет консультацию врача. Решение о&nbsp;лечении принимается по&nbsp;результатам обследования."
  />


  <!-- КОНТАКТЫ + ПОДВАЛ -->
  <FooterContacts />

  <style is:global>
    /* Кнопки/шапка — в global.css и Header.astro; здесь только раскладка страницы */

    /* — hero страницы (паттерн page-hero эталона /onkomarkery) — */
    .page-hero { position:relative; overflow:hidden; background:var(--grad-uni); padding-block:52px 46px; }
    .crumbs { display:flex; align-items:center; gap:10px; font-size:var(--fs-caption); color:var(--text-muted); margin:0 0 20px; flex-wrap:wrap; }
    .crumbs a { color:var(--accent-soft); }
    .crumbs a:hover { color:var(--accent); }
    .page-eyebrow { font-size:var(--fs-caption); font-weight:600; letter-spacing:.02em; color:var(--accent); margin:0 0 14px; }
    .page-sub { font-size:var(--fs-sub); line-height:1.55; color:var(--text-body); max-width:var(--measure-lead); margin:0 0 30px; }
    .hero-cta { display:flex; gap:14px; flex-wrap:wrap; }

    /* — секции — */
    .sec { padding-block:var(--section-gap); }
    .sec-head { margin-bottom:var(--head-gap); }
    .sec-head h2 { font-size:var(--fs-h-lg); letter-spacing:-.025em; font-weight:600; margin:0; max-width:var(--measure-head); }
    .sec-lead { margin:16px 0 0; max-width:var(--measure-lead); font-size:var(--fs-body-lg); line-height:var(--lh-body-lg); letter-spacing:var(--tr-body-lg); color:var(--text-body); }
    .sec-note { margin:var(--s-24) 0 0; max-width:var(--measure-text); font-size:var(--fs-body-lg); line-height:var(--lh-body-lg); color:var(--text-body); }
    /* Ссылки внутри наборного текста (акцент + подчёркивание) — в global.css,
       единым правилом для всего сайта; per-page их не переопределяем. */

    /* — editorial-список: заголовок пункта + текст. Ни буллитов, ни линий —
         пункты держит вертикальный ритм (14px), мера — на самом абзаце. — */
    .ed-list { list-style:none; margin:0; padding:0; display:grid; gap:14px; }
    .ed-item h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; line-height:1.2; color:var(--text-strong); margin:0 0 8px; }
    /* h4 — вложенный уровень внутри .sub-block: ступенью ниже своего .sub-title */
    .ed-item h4 { font-size:var(--fs-body-lg); font-weight:600; letter-spacing:-.02em; line-height:1.2; color:var(--text-strong); margin:0 0 4px; }
    .ed-item p { margin:0; max-width:var(--measure-text); font-size:var(--fs-body); line-height:var(--lh-body); color:var(--text-body); }

    /* — вложенный блок внутри секции (подзаголовок + свой список) — */
    .sub-block { margin-top:var(--s-40); }
    .sub-title { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; line-height:1.2; color:var(--text-strong); margin:0 0 var(--s-16); }

    /* — ряд ОДИНАКОВЫХ белых плашек: один и тот же вид у всех, в том числе
         у плашки-ссылки (меняется только строка «Подробнее» внутри). — */
    .card-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; }
    .tile { display:block; background:var(--surface-card); border:1px solid var(--border-hairline); border-radius:var(--r-card); padding:28px 30px; }
    .tile h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; line-height:1.2; margin:0 0 10px; color:var(--text-strong); }
    .tile p { margin:0; font-size:var(--fs-body-sm); line-height:var(--lh-body-sm); color:var(--text-body); }
    /* hover не меняет плашку — красится только ссылка внутри */
    .tile-link { display:inline-flex; align-items:center; gap:4px; margin-top:16px; font-size:var(--fs-body-sm); font-weight:600; color:var(--accent-soft); }
    .tile-link .chev-r { width:16px; height:16px; }
    a.tile:hover .tile-link { color:var(--accent); }

    /* — примечание на холсте (без плашки, как в эталоне): мера — на самом абзаце.
         Плашку не ставим: белых плашек в ряду выше уже достаточно. — */
    .callout { margin-top:var(--s-32); }
    .callout h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; margin:0 0 10px; color:var(--text-strong); }
    .callout p { margin:0 0 12px; max-width:var(--measure-text); font-size:var(--fs-body); line-height:1.6; color:var(--text-body); }
    .callout p:last-child { margin-bottom:0; }

    /* — цепочка «от стекла до препарата»: крупные номера 01–04
         (паттерн PlanSteps.astro), без разделительных линий — */
    .chain-list { list-style:none; margin:0; padding:0; }
    .chain-step { display:grid; grid-template-columns:clamp(96px,12vw,170px) minmax(0,1fr) auto; gap:8px 32px; align-items:center; padding-block:14px; }
    .chain-num { font-family:var(--ff-display); font-weight:600; font-size:var(--fs-num-lg); line-height:1; letter-spacing:-.03em; color:var(--accent); font-variant-numeric:tabular-nums; }
    @supports (-webkit-text-stroke: 1px black) {
      .chain-num { color:transparent; -webkit-text-stroke:1.5px var(--accent); }
    }
    .chain-body h3 { font-size:var(--fs-h); font-weight:600; letter-spacing:-.02em; line-height:1.15; margin:0 0 10px; color:var(--text-strong); }
    .chain-body p { margin:0; max-width:var(--measure-text); font-size:var(--fs-body-lg); line-height:var(--lh-body-lg); color:var(--text-body); }
    .chain-link { justify-self:end; }
    /* Строка-итог целиком под маркером (утверждённый кейс, как «Результат»).
       Мера обязательна: без неё фраза тянется на всю ширину .wrap. */
    .chain-result { margin:var(--s-24) 0 0; max-width:var(--measure-lead); font-size:var(--fs-body-lg); line-height:var(--lh-body-lg); color:var(--text-strong); }

    /* — чипы смежных разделов: контурные, с шевроном (стили — global.css) — */
    .chip-row { display:flex; flex-wrap:wrap; gap:12px; }

    /* — FAQ: 1:1 паттерн Faq.astro — две равные колонки, без линий — */
    .faq { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:clamp(32px,5vw,72px); }
    .faq-item { padding:14px 0; }
    .faq-q { font-size:var(--fs-h); font-weight:600; line-height:1.3; letter-spacing:-.01em; color:var(--text-strong); margin:0 0 10px; }
    .faq-a p { font-size:var(--fs-body-sm); line-height:1.6; color:var(--text-body); margin:0; }
    .faq-a .faq-stub { color:var(--text-muted); }

    /* — CTA + нормативная плашка — */
    /* Нормативная плашка — единственное разрешённое центрирование текста; сужена */
    /* — reveal (паттерн главной) — */
    .reveal { opacity:0; transform:translateY(18px); transition:opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); transition-delay:var(--d,0s); }
    .reveal.in { opacity:1; transform:none; }
    @media (prefers-reduced-motion:reduce) { .reveal { opacity:1; transform:none; transition:none; } }

    /* — адаптив — */
    @media (max-width:1100px) {
      .card-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
    @media (max-width:960px) {
      .page-title, .sec-head h2 { max-width:none; }
      .faq { grid-template-columns:1fr; }
    }
    @media (max-width:720px) {
      .card-grid { grid-template-columns:1fr; }
      .chain-step { grid-template-columns:1fr; gap:4px; }
      .chain-num { font-size:var(--fs-num); }
      .chain-link { justify-self:start; margin-top:12px; }
    }
  </style>

  <script>
    // появление блоков при скролле (паттерн главной)
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</Base>

# Клиентикс CRM · API (Настройки → API в аккаунте клиники)
# Скопируйте этот файл в .env и подставьте реальные значения.
# .env в git не попадает (см. .gitignore) — реальные ключи живут только локально
# и в секретах хостинга/CI.

# ID аккаунта (a/... в URL запроса)
KLIENTIKS_ACCOUNT_ID=

# ID пользователя API (u/... в URL запроса)
KLIENTIKS_USER_ID=

# Токен авторизации (заголовок Authorization: Bearer ...)
KLIENTIKS_TOKEN=

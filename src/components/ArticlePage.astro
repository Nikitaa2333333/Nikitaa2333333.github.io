---
/* ============================================================
   ШАБЛОН КОНТЕНТНОЙ СТАТЬИ — общий рендерер для блога и текстовых
   страниц раздела «Лечение» (восстановление, клинические исследования).

   Статья приходит ДАННЫМИ (src/data/articles/**.json): slug, title,
   descr, lead[], sections[{id,h,paras[]}], faq[{q,a}], related[].
   Тексты пишутся с обычными пробелами — неразрывные расставляет
   мини-типограф (src/lib/typograf.ts) при рендере. В строках допустимы
   ТОЛЬКО инлайн-теги <mark> и <a href> — никакой жирности (правило
   дизайн-системы), поэтому set:html здесь безопасен по стилю.

   Вёрстка — целиком на классах page-article.css (единая система
   внутренних страниц: page-hero, crumbs, sec, faq, chip-row, reveal);
   своего здесь только .art-p — рядовой абзац секции.

   СТРУКТУРА ПОВТОРЯЕТ ЗАФИКСИРОВАННЫЕ СТРАНИЦЫ (эталон —
   lechenie/himioterapiya.astro), а не «заголовок + простыня абзацев»:

   - в hero ОДИН абзац лида (.page-sub). Остальные абзацы лида — вводным
     блоком после hero, в двух равных колонках;
   - секция от трёх абзацев раскладывается в .lead-grid (две равные
     колонки), и широкого лида над колонками нет — правило меры строки;
   - секция в один-два абзаца остаётся одной колонкой: .sec-lead + .art-p;
   - у секции могут быть .callout (примечание на холсте) и справочная
     таблица .mk-table в белой плашке .table-wrap — они приходят в данных
     статьи полями callout/table и рендерятся, если заданы.
   ============================================================ */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import FooterContacts from './sections/FooterContacts.astro';
import PageCta from './sections/PageCta.astro';
import { typo } from '../lib/typograf';
import '../styles/page-article.css';

export interface ArticleData {
  slug: string;
  title: string;
  descr: string;
  lead: string[];
  sections: {
    id: string;
    h: string;
    paras: string[];
    /* примечание на холсте под текстом секции (не плашка) */
    callout?: { h: string; paras: string[] };
    /* справочная таблица: шапка + строки. Линии строк — часть структуры */
    table?: { head: string[]; rows: string[][] };
  }[];
  faq: { q: string; a: string }[];
  related: { label: string; href: string }[];
}

interface Props {
  article: ArticleData;
  eyebrow: string;                          // «Блог» | «Лечение»
  crumbs: { label: string; href?: string }[]; // последняя крошка — без href
  current?: string;                         // подсветка пункта меню в Header
  ctaTitle?: string;
  ctaText?: string;
}

const {
  article: a,
  eyebrow,
  crumbs,
  current,
  ctaTitle = 'Обсудите вашу ситуацию с врачом',
  ctaText = 'Статья не заменяет консультацию. Привезите документы — врач разберёт именно ваш случай: диагноз, заключения, снимки, и объяснит, какие шаги имеют смысл дальше.',
} = Astro.props;

// Иконка в кнопке — функциональная (правило: декоративных иконок нет,
// в кнопках остаются). Тот же контур, что на зафиксированных страницах.
const iconPhone =
  '<path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" fill="currentColor"/>';

// В hero — только первый абзац лида; остальные уходят вводным блоком ниже.
const heroLead = a.lead[0];
const introParas = a.lead.slice(1);

// Разложить абзацы на две равные колонки (первая — с остатком при нечётном).
const twoCols = (paras: string[]) => {
  const half = Math.ceil(paras.length / 2);
  return [paras.slice(0, half), paras.slice(half)];
};
---

<Base title={`${a.title} — Клиника трансляционной медицины`} description={a.descr}>
  <Header current={current} />

  <!-- HERO страницы (паттерн внутренних страниц) -->
  <section class="page-hero">
    <div class="blob" style="width:480px;height:480px;background:var(--c-wash-teal);top:-160px;left:-60px;"></div>
    <div class="blob" style="width:420px;height:420px;background:var(--c-wash-blue);top:-80px;right:-40px;"></div>
    <div class="wrap" style="position:relative;z-index:1;">
      <nav class="crumbs" aria-label="Хлебные крошки">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          </>
        ))}
      </nav>
      <div class="page-eyebrow">{eyebrow}</div>
      <h1 class="page-title" set:html={typo(a.title)} />
      <p class="page-sub" set:html={typo(heroLead)} />
      <div class="hero-cta">
        <a href="#contacts" class="btn btn-dark"><svg viewBox="0 0 24 24" class="ic-s" set:html={iconPhone}></svg>Записаться на&nbsp;консультацию</a>
        <a href="/s-chego-nachat" class="btn btn-light">С&nbsp;чего начать</a>
      </div>
    </div>
  </section>

  <!-- Вводный блок: остаток лида в двух равных колонках, без заголовка -->
  {introParas.length > 0 && (
    <section class="sec reveal" id="intro">
      <div class="wrap">
        {introParas.length > 1 ? (
          <div class="lead-grid">
            {twoCols(introParas).map((col) => (
              <div class="lead-col">
                {col.map((p) => <p class="lead-para" set:html={typo(p)} />)}
              </div>
            ))}
          </div>
        ) : (
          <p class="sec-lead" set:html={typo(introParas[0])} />
        )}
      </div>
    </section>
  )}

  {a.sections.map((s, i) => (
    <section class="sec reveal" id={s.id} style={`--d:${Math.min(i * 0.04, 0.2)}s`}>
      <div class="wrap">
        <div class="sec-head">
          <h2 set:html={typo(s.h)} />
          {/* лид над секцией — только когда текст идёт ОДНОЙ колонкой:
              широкий лид над двумя колонками запрещён (мера строки) */}
          {s.paras.length > 0 && s.paras.length < 3 && (
            <p class="sec-lead" set:html={typo(s.paras[0])} />
          )}
        </div>

        {s.paras.length >= 3 ? (
          <div class="lead-grid">
            {twoCols(s.paras).map((col) => (
              <div class="lead-col">
                {col.map((p) => <p class="lead-para" set:html={typo(p)} />)}
              </div>
            ))}
          </div>
        ) : (
          s.paras.slice(1).map((p) => <p class="art-p" set:html={typo(p)} />)
        )}

        {s.table && (
          <div class="table-wrap">
            <table class="mk-table">
              <thead>
                <tr>{s.table.head.map((h) => <th set:html={typo(h)} />)}</tr>
              </thead>
              <tbody>
                {s.table.rows.map((row) => (
                  <tr>{row.map((cell) => <td set:html={typo(cell)} />)}</tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {s.callout && (
          <div class="callout">
            <h3 set:html={typo(s.callout.h)} />
            {s.callout.paras.map((p) => <p set:html={typo(p)} />)}
          </div>
        )}
      </div>
    </section>
  ))}

  <!-- FAQ — статичный список, две колонки, левый край -->
  {a.faq.length > 0 && (
    <section class="sec reveal" id="faq">
      <div class="wrap">
        <div class="sec-head">
          <h2>Частые вопросы</h2>
        </div>
        <div class="faq">
          {a.faq.map((f) => (
            <div class="faq-item">
              <h3 class="faq-q" set:html={typo(f.q)} />
              <div class="faq-a"><p set:html={typo(f.a)} /></div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Перелинковка: контурные чипы с шевроном -->
  {a.related.length > 0 && (
    <section class="sec reveal" id="related">
      <div class="wrap">
        <div class="sec-head">
          <h2>Что почитать дальше</h2>
        </div>
        <ul class="chip-row">
          {a.related.map((r) => (
            <li>
              <a class="link-chip" href={r.href}>
                <span set:html={typo(r.label)} /><svg class="chev-r" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <PageCta title={ctaTitle} text={ctaText} note="Материал носит информационный характер и не заменяет консультацию врача." />
  <FooterContacts />
</Base>

<style is:global>
  /* Рядовой абзац секции статьи: ступень ниже лида, мера строки токеном.
     Отступ между абзацами — вертикальный ритм без линий (правило). */
  .art-p {
    margin: 0 0 14px;
    max-width: var(--measure-text);
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--text-body);
  }
  .art-p:last-child { margin-bottom: 0; }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.12 }
  );
  document.querySelectorAll('.sec.reveal').forEach((el) => io.observe(el));
</script>

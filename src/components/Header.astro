---
/* ============================================================
   ШАПКА САЙТА — общий компонент.
   Раньше разметка шапки дублировалась в каждой странице; с появлением
   персональных страниц врачей (/vrachi/*) вынесена сюда (CLAUDE.md:
   «при росте — вынести Header/Footer в компоненты»).
   Существующие страницы (index, s-chego-nachat, onkomarkery, …) пока
   держат свою копию — переводить их на компонент можно постепенно.
   Стили — is:global: шапка живёт вне scope компонента-страницы.
   ============================================================ */
import { clinic } from '../data/clinic';

interface Props {
  current?: string; // подсветка активного пункта меню: 'vrachi' | 'stoimost' | …
}
const { current } = Astro.props;
---

<header class="site-head" id="site-head">
  <!-- верхняя утилити-полоса (сворачивается при скролле, JS — в Base.astro) -->
  <div class="topbar">
    <div class="wrap topbar-in">
      <button class="a11y-link" aria-label="Версия для слабовидящих">
        <svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        Версия для слабовидящих
      </button>
      <div class="topbar-info">
        <span class="ti"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="10" r="2.4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><b>{clinic.addrShort}</b></span>
        <a href={clinic.phoneHref} class="ti"><svg viewBox="0 0 24 24"><path d="M4 5c0 8 7 15 15 15l2.5-3.2-4.5-2-2 2c-2.5-1.2-5.1-3.8-6.3-6.3l2-2-2-4.5L4 5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><b>{clinic.phone}</b></a>
        <span class="ti ti-hours">{clinic.hours}</span>
      </div>
    </div>
  </div>
  <div class="wrap head-inner">
    <a href="/" class="brand">
      <img src="/images/logo-mark.svg" alt="Клиника трансляционной медицины" class="brand-mark" />
      <!-- пробел перед <br> обязателен: на мобиле перенос скрывается
           (.brand-name br { display:none }), и без него слова слипаются -->
      <span class="brand-name">Клиника <br/><b>трансляционной медицины</b></span>
    </a>
    <nav class="nav">
      <div class="nav-item"><a href="/s-chego-nachat" class={`nav-link${current === 'start' ? ' is-current' : ''}`} aria-current={current === 'start' ? 'page' : undefined}>С чего начать</a></div>
      <div class="nav-item">
        <a href="#" class={`nav-link${current === 'diagnostika' ? ' is-current' : ''}`}>Диагностика <svg viewBox="0 0 24 24" class="chev"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <div class="drop">
          <a href="/molekulyarnaya-diagnostika" class={`drop-it${current === 'mgi' ? ' is-current' : ''}`}><b>Молекулярно-генетические исследования</b><span>NGS · ПЦР · FISH — основа выбора лекарственной тактики</span></a>
          <a href="/biopsiya" class={`drop-it${current === 'biopsiya' ? ' is-current' : ''}`}><b>Биопсия и гистология</b><span>Пересмотр стёкол — «не отменяем, уточняем»</span></a>
          <a href="/onkomarkery" class={`drop-it${current === 'onkomarkery' ? ' is-current' : ''}`}><b>Онкомаркеры</b><span>Вспомогательный анализ: динамика, не диагноз</span></a>
          <a href="#" class="drop-it"><b>Анализ крови</b></a>
          <a href="#" class="drop-it"><b>Ультразвуковая диагностика</b></a>
          <a href="#" class="drop-it"><b>Другие анализы</b></a>
        </div>
      </div>
      <div class="nav-item">
        <a href="#" class={`nav-link${current === 'lechenie' ? ' is-current' : ''}`}>Лечение <svg viewBox="0 0 24 24" class="chev"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <div class="drop drop-wide">
          <a href="/lechenie" class={`drop-it${current === 'lechenie-obzor' ? ' is-current' : ''}`}><b>Выбор вида лечения</b><span>Задачи лекарственной терапии</span></a>
          <a href="/lechenie/himioterapiya" class={`drop-it${current === 'himio' ? ' is-current' : ''}`}><b>Химиотерапия</b><span>Эффективные схемы лечения</span></a>
          <a href="/lechenie/targetnaya-terapiya" class={`drop-it${current === 'target' ? ' is-current' : ''}`}><b>Таргетная терапия</b><span>Точечное воздействие на мишени</span></a>
          <a href="/lechenie/immunoterapiya" class={`drop-it${current === 'immuno' ? ' is-current' : ''}`}><b>Иммунотерапия</b><span>Активация собственного иммунитета</span></a>
          <a href="/lechenie/vosstanovlenie" class="drop-it"><b>Восстановление после лечения</b><span>Сопроводительная и симптоматическая терапия, восстановительное питание</span></a>
          <a href="/lechenie/klinicheskie-issledovaniya" class="drop-it"><b>Клинические исследования</b><span>Реестр активных протоколов, GCP</span></a>
        </div>
      </div>
      <div class="nav-item"><a href="/vrachi" class={`nav-link${current === 'vrachi' ? ' is-current' : ''}`} aria-current={current === 'vrachi' ? 'page' : undefined}>Врачи</a></div>
      <div class="nav-item"><a href="/stoimost" class={`nav-link${current === 'stoimost' ? ' is-current' : ''}`} aria-current={current === 'stoimost' ? 'page' : undefined}>Цены</a></div>
      <div class="nav-item"><a href="/blog" class={`nav-link${current === 'blog' ? ' is-current' : ''}`} aria-current={current === 'blog' ? 'page' : undefined}>Блог</a></div>
      <div class="nav-item">
        <a href="#" class="nav-link">О клинике <svg viewBox="0 0 24 24" class="chev"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <div class="drop">
          <a href="/#stationar" class="drop-it"><b>Дневной стационар</b><span>Условия лечения</span></a>
          <a href="/litsenzii" class={`drop-it${current === 'litsenzii' ? ' is-current' : ''}`}><b>Лицензии и сертификаты</b><span>Документы клиники</span></a>
          <a href="/#stories" class="drop-it"><b>Истории пациентов</b><span>Вместе достигаем невозможного</span></a>
        </div>
      </div>
      <div class="nav-item"><a href="#contacts" class="nav-link">Контакты</a></div>
    </nav>
    <div class="head-actions">
      <button class="a11y" title="Версия для слабовидящих" aria-label="Версия для слабовидящих">Аа</button>
      <a href={clinic.phoneHref} class="head-call" aria-label={`Позвонить ${clinic.phone}`}><svg viewBox="0 0 24 24"><path d="M4 5c0 8 7 15 15 15l2.5-3.2-4.5-2-2 2c-2.5-1.2-5.1-3.8-6.3-6.3l2-2-2-4.5L4 5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></a>
      <a href="#contacts" class="btn btn-dark btn--inline head-cta"><svg viewBox="0 0 24 24" class="ic-s"><path d="M4 5c0 8 7 15 15 15l2.5-3.2-4.5-2-2 2c-2.5-1.2-5.1-3.8-6.3-6.3l2-2-2-4.5L4 5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>Записаться на приём</a>
      <button class="burger" id="burger" aria-label="Меню" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Мобильное меню: полноэкранная панель, ВСЁ РАСКРЫТО.
       Подразделы «Диагностика» и «Лечение» видны списком под своим заголовком —
       разворачивать нечего. Аккордеонов в проекте нет нигде (CLAUDE.md). -->
  <div class="mmenu" id="mobile-menu" hidden>
    <nav class="mmenu-in" aria-label="Основное меню">
      <a href="/s-chego-nachat" class="mm-link">С чего начать</a>

      <p class="mm-group">Диагностика</p>
      <a href="/molekulyarnaya-diagnostika" class="mm-sub">Молекулярно-генетические исследования</a>
      <a href="/biopsiya" class="mm-sub">Биопсия и гистология</a>
      <a href="/onkomarkery" class="mm-sub">Онкомаркеры</a>

      <p class="mm-group">Лечение</p>
      <a href="/lechenie" class="mm-sub">Выбор вида лечения</a>
      <a href="/lechenie/himioterapiya" class="mm-sub">Химиотерапия</a>
      <a href="/lechenie/targetnaya-terapiya" class="mm-sub">Таргетная терапия</a>
      <a href="/lechenie/immunoterapiya" class="mm-sub">Иммунотерапия</a>
      <a href="/lechenie/vosstanovlenie" class="mm-sub">Восстановление после лечения</a>
      <a href="/lechenie/klinicheskie-issledovaniya" class="mm-sub">Клинические исследования</a>

      <a href="/vrachi" class="mm-link">Врачи</a>
      <a href="/stoimost" class="mm-link">Цены</a>
      <a href="/blog" class="mm-link">Блог</a>

      <p class="mm-group">О клинике</p>
      <a href="/#stationar" class="mm-sub">Дневной стационар</a>
      <a href="/litsenzii" class="mm-sub">Лицензии и сертификаты</a>
      <a href="/#stories" class="mm-sub">Истории пациентов</a>

      <a href="/#contacts" class="mm-link">Контакты</a>
    </nav>
    <div class="mmenu-foot">
      <a href="/#contacts" class="btn btn-dark mm-cta">Записаться на приём</a>
      <a href={clinic.phoneHref} class="mm-phone">{clinic.phone}</a>
      <p class="mm-hours">{clinic.hours}</p>
      <p class="mm-addr">{clinic.addrShort}</p>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const burger = document.getElementById('burger');
    const menu = document.getElementById('mobile-menu');
    if (!burger || !menu) return;
    const setOpen = (open) => {
      // Блокировка прокрутки убирает полосу прокрутки, вьюпорт становится шире,
      // и шапка вместе с иконками прыгает вбок. Компенсируем ровно ширину полосы.
      // (scrollbar-gutter: stable не годится — он резервирует кант ВСЕГДА,
      // и справа висит видимая пустая полоса.)
      const sbw = window.innerWidth - document.documentElement.clientWidth;
      menu.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      burger.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      document.body.style.paddingRight = open && sbw > 0 ? sbw + 'px' : '';
    };
    burger.addEventListener('click', () => setOpen(menu.hidden));
    // тап по ссылке закрывает панель (важно для якорей на той же странице)
    menu.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) setOpen(false); });
    // возврат на десктоп при открытой панели не должен оставлять body заблокированным
    matchMedia('(min-width: 761px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  })();
</script>

<style is:global>
  /* Кнопки .btn/.btn-dark/.btn-light — в global.css (единый источник, без обводок) */
  .ic-s { width:16px; height:16px; }

  /* — шапка — */
  .site-head { position:sticky; top:0; z-index:50; overflow-anchor:none; background:var(--head-fill); border-bottom:1px solid var(--border-hairline); }
  .head-inner { display:flex; align-items:center; justify-content:space-between; height:74px; gap:24px; }
  .brand { display:flex; align-items:center; gap:12px; }
  .brand-mark { height:44px; width:auto; flex:none; }
  .brand-name { font-size:var(--fs-caption); line-height:1.25; color:var(--text-body); letter-spacing:.01em; }
  .brand-name b { color:var(--text-strong); font-weight:600; }
  .nav { display:flex; gap:6px; }
  .nav-item { position:relative; }
  .nav-link { display:inline-flex; align-items:center; gap:5px; font-size:var(--fs-body-sm); color:var(--text-body); padding:10px 12px; border-radius:var(--r-pill); transition:.2s; }
  .nav-link:hover { color:var(--text-strong); background:var(--veil); }
  .nav-link.is-current { color:var(--accent-soft); font-weight:600; }
  .chev { width:14px; height:14px; opacity:.55; transition:transform .25s; }
  .nav-item:hover .chev, .nav-item:focus-within .chev { transform:rotate(180deg); }
  .drop { position:absolute; top:calc(100% + 10px); left:0; min-width:290px; padding:10px;
    background:var(--surface-elevated);
    border:1px solid var(--border-hairline); border-radius:var(--r-glass); box-shadow:var(--sh-glass);
    display:grid; gap:2px; opacity:0; visibility:hidden; transform:translateY(10px);
    transition:opacity .22s ease, transform .22s ease, visibility .22s; z-index:60; }
  .drop::before { content:""; position:absolute; top:-12px; left:0; right:0; height:14px; }
  .drop-wide { min-width:340px; }
  .nav-item:hover .drop, .nav-item:focus-within .drop { opacity:1; visibility:visible; transform:translateY(0); }
  .drop-it { display:grid; gap:2px; padding:11px 14px; border-radius:var(--r-input); transition:.18s; }
  .drop-it b { font-size:var(--fs-body-sm); font-weight:600; color:var(--text-strong); }
  .drop-it span { font-size:var(--fs-caption); color:var(--text-muted); line-height:1.35; }
  .drop-it:hover { background:var(--c-wash-teal); }
  .drop-it:hover b { color:var(--c-teal-deep); }
  .drop-it.is-current { background:var(--c-wash-teal); }
  .drop-it.is-current b { color:var(--c-teal-deep); }
  .head-actions { display:flex; align-items:center; gap:14px; }
  .a11y { width:40px; height:40px; border-radius:var(--r-pill); border:1px solid var(--border-strong); background:var(--veil); color:var(--text-body); font-size:var(--fs-body-sm); cursor:pointer; }
  .a11y.is-on { background:var(--cta-fill); color:var(--cta-text); border-color:transparent; }

  /* Бургер и телефон-иконка — только на мобиле (порог 760px, см. tokens.base.css) */
  .burger, .head-call { display:none; }

  /* ============================================================
     МОБИЛЬНОЕ МЕНЮ.
     Раньше весь мобильный слой шапки был одной строкой: навигацию просто
     выключали через display:none, не поставив ничего взамен — 9 из 10
     разделов сайта были недоступны с телефона.
     ============================================================ */
  @media (max-width:760px) {
    .head-inner { height:60px; gap:8px; }
    .brand-mark { height:28px; }
    /* Логотип забирает остаток строки, min-width:0 разрешает ему сжиматься —
       иначе флекс-элемент не уступает и выдавливает иконки за экран. */
    .brand { flex:1 1 auto; min-width:0; gap:6px; }
    /* Название в ДВЕ строки: «Клиника трансляционной» / «медицины».
       В разметке после «Клиника» стоит жёсткий <br> — на узком экране он давал
       три строки, потому что «трансляционной медицины» само не помещалось.
       На мобиле перенос снимаем и даём тексту ширину под две строки. */
    .brand-name br { display:none; }
    .brand-name { font-size:var(--fs-caption); letter-spacing:-0.02em; }
    .nav { display:none; }
    /* Кнопка «Записаться на приём» в одну строку = 228px и уносила страницу
       за экран. На телефоне вместо неё иконка-телефон, а полная кнопка —
       внизу панели меню. */
    .head-cta { display:none; }
    .head-call { display:inline-flex; align-items:center; justify-content:center;
      width:var(--tap-min); height:var(--tap-min); flex:none;
      border-radius:var(--r-pill); background:var(--cta-fill); color:var(--cta-text); }
    /* 38px вместо 44: на 360px иначе не помещаются логотип в две строки
       и три кнопки одновременно. Кружок с полем вокруг иконки остаётся
       уверенной целью для пальца. */
    .head-call svg { width:18px; height:18px; }
    .a11y { width:38px; height:38px; flex:none; }
    .head-call { width:38px; height:38px; }
    .head-actions { gap:6px; flex:none; }

    .burger { display:inline-flex; flex-direction:column; justify-content:center; gap:5px;
      width:38px; height:38px; flex:none; padding:0 9px;
      border:1px solid var(--border-strong); border-radius:var(--r-pill);
      background:transparent; cursor:pointer; }
    /* Без анимации превращения: бургер сразу становится крестом.
       Проигрывание перекладывания палочек на 44px кнопке читалось как
       дёрганье, а не как переход. */
    .burger span { display:block; height:2px; border-radius:var(--r-pill); background:var(--text-strong); }
    .burger.is-open span:nth-child(1) { transform:translateY(7px) rotate(45deg); }
    .burger.is-open span:nth-child(2) { opacity:0; }
    .burger.is-open span:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }

    /* «Аа» и телефон остаются видимыми и при открытом меню — иначе шапка
       перестраивается на каждом открытии. */

    /* Панель: под шапкой, на весь остаток экрана, прокрутка внутри неё */
    .mmenu { position:fixed; inset:60px 0 0; z-index:49;
      background:var(--bg-canvas); overflow-y:auto;
      overscroll-behavior:contain; -webkit-overflow-scrolling:touch;
      display:flex; flex-direction:column; }
    .mmenu[hidden] { display:none; }
    .mmenu-in { display:flex; flex-direction:column; padding:20px var(--gutter) 12px; }
    /* Перечисление держит вертикальный ритм: ни буллитов, ни разделительных
       линий (CLAUDE.md), поэтому и отступы между пунктами небольшие. */
    .mm-link { padding:12px 0; font-size:var(--fs-sub); font-weight:600;
      color:var(--text-strong); min-height:var(--tap-min); display:flex; align-items:center;
      letter-spacing:-.02em; }
    /* Заголовок группы — акцентом, а не серым: серый «чтобы понизить важность»
       запрещён (глобальный CLAUDE.md). Роль метки читается по цвету и кеглю. */
    .mm-group { margin:20px 0 4px; font-size:var(--fs-caption); color:var(--accent-soft); }
    .mm-sub { padding:10px 0 10px 14px; font-size:var(--fs-body); color:var(--text-body);
      min-height:var(--tap-min); display:flex; align-items:center; }
    .mm-link:active, .mm-sub:active { color:var(--accent); }

    /* Панель целиком на голубом холсте — подвал отдельной заливки не имеет,
       иначе он читается как чужая плашка внутри меню. */
    .mmenu-foot { margin-top:auto; padding:20px var(--gutter) 28px;
      display:grid; gap:8px; }
    .mm-cta { width:100%; justify-content:center; }
    .mm-phone { margin-top:4px; font-size:var(--fs-body-lg); font-weight:600; color:var(--accent-soft);
      min-height:var(--tap-min); display:flex; align-items:center; }
    .mm-hours, .mm-addr { margin:0; font-size:var(--fs-body-sm); color:var(--text-body); }
  }
</style>

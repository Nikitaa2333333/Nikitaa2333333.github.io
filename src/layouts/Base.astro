---
import '../styles/fonts';
import '../styles/global.css';
import { clinic } from '../data/clinic';

interface Props {
  title?: string;
  description?: string; // meta description — нужна страницам под индексацию (врачи, разделы)
}
const { title = 'Клиника трансляционной медицины', description } = Astro.props;

/* Разметка организации для поисковиков: карточка клиники в Яндексе и Google
   берёт название, адрес, телефон и ЗНАК отсюда. Логотип клиники дальше
   фигурирует уже не только в шапке — это его «невидимое» место.
   Абсолютный URL знака нужен обязательно: относительный путь поисковик
   не примет, поэтому берём Astro.site (astro.config.mjs), а без него — домен. */
const origin = Astro.site?.origin ?? 'https://ctmedspb.ru';
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: clinic.nameBrand,
  legalName: clinic.nameFull,
  url: origin,
  logo: `${origin}/favicon.svg`,
  image: `${origin}/favicon.svg`,
  telephone: clinic.phone,
  email: clinic.email,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'RU',
    addressLocality: clinic.city,
    postalCode: clinic.zip,
    streetAddress: clinic.addrSchema,
  },
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>

    {/* Фавикон: SVG — основной (масштабируется, чёткий на любой плотности),
        .ico — для браузеров, которые SVG-иконку не понимают, PNG 96 —
        для вкладок и закладок, apple-touch — иконка на экране «Домой».
        Логотип вписан в квадрат БЕЗ подложки — фон прозрачный.
        Исключение — apple-touch: iOS прозрачность не поддерживает
        и подставляет чёрный, поэтому там метка залита белым. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ebf5ff" />

    {/* Карточка ссылки в мессенджерах и соцсетях. Без неё ссылка на клинику
        в WhatsApp или Telegram уходит голой строкой адреса.
        Картинка — public/og.png (знак + название на фирменном градиенте),
        макет лежит в scripts/og-preview: пересобирается скриншотом. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={clinic.nameBrand} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={`${origin}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  </head>
  <body>
    <slot />

    <script>
      const html = document.documentElement;

      // ШАПКА (общее для всех страниц): переключатель слабовидящих + сворачивание топ-бара
      const toggleA11y = () => {
        const on = html.getAttribute('data-a11y') === 'on';
        html.setAttribute('data-a11y', on ? 'off' : 'on');
        document.querySelectorAll('.a11y').forEach((b) => b.classList.toggle('is-on', !on));
      };
      document.querySelectorAll<HTMLElement>('.a11y, .a11y-link').forEach((el) => el.addEventListener('click', toggleA11y));

      const head = document.getElementById('site-head');
      if (head) {
        // Гистерезис: разные пороги на сворачивание/разворачивание, иначе
        // схлопывание топ-бара меняет высоту шапки, scrollY чуть отскакивает
        // назад (scroll anchoring) — и переключатель дёргается туда-обратно.
        const onScroll = () => {
          const y = window.scrollY;
          if (y > 96) head.classList.add('shrink');
          else if (y < 40) head.classList.remove('shrink');
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
